---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { 
  title: 'Community Mission | Free Website Development for the Public Good', 
  description: 'Professional web presence for Japans NPOs and community services, provided free of charge for the public good.',
};

const npoLabels = {
    title: "Support Application ❤️",
    client_name: "Representative Name",
    company_name: "Organization Name",
    email: "Contact Email",
    
    request_type: "Mission Sector",
    project_summary: "Your Story & Impact Goal",
    budget_range: "Current Digital State",
    deadline: "Desired Timeline",
    referral: "How did you find Hanei?",
    submit: "Apply for Support"
};

const npoOptions = {
    requests: ["Disability Advocacy", "Animal Welfare", "Senior Citizens", "Youth Services", "Other Public Good"],
    budgets: ["No Website", "Outdated Website", "Social Media Only", "Other"],
    timelines: ["Urgent", "Within 1 Month", "Flexible", "Other"],
    referrals: ["Google Search", "Social Media", "Friend / Colleague", "Other"]
};
---

<Layout metadata={metadata}>
  
  <Hero2
    tagline="Community Mission"
    title='Empowering the Heart of Japan: <br/><span class="text-accent">Professional Web, Free for the Public Good.</span>'
    subtitle="You dedicate your lives to serving others. We dedicate our craft to ensuring the world sees your impact. Professional-grade digital infrastructure for registered NPOs in Japan."
    actions={[{ variant: 'primary', text: 'Apply for Support', href: '#application' }]}
    image={{ src: 'https://images.unsplash.com/photo-1665562011653-e8bfc3ca6602?w=500&auto=format&fit=crop&q=60', alt: 'Japanese Community' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />
  
  <Content isReversed={true} classes={{ container: 'py-8 md:py-12' }}>
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Elite Digital Support for Domestic Japan.</h3>
      <p class="text-lg text-muted mb-4">
        From the resilient communities in Kobe and Hiroshima to the bustling social initiatives in Osaka and Kyoto, local heroes are working to strengthen the fabric of Japanese society.
      </p>
      <p class="text-lg text-muted">
        At Hanei, we believe those who do the most good shouldn’t be held back by a lack of digital resources. Your regional mission deserves a professional digital home—not a DIY template, but a platform built with absolute precision.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1555126417-38de941cba37?w=500&auto=format&fit=crop&q=60" alt="Traditional Japan" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Content
    isReversed={false}
    isAfterContent={true}
    tagline="Our Focus"
    title="The Pillars of Our Public Good Support"
    items={[
        { title: 'Disability Advocacy', description: 'Websites built to the highest modern accessibility standards.', icon: 'tabler:accessible' },
        { title: 'Animal Welfare', description: 'Showcasing rescues in the best light and facilitating adoption applications.', icon: 'tabler:paw' },
        { title: 'Senior Citizens', description: 'Accessible, high-contrast sites to connect seniors with local resources.', icon: 'tabler:old' },
        { title: 'Youth Services', description: 'Safe online spaces for Kodomo Shokudo and educational support.', icon: 'tabler:school' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1513360371669-4adf3dd7dff8?w=500&auto=format&fit=crop&q=60', alt: 'Animal Care' }}
    classes={{ container: 'py-8 md:py-12' }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        We focus our efforts on the sectors that form the backbone of a compassionate society across all Japanese prefectures.
      </p>
    </Fragment>
  </Content>

  <Features2
    title='Every Public Good Site Includes the <br/><span class="text-accent">"Hanei Standard":</span>'
    subtitle="We provide the same elite infrastructure to our NPO partners as our corporate clients."
    columns={3}
    items={[
      { title: 'Custom Professional Design', description: 'A unique look that reflects your organization’s heart and soul.', icon: 'tabler:circle-check' },
      { title: 'Mobile Optimization', description: 'A seamless experience on smartphones—where most of your supporters are.', icon: 'tabler:circle-check' },
      { title: 'Search Engine Optimization', description: 'So people in your local Japanese community can actually find you.', icon: 'tabler:circle-check' },
      { title: 'Secure Hosting Setup', description: 'Guidance on the best, most secure ways to host your site.', icon: 'tabler:circle-check' },
      { title: 'Content Training', description: 'We teach your team how to update content and post news independently.', icon: 'tabler:circle-check' },
      { title: 'Bilingual Capability', description: 'Helping you bridge the gap between Japanese and international supporters.', icon: 'tabler:circle-check' },
    ]}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <div id="application" class="scroll-mt-20">
    <Content
      isReversed={false}
      tagline="How to Apply"
      title="Ready to Scale Your Impact?"
      image={{ src: 'https://images.unsplash.com/photo-1765193501601-19e2f52bb546?w=500&auto=format&fit=crop&q=60', alt: 'Interaction' }}
      classes={{ container: 'py-8 md:py-12' }}
    >
      <Fragment slot="content">
        <p class="text-lg text-muted mb-4">We accept limited public good projects each year to ensure each one receives our full "white-glove" attention.</p>
        <ul class="list-disc pl-5 space-y-2 text-muted mb-6">
          <li>Must be a registered NPO or verified community group in Japan.</li>
          <li>Mission should fall under Disability, Animal, Senior, or Youth support (we also welcome other essential public good initiatives).</li>
          <li>Must have a clear vision for community growth and helping society.</li>
        </ul>
        <h3 class="text-2xl font-bold mt-8">Start Your Application Below</h3>
        <p class="text-muted text-lg">Tell us your story. Tell us who you help.</p>
      </Fragment>
    </Content>
    <BespokeForm labels={npoLabels} options={npoOptions} />
  </div>

</Layout>
