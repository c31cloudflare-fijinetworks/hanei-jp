---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'Community Mission | Pro Bono Web Development in Japan', 
  description: 'Professional web presence for Japans NPOs and community services, 100% pro bono.',
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="Community Mission"
    title='Empowering the Heart of Japan: <br/><span class="text-accent">Professional Web, 100% Pro Bono.</span>'
    subtitle="You dedicate your lives to serving others. We dedicate our craft to ensuring the world sees your impact. Professional-grade digital infrastructure for registered NPOs in Japan."
    actions={[{ variant: 'primary', text: 'Apply for Support', href: '/contact' }]}
    image={{ src: 'https://images.unsplash.com/photo-1665562011653-e8bfc3ca6602?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MzZ8fGphcGFuZXNlJTIwbGlmZXxlbnwwfHwwfHx8Mg%3D%3D', alt: 'Japanese Street Life' }}
  />
  
  <!-- INTRO -->
  <Content
    isReversed={true}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">World-Class Design for World-Changing Missions.</h3>
      <p class="text-lg text-muted mb-4">
        In the bustling streets of Tokyo and the rural heartlands of Japan, heroes are working in the shadows. You are the animal rescuers, the caregivers for our elderly, the mentors for our children.
      </p>
      <p class="text-lg text-muted">
        At Hanei, we believe those who do the most good shouldn’t be held back by a lack of digital resources. Your mission deserves a professional digital home—not a DIY template, but a platform built with corporate precision.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1555126417-38de941cba37?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NzF8fGphcGFuZXNlJTIwbGlmZXxlbnwwfHwwfHx8Mg%3D%3D" alt="Traditional Japan" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- PILLARS -->
  <Content
    isReversed={false}
    tagline="Our Focus"
    title="The Pillars of Our Pro Bono Support"
    items={[
        { title: 'Animal Welfare', description: 'Showcasing rescues in the best light and facilitating adoption applications.', icon: 'tabler:paw' },
        { title: 'Senior Citizens', description: 'Accessible, high-contrast sites to connect seniors with local resources.', icon: 'tabler:old' },
        { title: 'Youth Services', description: 'Safe online spaces for Kodomo Shokudo and educational support.', icon: 'tabler:school' },
        { title: 'Disability Advocacy', description: 'Websites built to the highest modern accessibility standards.', icon: 'tabler:accessible' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1513360371669-4adf3dd7dff8?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8YW5pbWFsJTIwY2FyZXxlbnwwfHwwfHx8Mg%3D%3D', alt: 'Animal Care' }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        We focus our efforts on the sectors that form the backbone of a compassionate society in Japan.
      </p>
    </Fragment>
  </Content>

  <!-- THE SPIRIT -->
  <Content
    isReversed={true}
    tagline="Motivation"
    title="The Spirit of Kyosei (Symbiosis)"
    image={{ src: 'https://images.unsplash.com/photo-1665706365893-ee797fe3d3df?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTY1fHxqYXBhbmVzZSUyMGxpZmV8ZW58MHx8MHx8fDI%3D', alt: 'Japanese Town' }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-4">
        Our name represents "Prosperity." We believe that true prosperity is not measured by profit alone, but by the health and happiness of the community we live in.
      </p>
      <p class="text-lg text-muted">
        By donating our time and technical expertise, we aim to strengthen the social fabric of Japan. When your non-profit succeeds, our community prospers. This is our way of giving back.
      </p>
    </Fragment>
  </Content>

  <!-- TOURIST READY SUITE (Showing the Hanei Standard applies here too) -->
  <Features2
    title='Every Pro Bono Site Includes the "Hanei Standard":'
    subtitle="We provide the same elite infrastructure to our NPO partners as our corporate clients."
    columns={3}
    items={[
      { title: 'Custom Professional Design', description: 'A unique look that reflects your organization’s heart and soul.', icon: 'tabler:circle-check' },
      { title: 'Mobile Optimization', description: 'A seamless experience on smartphones—where most of your supporters are.', icon: 'tabler:circle-check' },
      { title: 'Search Engine Optimization', description: 'So people in your local Japanese community can actually find you.', icon: 'tabler:circle-check' },
      { title: 'Secure Hosting Setup', description: 'Guidance on the best, most secure ways to host your site.', icon: 'tabler:circle-check' },
      { title: 'Content Training', description: 'We teach your team how to update content and post news independently.', icon: 'tabler:circle-check' },
      { title: 'Bilingual Capability', description: 'Helping you bridge the gap between Japanese and international supporters.', icon: 'tabler:circle-check' },
    ]}
  />

  <!-- APPLICATION -->
  <Content
    isReversed={false}
    tagline="How to Apply"
    title="Ready to Scale Your Impact?"
    image={{ src: 'https://images.unsplash.com/photo-1765193501601-19e2f52bb546?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTcyfHxqYXBhbmVzZSUyMGxpZmV8ZW58MHx8MHx8fDI%3D', alt: 'Interaction' }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-4">We accept limited pro bono projects each year to ensure each one receives our full "white-glove" attention.</p>
      <ul class="list-disc pl-5 space-y-2 text-muted mb-6">
        <li>Must be a registered NPO or verified community group in Japan.</li>
        <li>Mission must fall under Animal, Senior, Youth, or Disability support.</li>
        <li>Must have a clear vision for digital growth.</li>
      </ul>
      <CallToAction
        title="Start Your Application"
        subtitle="Tell us your story. Tell us who you help."
        actions={[{ variant: 'primary', text: 'Contact Us Now', href: '/contact' }]}
      />
    </Fragment>
  </Content>

</Layout>
