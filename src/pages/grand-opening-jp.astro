---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import FeatureTable from '~/components/widgets/FeatureTable.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { title: 'グランドオープニング | ホームページ制作 | Hanei JP' };

const fullFeatureListJp = [{ title: '超高速エッジ配信' }, { title: '日英バイリンガル・ナビ' }, { title: 'Googleマップ連携' }, { title: 'スマホファースト設計' }, { title: 'SSL暗号化通信' }, { title: 'お問い合わせ・予約フォーム' }, { title: 'プロによるネイティブ執筆' }, { title: 'SNSフィード連携' }, { title: '画像データ最適化' }, { title: '最新ブラウザ互換対応' }, { title: 'ダウンタイムなしの移行' }, { title: '修正回数無制限' }, { title: '1営業日でのスピード公開' }, { title: 'プロフェッショナルCDN' }, { title: '自動バックアップ設定' }, { title: 'プライバシーポリシー対応' }, { title: '戦略的UXデザイン' }, { title: '60日間のテクニカルサポート' }];

const reformPrices = [
  { title: '1-3 ページ', price: '¥24,500', callToAction: { text: 'リフォームを注文' }, items: [{ description: 'モダンなデザイン刷新' }, { description: '既存コンテンツの移行' }, { description: '超高速エッジ配信' }] },
  { title: '4-6 ページ', price: '¥34,500', callToAction: { text: 'リフォームを注文' }, items: [{ description: '詳細なサービス紹介' }, { description: 'ブランド価値の再定義' }, { description: '世界基準のパフォーマンス' }] },
  { title: '7-10 ページ', price: '¥44,500', callToAction: { text: 'リフォームを注文' }, items: [{ description: '包括的なデジタル拠点' }, { description: '高度な問い合わせフロー' }, { description: '手厚いサポート' }] },
  { title: '11-20 ページ', price: '¥59,500', callToAction: { text: 'リフォームを注文' }, items: [{ description: '大規模移行対応' }, { description: '高度な情報設計' }, { description: '優先デプロイ' }] }
];

const newBuildPrices = [
  { title: '1-3 ページ', price: '¥30,600', callToAction: { text: '新規制作を注文' }, items: [{ description: '新規設計図の作成' }, { description: 'ターゲット特化型' }, { description: '超高速エッジ配信' }] },
  { title: '4-6 ページ', price: '¥43,100', callToAction: { text: '新規制作を注文' }, items: [{ description: 'ブランド基盤の構築' }, { description: 'モバイルファースト設計' }, { description: 'グローバルSEO設定' }] },
  { title: '7-10 ページ', price: '¥55,600', callToAction: { text: '新規制作を注文' }, items: [{ description: 'エリート・ビジネス拠点' }, { description: 'カスタム予約導線' }, { description: '盤石なインフラ' }] },
  { title: '11-20 ページ', price: '¥74,400', callToAction: { text: '新規制作を注文' }, items: [{ description: '高成長・大規模対応' }, { description: 'オーダーメイド設計' }, { description: '地域No.1ブランド構築' }] }
];
---
<Layout metadata={metadata}>
  <Hero2 tagline="グランドオープニング" title='あなたのホームページは、<br/><span class="text-accent">「集客」に貢献していますか？</span>' subtitle="古いデザインは、お客様を逃します。プロ品質のサイトを最短1営業日でお届けします。" actions={[{ variant: 'primary', text: 'リフォームを見る', href: '#reform' }, { variant: 'secondary', text: '新規制作を見る', href: '#new', class: '!bg-green-600 !text-white hover:!bg-green-700' }]} image={{ src: '/images/hanei-media/photo-1497366216548-37526070297c.webp&q=80', alt: '和食' }} />
  
  <!-- OPTION 1: REFORM -->
  <div id="reform" class="scroll-mt-20">
    <Content tagline="グランド・リフォーム" title="01. 劇的リフォーム" subtitle="今の情報を活かしつつ、国際的なラグジュアリー基準に合わせてデザインを刷新します。" items={[{ title: '劇的リフォーム', description: '見た目と機能を最新に。', icon: 'tabler:palette' }]} image={{ src: '/images/hanei-media/photo-1628652337240-80d1ed549f47.webp', alt: '寿司' }} classes={{ container: 'pb-0 md:pb-0' }} />
    <Content isReversed={true} isAfterContent={true} title="ブランド価値の再定義" subtitle="貴店のアイデンティティを保ちながら、プロフェッショナルな「顔」へとリフォームします。" image={{ src: '/images/hanei-media/photo-1667560615919-837fe9001e58.webp' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={false} isAfterContent={true} title="超高速・次世代インフラへの移行" subtitle="世界最速水準のエッジネットワークへ移行することで、モバイル環境でも瞬時の表示を実現します。" image={{ src: '/images/hanei-media/photo-1749104953222-9d6ed76e4bf0.webp' }} classes={{ container: 'py-8 md:py-12' }} />
    
    <Pricing title="グランド・リフォーム投資額" subtitle="既存サイトを最新のラグジュアリー基準へ。" prices={reformPrices} hasUrlField={true} />
  </div>

  <hr class="border-t dark:border-slate-800 my-12" />

  <!-- OPTION 2: NEW -->
  <div id="new" class="scroll-mt-20">
    <Content isReversed={true} tagline="グランド・ニュー" title="02. 完全新規制作" subtitle="ゼロからデジタル・エコシステムを構築します。最高のコンバージョンを生むための旗艦店を制作します。" items={[{ title: '新規ブランド構築', description: '市場に合わせたカスタムエンジニアリング。', icon: 'tabler:rocket' }]} image={{ src: '/images/hanei-media/photo-1486406146926-c627a92ad1ab.webp', alt: 'New Structure' }} classes={{ container: 'pb-0 md:pb-0' }} />
    <Content isReversed={false} isAfterContent={true} title="成約率を最大化する設計" subtitle="予約導線や問い合わせフローに独自のロジックを組み込み、訪問者を優良顧客へと変えます。" image={{ src: '/images/hanei-media/photo-1644072267093-cbbfdb74303c.webp' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} isAfterContent={true} title="世界水準のデータ基盤" subtitle="最新のテクノロジーを採用し、検索結果での優位性を確保するデジタル資産を提供します。" image={{ src: '/images/hanei-media/photo-1648977555232-99b5a8c8c897.webp' }} classes={{ container: 'py-8 md:py-12' }} />
    
    <Pricing title="グランド・ニュー投資額" subtitle="ゼロから最強の旗艦サイトを構築します。" prices={newBuildPrices} />
  </div>

  <div class="py-8 bg-slate-50 dark:bg-transparent border-y dark:border-slate-800 my-10">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold font-heading mb-2">Portfolio Demo</h2>
        <p class="text-lg text-muted">各業界で私たちが提供している最高水準のクオリティをご覧ください。</p>
    </div>
  </div>

  <div class="space-y-4">
    <Content isReversed={false} title="Portfolio Demo: ZenPod Tokyo" subtitle="日本の美意識と高い成約率を両立させたカプセルホテルのデモ。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/capsule-hotel' }} image={{ src: '/images/hanei-media/photo-1539606420556-14c457c45507.webp', alt: 'ホテル' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} title="Portfolio Demo: 麻布プレミアムメディカル" subtitle="洗練された医療施設向けのデモ. スムーズな予約フローを体験してください。" callToAction={{ variant: 'secondary', text: 'デモサイトを見る', href: '/demos/azabu-medical' }} image={{ src: '/images/hanei-media/photo-1631248055158-edec7a3c072b.webp', alt: '医療' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={false} title="Portfolio Demo: GINZA KAIZEN" subtitle="銀座の高級ヘアサロン向けデモ。完全英語対応の接客動線を体験できます。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/ginza-kaizen' }} image={{ src: '/images/hanei-media/photo-1560869713-7d0a29430803.webp', alt: '美容' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <FeatureTable title="グランド・リフォーム ＆ グランド・ニュー・パッケージ" subtitle="すべてのフル制作プロジェクトに標準装備されるエリート機能一覧。" items={fullFeatureListJp} />
</Layout>
