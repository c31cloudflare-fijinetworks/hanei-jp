---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'Grand Opening（完全リニューアル） | Hanei JP', 
  description: 'わずか48時間であなたのデジタル環境を完全に刷新し、強力なバイリンガルの旗艦サイトをゼロから構築します。',
};

const pricingData = {
  title: 'Grand Opening プラン',
  subtitle: '全社的デジタル・トランスフォーメーション',
  price: '158,500',
  period: '一括投資（エンタープライズ級インフラ）',
  items: [
    { description: '日本語・英語完全統合の旗艦サイト構築' },
    { description: '既存有用コンテンツの戦略的データ移行' },
    { description: 'ハッキング・リスクを排除した最先端アーキテクチャ' },
    { description: 'クリーンなSEO（構造化データ）実装' },
    { description: '48時間以内のフルスタック展開' },
  ],
  callToAction: { target: '_self', text: '48時間グランドオープンの枠を確保する', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="Grand Opening"
    title='デジタル上の「旗艦店」。<br/><span class="text-accent">世界に向けた新たなステージが、ここから始まります。</span>'
    subtitle="古いWebサイトは、もはや単なる「時代遅れ」ではなく、ビジネスの「負債（リスク）」です。わずか48時間であなたのデジタル環境を完全に刷新し、今後10年のグローバル成長を牽引する、強力なバイリンガル（日英対応）の「旗艦サイト」をゼロから構築します。"
    actions={[{ variant: 'primary', text: 'グランドオープンの枠を確保する', href: '/contact-jp' }]}
    image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NjV8fGphcGFuZXNlJTIwZm9vZHxlbnwwfHwwfHx8Mg%3D%3D', alt: 'Japanese Culinary Excellence' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
    items={[
        { 
          title: '表示速度のペナルティ', 
          description: 'サイトの読み込みに3秒以上かかると、すでに潜在顧客の50%を失っていると言われています。', 
          icon: 'tabler:device-mobile-bolt' 
        },
        { 
          title: '信頼感の喪失（ギャップ）', 
          description: '古めかしいデザインは、「サービス自体も古い」という誤解を与えます。欧米の富裕層も日本の旅行者も、洗練されたデジタル体験を求めています。', 
          icon: 'tabler:shield-x' 
        },
        { 
          title: '言語の壁と管理の限界', 
          description: '日本語と英語、2つのサイトを別々に管理するのは疲弊する作業です。放置された中途半端な英語ページは、お店の信用を損ないます。', 
          icon: 'tabler:language-off' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">現実：あなたのWebサイトはビジネスの「推進力」ですか、それとも「足かせ」ですか？</h3>
      <p class="text-lg text-muted mb-4">
        現代において、Webサイトはお客様が最初に足を踏み入れるお店の「玄関」です。その空間の表示が遅かったり、雑然として分かりにくかったりすれば、あなたが「いらっしゃいませ」と声をかける前に、お客様は立ち去ってしまいます。
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Haneiの「グランドオープン」は、これらを一挙に解決するトータルソリューションです。古いサイトを「手直し」するのではなく、過去の障壁を取り払い、ゼロから高性能なデジタルの「ランドマーク」を構築します。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1628652337240-80d1ed549f47?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTIxfHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Elegant Sushi Presentation" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: VELOCITY & BILINGUAL -->
  <Content
    isReversed={true}
    items={[
        { 
          title: '1. 48時間の圧倒的スピード：ゼロから「旗艦店」へ', 
          description: 'Hanei独自の高速開発システムを駆使し、わずか2日間で新しい旗艦サイトを構築、最適化し、公開します。たった一度の週末で、「時代遅れのサイト」が「業界トップクラスのサイト」へと生まれ変わります。', 
          icon: 'tabler:bolt' 
        },
        { 
          title: '2. デュアルエンジンによる完璧なバイリンガル対応（日英）', 
          description: '日本語のコンテンツは丁寧なおもてなしの心をそのままに、英語は欧米の消費者の購買心理に基づき魅力的に再設計。ストレスなく瞬時に言語を切り替えられるスムーズな操作性を提供します。', 
          icon: 'tabler:language-hiragana' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">グローバルで成功するための緻密な設計</h3>
      <p class="text-lg text-muted">
        ビジネスにおいて、時間は最も貴重な資産です。従来の制作会社では、サイトの構築に数ヶ月かかり、その間にも何千人もの潜在的なお客様を逃しています。私たちはこれを即座に解決します。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1626379907753-406934326e2c?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTI5fHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Japanese Chef Cooking" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 3: ARCHITECTURE & SEO -->
  <Content
    isReversed={false}
    items={[
        { 
          title: '3. 今後10年を見据えた最先端アーキテクチャ', 
          description: "軽量なコードで超高速パフォーマンスを実現し、最新の暗号化プロトコルで強固なセキュリティを担保。スマートフォンからPCまで、あらゆる画面サイズで美しく確実な導線を提供します。", 
          icon: 'tabler:rocket' 
        },
        { 
          title: '4. 瞬時に高まる信頼性とSEO（検索順位）の刷新', 
          description: "ゼロから構築し直すことで、検索順位の足を引っ張ってきた古い「マイナス要素」を一掃。初日から完璧な構造化データを実装し、Googleに「権威のある情報源」として評価させます。", 
          icon: 'tabler:chart-arrows-vertical' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">今後10年を見据えたアーキテクチャ</h3>
      <p class="text-lg text-muted mb-6">
        最新鋭のWebテクノロジーを駆使して構築します。今日現在モダンであるだけでなく、未来のテクノロジー環境にも対応できるよう設計されています。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1691484466261-cb7557646ffc?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTUyfHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Traditional Japanese Setting" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 4: WHY GRAND OPENING -->
  <Steps2
    title="先見の明を持つオーナーに「グランドオープン」が選ばれる理由"
    subtitle="過去のシステムを継ぎ接ぎして使うのは終わりにし、未来へ向けて新たなスタートを切りましょう。"
    items={[
      {
        title: '完全な安心感（丸投げOK）',
        description: 'サーバー移行、ホスティング、デザイン、文章の最適化まですべてお任せください。オーナー様は「お店のビジョン」を共有していただくだけで、私たちが確実な「結果」をご提供します。',
        icon: 'tabler:shield-check',
      },
      {
        title: '投資対効果（ROI）の最大化',
        description: '圧倒的な速度、洗練されたデザイン、バイリンガル最適化を組み合わせることで、Webサイトは単なる「経費」から、高い予約率を生み出す「強力な営業資産」へと変わります。',
        icon: 'tabler:trending-up',
      },
      {
        title: 'ブランド価値の向上',
        description: 'デジタル上での見栄えを、実際の素晴らしいサービスの質と一致させます。もしあなたが地域で最高のおもてなしを提供しているなら、Webサイトもそれを証明するべきです。',
        icon: 'tabler:star',
      },
    ]}
    image={{ 
      src: 'https://images.unsplash.com/photo-1754228752210-e41501dd1773?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTg1fHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D', 
      alt: 'Luxury Japanese Cuisine',
    }}
  />

  <!-- SECTION 5: CTA 1 -->
  <CallToAction
    title="世界があなたを待っています"
    subtitle="「そこそこ」のWebサイトで通用する時代は終わりました。現代のグローバルな旅行者を惹きつけるには、目を引き、心からの信頼を得られるデジタル基盤が必要です。"
    actions={[
        { variant: 'primary', text: '48時間グランドオープンの枠を確保する', href: '/contact-jp' }
    ]}
  >
    <Fragment slot="tagline">48時間リニューアルは、品質維持のため毎月の対応枠に限りがございます。空き状況については今すぐお問い合わせください。</Fragment>
  </CallToAction>

  <!-- SECTION 6: PRICING -->
  <Pricing 
    id="pricing"
    title="次の10年を牽引するデジタル不動産への投資" 
    subtitle="48時間以内のフルスタック・リブート"
    prices={[pricingData]} 
  />

  <!-- SECTION 7: ABOUT HANEI -->
  <CallToAction
    title="Haneiについて"
    subtitle="Haneiは、日本の地域ビジネスを支援し、活力を与えることに尽力しています。私たちは「日本のローカル文化こそが最大の資産」であると信じています。言葉の壁によるストレスを感じることなく、世界中の人々にその素晴らしい体験を届けるために、最新のテクノロジーを活用してあなたのお店をサポートします。"
    actions={[]}
  />

</Layout>
