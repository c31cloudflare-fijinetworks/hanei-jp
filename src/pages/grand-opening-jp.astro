---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { title: 'グランドオープニング | ホームページ制作' };

const pricingData = [
  {
    title: 'グランド・リフォーム',
    subtitle: '今のサイトを、最新デザインへ刷新。',
    price: '78,800',
    period: '10ページまで',
    items: [
      { description: '最新のクリーンなデザインへ刷新' },
      { description: '100%スマホ対応（レスポンシブ）' },
      { description: '表示速度とパフォーマンスの改善' },
      { description: '最短4日のスピード納品' },
    ],
    callToAction: { target: '_self', text: 'リフォームを申し込む', href: '/contact-jp', variant: 'primary' },
  },
  {
    title: 'グランド・ニューオープン',
    subtitle: 'ゼロから作る、最高品質の新規サイト。',
    price: '78,800',
    period: '10ページまで',
    items: [
      { description: '日英バイリンガル対応の最新設計' },
      { description: '爆速で動く最新テクノロジー' },
      { description: '「おもてなし」を伝えるデザイン' },
      { description: '最短4日のスピード納品' },
    ],
    callToAction: { target: '_self', text: '新規制作を申し込む', href: '/contact-jp', variant: 'primary' },
    hasRibbon: true,
    ribbonTitle: '人気',
  }
];
---

<Layout metadata={metadata}>
  <Hero2
    tagline="グランドオープニング"
    title='あなたのホームページは、<br/><span class="text-accent">「集客」に貢献していますか？</span>'
    subtitle="古いデザインや遅い表示は、お客様を逃します。プロ品質のサイトを最短4日でお届けします。"
    actions={[{ variant: 'primary', text: 'プランを見る', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?w=611&h=405&auto=format&fit=crop', alt: '和食' }}
  />
  
  <Content
    isReversed={false}
    title="ホームページは、お店の「顔」です。"
    subtitle="「スマホで見づらい」「表示が遅い」…そんな悩みはありませんか？Haneiが最高品質のサイトを構築します。"
    items={[
        { title: '表示速度の改善', description: '読み込みが遅いとお客様は離脱します。一瞬で表示されるサイトへ。', icon: 'tabler:bolt' },
        { title: '信頼感の向上', description: '清潔感と高級感のあるデザインで、一目で「選ばれる店」へ。', icon: 'tabler:shield-check' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1628652337240-80d1ed549f47?w=611&h=405&auto=format&fit=crop', alt: '寿司' }}
  />

  <Content
    isReversed={true}
    title="選択肢1：グランド・リフォーム"
    subtitle="既存の情報を活かしつつ、デザインと速度をフルリフォーム。最短4日でデジタルの印象を劇的に変えます。"
    items={[
        { title: '劇的ビフォーアフター', description: '見た目と機能を最新にアップデート。見違えるほど美しくなります。', icon: 'tabler:palette' },
        { title: 'スマホ最適化', description: 'あらゆる画面サイズで完璧に表示されるよう設計します。', icon: 'tabler:device-mobile' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1626379907753-406934326e2c?w=611&h=405&auto=format&fit=crop', alt: '料理' }}
  />

  <Content
    isReversed={false}
    title="選択肢2：グランド・ニューオープン"
    subtitle="心機一転、最高の拠点を。インバウンドと国内集客を両立させるバイリンガル・フラッグシップサイト。"
    items={[
        { title: 'バイリンガル設計', description: '日本人客も海外客も強力に惹きつけるデュアル言語構造。', icon: 'tabler:world' },
        { title: '最新テクノロジー', description: '数年先も古くならない最新技術で、常に爆速な運用が可能。', icon: 'tabler:rocket' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1691484466261-cb7557646ffc?w=611&h=405&auto=format&fit=crop', alt: '日本' }}
  />

  <Pricing id="pricing" title="ワンプライスで劇的チェンジ" prices={pricingData} />

  <CallToAction title="Haneiについて" subtitle="日本の地域ビジネスを支援し、最新のテクノロジーで「繁栄」をお手伝いします。" />
  <CallToAction title="About Hanei" subtitle="Haneiは、日本の地域ビジネスを支援することに全力を注いでいます。私たちは、日本の地域文化こそが最大の資産であると信じています。テクノロジーを活用することで、言葉の壁によるストレスを感じることなく、世界中の人々がその素晴らしさを体験できる未来を目指しています。" />
</Layout>
