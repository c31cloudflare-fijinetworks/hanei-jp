---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import FeatureTable from '~/components/widgets/FeatureTable.astro';
const metadata = { title: 'グランドオープニング | ホームページ制作' };
const fullFeatureListJp = [{ title: '超高速エッジ配信' }, { title: '日英バイリンガル・ナビ' }, { title: 'GoogleマップSEO対策' }, { title: 'スマホファースト設計' }, { title: 'SSL暗号化通信' }, { title: 'ワンクリック予約導線' }, { title: 'カスタムQRコード制作' }, { title: 'プロによる英語執筆' }, { title: 'SNS連携設定' }, { title: '画像データ最適化' }, { title: '全ブラウザ互換対応' }, { title: 'ダウンタイムなしの移行' }, { title: '修正回数無制限' }, { title: '週末48時間の超速公開' }, { title: 'Cloudflare CDN' }, { title: '自動バックアップ' }, { title: 'プライバシーポリシー' }, { title: '戦略的UXデザイン' }, { title: '地域No.1ブランド構築' }, { title: '永久テクニカルサポート' }];
---
<Layout metadata={metadata}>
  <Hero2 tagline="グランドオープニング" title='あなたのホームページは、<br/><span class="text-accent">「集客」に貢献していますか？</span>' subtitle="古いデザインは、お客様を逃します。プロ品質のサイトを最短4日でお届けします。" actions={[{ variant: 'primary', text: 'リフォームを見る', href: '#reform' }, { variant: 'secondary', text: '新規制作を見る', href: '#new' }]} image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80', alt: '和食' }} />
  
  <Content isReversed={false} tagline="制作実例" title="フラッグシップ：ZenPod Tokyo" subtitle="ZenPod Tokyoのデモサイトで、私たちが構築するWebサイトのクオリティをご体験ください。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/capsule-hotel' }} image={{ src: 'https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200', alt: 'ホテル' }} />
  
  <Content isReversed={true} title="フラッグシップ：麻布プレミアムメディカル" subtitle="洗練された医療施設向けのデモ. 専門的なケア, 医師の紹介, 転院・予約フローを体験してください。" callToAction={{ variant: 'secondary', text: 'デモサイトを見る', href: '/demos/azabu-medical' }} image={{ src: 'https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200', alt: '医療' }} />
  
  <Content isReversed={false} title="フラッグシップ：表参道デンタルアーツ" subtitle="外国人患者に最適化されたクリニックのデモ。バイリンガルの信頼構築とスムーズな予約導線を備えています。" callToAction={{ variant: 'secondary', text: 'デモサイトを見る', href: '/demos/omotesando-dental' }} image={{ src: 'https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1200', alt: '歯科' }} />

  <Content isReversed={true} title="フラッグシップ：GINZA KAIZEN" subtitle="銀座の高級ヘアサロン向けデモ。洗練された日本のスタイリング技術、完全英語対応の接客、転院・予約動線を体験できます。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/ginza-kaizen' }} image={{ src: 'https://images.unsplash.com/photo-1560869713-7d0a29430803?w=1200', alt: '美容' }} />

  <Content isReversed={false} title="フラッグシップ：Zen Relocations Japan" subtitle="外国人駐在員向けプレミアム引越しサービスのデモ. 日本品質の丁寧な梱包, 物流精度, そして完全英語対応のサポート体制を視覚化しています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/zen-relocations-japan-relocations' }} image={{ src: 'https://images.unsplash.com/photo-1722487631997-cf1e0f92c2c4?w=1200', alt: '物流' }} />

  <Content isReversed={true} title="フラッグシップ：Kissa & Co. Osaka" subtitle="現代の喫茶店体験を再解釈した洗練されたデモ。季節のコーヒーメニュー、高品質なビジュアルストーリー、そしてシームレスな予約動線を備えています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/kissa-co-osaka' }} image={{ src: 'https://images.unsplash.com/photo-1453614512568-c4024d13c247?w=1200', alt: 'ロースタリー' }} />

  <Content isReversed={false} title="フラッグシップ：Mizu no Kokoro" subtitle="高級銭湯・ウェルネス施設のデモ。伝統的な入浴儀式、モダンな空間デザイン、そして外国人ゲストに配慮した予約システムを構築しています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/mizu-no-kokoro-luxury-sento-wellness-osaka' }} image={{ src: 'https://images.unsplash.com/photo-1764057146162-64aaea28494a?w=1200', alt: '銭湯' }} />

  <Content isReversed={true} title="フラッグシップ：TAKUMI PRECISION TOKYO" subtitle="高度な工業技術・エンジニアリングに特化したデモサイト。精密機械加工、迅速なプロトタイピング、自動組み立てラインを視覚化し、海外企業向けの見積もり依頼（RFQ）動線を統合しています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/takumi-precision-tokyo-engineering-the-future' }} image={{ src: 'https://images.unsplash.com/photo-1757912666361-8c226b7279b9?w=1200', alt: '工業' }} />

  <Content isReversed={false} title="フラッグシップ：SHIKA-AN NARA" subtitle="奈良公園に佇む高級ヘリテージ・ゲストハウスのデモ。歴史的建築の美しさ、特別な体験プログラム、そして欧米富裕層向けのシームレスな予約導線を提供します。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/shika-an-nara-luxury-heritage-guesthouse' }} image={{ src: 'https://images.unsplash.com/photo-1530708780517-cc640cf05561?w=1200', alt: '旅館' }} />

  <Content isReversed={true} title="フラッグシップ：OSAKA UNSEEN" subtitle="大阪の隠れた名店を巡る高級グルメツアーのデモ。ネオン煌めく裏路地ツアー、ミシュラン店への特別アクセス、そして欧米富裕層向けの予約管理システムを統合しています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/osaka-unseen-luxury-culinary-expeditions' }} image={{ src: 'https://images.unsplash.com/photo-1605582763781-dff23d0f5d32?w=1200', alt: '大阪グルメ' }} />

  <Content isReversed={false} title="フラッグシップ：Private Kyoto Temple Expeditions" subtitle="京都の寺院を巡る高級プライベートツアーのデモ。一般非公開寺院への特別参拝、禅僧による解説、そして欧米富裕層向けの洗練された予約フローを統合しています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/private-kyoto-temple-expeditions' }} image={{ src: 'https://images.unsplash.com/photo-1574236170880-fbbca132d83d?w=1200', alt: '京都' }} />
  
  <div id="reform" class="scroll-mt-20"><Content tagline="グランド・リフォーム" title="今の情報を活かしつつ、最新デザインへ。" subtitle="週末の間に、サイトを最新の状態に生まれ変わらせます。" items={[{ title: '劇的リフォーム', description: '見た目と機能を最新に。', icon: 'tabler:palette' }]} image={{ src: 'https://images.unsplash.com/photo-1628652337240-80d1ed549f47?auto=format&fit=crop&w=1200&q=80', alt: '寿司' }} /><FeatureTable title="標準装備" subtitle="一括払い。追加費用なし。" items={fullFeatureListJp} /></div>
</Layout>
