---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import FeatureTable from '~/components/widgets/FeatureTable.astro';
const metadata = { title: 'グランドオープニング | ホームページ制作' };
const fullFeatureListJp = [{ title: '超高速エッジ配信' }, { title: '日英バイリンガル・ナビ' }, { title: 'GoogleマップSEO対策' }, { title: 'スマホファースト設計' }, { title: 'SSL暗号化通信' }, { title: 'ワンクリック予約導線' }, { title: 'カスタムQRコード制作' }, { title: 'プロによる英語執筆' }, { title: 'SNS連携設定' }, { title: '画像データ最適化' }, { title: '全ブラウザ互換対応' }, { title: 'ダウンタイムなしの移行' }, { title: '修正回数無制限' }, { title: '週末48時間の超速公開' }, { title: 'Cloudflare CDN' }, { title: '自動バックアップ' }, { title: 'プライバシーポリシー' }, { title: '戦略的UXデザイン' }, { title: '地域No.1ブランド構築' }, { title: '永久テクニカルサポート' }];
---
<Layout metadata={metadata}>
  <Hero2 tagline="グランドオープニング" title='あなたのホームページは、<br/><span class="text-accent">「集客」に貢献していますか？</span>' subtitle="古いデザインは、お客様を逃します。プロ品質のサイトを最短4日でお届けします。" actions={[{ variant: 'primary', text: 'リフォームを見る', href: '#reform' }, { variant: 'secondary', text: '新規制作を見る', href: '#new' }]} image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80', alt: '和食' }} />
  
  <!-- OPTION 1: REFORM -->
  <div id="reform" class="scroll-mt-20">
    <Content tagline="グランド・リフォーム" title="01. 劇的リフォーム" subtitle="今の情報を活かしつつ、国際的なラグジュアリー基準に合わせてデザインを刷新します。" items={[{ title: '劇的リフォーム', description: '見た目と機能を最新に。', icon: 'tabler:palette' }]} image={{ src: 'https://images.unsplash.com/photo-1628652337240-80d1ed549f47?auto=format&fit=crop&w=1200&q=80', alt: '寿司' }} classes={{ container: 'pb-0 md:pb-0' }} />
    
    <Content isReversed={true} isAfterContent={true} title="ブランド価値の再定義" subtitle="これまでの歩みを尊重しつつ、世界基準のインターフェースへと昇華させます。貴店のアイデンティティを保ちながら、プロフェッショナルな「顔」へとリフォームします。" image={{ src: 'https://images.unsplash.com/photo-1667560615919-837fe9001e58?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
    
    <Content isReversed={false} isAfterContent={true} title="超高速・次世代インフラへの移行" subtitle="見た目の刷新だけでなく、中身も最新へ。世界最速水準のエッジネットワークへ移行することで、モバイル環境でも瞬時の表示を実現。ストレスのない閲覧体験を提供します。" image={{ src: 'https://images.unsplash.com/photo-1749104953222-9d6ed76e4bf0?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <hr class="border-t dark:border-slate-800 my-4" />

  <!-- OPTION 2: NEW -->
  <div id="new" class="scroll-mt-20">
    <Content isReversed={true} tagline="グランド・ニュー" title="02. 完全新規制作" subtitle="ゼロからデジタル・エコシステムを構築します。最高のコンバージョン（予約・注文）を生むための、貴店専用のフラッグシップサイトを制作します。" items={[{ title: '新規ブランド構築', description: '市場に合わせたカスタムエンジニアリング。', icon: 'tabler:rocket' }]} image={{ src: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80', alt: 'New Structure' }} classes={{ container: 'pb-0 md:pb-0' }} />
    
    <Content isReversed={false} isAfterContent={true} title="成約率を最大化する設計" subtitle="新規制作においては、まず「成長のための設計図」から描き始めます。予約導線や問い合わせフローに独自のロジックを組み込み、訪問者を優良な顧客へと変える仕組みを構築します。" image={{ src: 'https://images.unsplash.com/photo-1644072267093-cbbfdb74303c?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
    
    <Content isReversed={true} isAfterContent={true} title="世界水準のデータ基盤" subtitle="最新のサーバーレステクノロジーを採用し、盤石な土台を築きます。ミリ単位のSEO最適化により、検索結果での優位性を確保し、地域の競合を圧倒するデジタル資産を提供します。" image={{ src: 'https://images.unsplash.com/photo-1648977555232-99b5a8c8c897?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <div class="py-8 bg-slate-50 dark:bg-transparent border-y dark:border-slate-800 my-10">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold font-heading mb-2">制作実例（フラッグシップ）</h2>
        <p class="text-lg text-muted">各業界で私たちが提供している最高水準のクオリティをご覧ください。</p>
    </div>
  </div>

  <div class="space-y-4">
    <Content isReversed={false} title="フラッグシップ：ZenPod Tokyo" subtitle="ZenPod Tokyoのデモサイトで、私たちが構築するWebサイトのクオリティをご体験ください。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/capsule-hotel' }} image={{ src: 'https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200', alt: 'ホテル' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} title="フラッグシップ：麻布プレミアムメディカル" subtitle="洗練された医療施設向けのデモ. 専門的なケア, 医師の紹介, 予約フローを体験してください。" callToAction={{ variant: 'secondary', text: 'デモサイトを見る', href: '/demos/azabu-medical' }} image={{ src: 'https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200', alt: '医療' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={false} title="フラッグシップ：GINZA KAIZEN" subtitle="銀座の高級ヘアサロン向けデモ。洗練された日本のスタイリング技術、完全英語対応の予約動線を体験できます。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/ginza-kaizen' }} image={{ src: 'https://images.unsplash.com/photo-1560869713-7d0a29430803?w=1200', alt: '美容' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} title="フラッグシップ：KURA TOKYO" subtitle="高級荷物預かり・セキュリティストレージのデモ. 欧米富裕層向けのコンシェルジュサービスを統合したセキュアなインフラを視覚化しています。" callToAction={{ variant: 'primary', text: 'デモサイトを見る', href: '/demos/kura-tokyo-premium-luggage-concierge-secure-storage' }} image={{ src: 'https://images.unsplash.com/photo-1756649627237-d367a3e3a311?w=1200', alt: 'コンシェルジュ' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <!-- COMBINED FEATURES TABLE -->
  <FeatureTable title="グランド・リフォーム ＆ グランド・ニュー・パッケージ" subtitle="すべてのフル制作プロジェクトに標準装備されるエリート機能一覧。" items={fullFeatureListJp} />

</Layout>
