---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features3 from '~/components/widgets/Features3.astro';

const metadata = { 
  title: 'Order Flow | Simple 3-Step Process | Hanei JP',
  description: 'From order to launch in record time. See how easy it is to start your professional digital expansion with zero monthly fees.'
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="The Hanei Process"
    title='Fast, Simple, and <br/><span class="text-accent">Stress-Free.</span>'
    subtitle="We know you're busy running your business. That's why we’ve eliminated long meetings, complicated contracts, and recurring monthly fees. Get started in minutes."
    image={{ src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1024&q=80', alt: 'Efficient Workflow' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />

  <Content
    isReversed={false}
    tagline="Step 01"
    title="Choose Your Service Package"
    subtitle="Select the plan that fits your business needs. Every package is a simple one-time investment—meaning no hidden monthly subscriptions or ongoing maintenance fees ever. Complete your secure payment instantly via Stripe or PayPal to begin."
    items={[{ title: 'One-Time Payment', description: 'Own your digital infrastructure forever with zero recurring costs.', icon: 'tabler:coin' }]}
    image={{ src: 'https://images.unsplash.com/photo-1576675466969-38eeae4b41f6?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Content
    isReversed={true}
    isAfterContent={true}
    tagline="Step 02"
    title="Share Your Business Details"
    subtitle="Fill out our streamlined onboarding form. Simply provide your basic shop info, services, and high-resolution photos. No technical skills or system passwords are required—we handle the complexity while you focus on your customers."
    items={[{ title: 'Guided Onboarding', description: 'Our team assists you in gathering the right details.', icon: 'tabler:file-description' }]}
    image={{ src: 'https://images.unsplash.com/photo-1525230071276-4a87f42f469e?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Content
    isReversed={false}
    isAfterContent={true}
    tagline="Step 03"
    title="Professional Build & Review"
    subtitle="Our developers and writers construct your high-performance site within 24 to 72 hours. You will receive a private preview link to review the design and copy. We offer unlimited revisions until the final result perfectly reflects your craft."
    items={[{ title: 'Absolute Precision', description: 'We polish every detail until you are 100% satisfied.', icon: 'tabler:tool' }]}
    image={{ src: 'https://images.unsplash.com/photo-1578637387939-43c525550085?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Content
    isReversed={true}
    isAfterContent={true}
    tagline="Step 04"
    title="Launch and Global Reach"
    subtitle="Once you love the result, we go live! Your business is now connected to our high-speed global edge network. We provide you with your custom QR kits and digital assets so you can start welcoming new customers immediately."
    items={[{ title: 'Record Launch Speed', description: 'Go from zero to live in as little as one business day.', icon: 'tabler:rocket' }]}
    image={{ src: 'https://images.unsplash.com/photo-1491884662610-dfcd28f30cfb?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Features3
    title="Built for Busy Owners"
    subtitle="We handle the heavy lifting so you don't have to."
    columns={3}
    items={[
      { title: 'Zero Monthly Fees', description: 'Lifetime ownership. No SaaS taxes, hosting bills, or hidden costs.', icon: 'tabler:circle-check' },
      { title: 'Zero Tech Talk', description: 'We communicate in plain language. No "coding talk" or jargon.', icon: 'tabler:message-circle' },
      { title: 'Record Speed', description: 'Most services delivered within 24 to 72 hours.', icon: 'tabler:bolt' },
    ]}
    classes={{ container: 'py-8 md:py-12' }}
  />
</Layout>
