---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = { 
  title: '注文の流れ | シンプルな3ステップ | Hanei JP',
  description: '注文から公開まで、最短・最速。月額費用ゼロでデジタルの拠点を構築するためのステップをご案内します。'
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="Haneiの注文メソッド"
    title='驚くほど、<br/><span class="text-accent">かんたんで、スムーズ.</span>'
    subtitle="オーナー様の貴重な時間を無駄にはしません。長い打ち合わせや複雑な契約書、そして「毎月の月額費用」は一切ありません。"
    image={{ src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1024&q=80', alt: '効率的なワークフロー' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />

  <Content
    isReversed={false}
    tagline="Step 01"
    title="サービスを選んで注文"
    subtitle="ご希望のプランを選び、オンラインで決済を完了します。すべてのパッケージは「一括払い」の買い切り型。月額のサブスクリプションや隠れた維持管理費は永久に発生しません。"
    items={[{ title: '月額費用 0円', description: '一度の投資で、永久に貴店の資産として保有いただけます。', icon: 'tabler:coin' }]}
    image={{ src: 'https://images.unsplash.com/photo-1576675466969-38eeae4b41f6?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Content
    isReversed={true}
    isAfterContent={true}
    tagline="Step 02"
    title="情報の送付"
    subtitle="専用のフォームに、お店の情報や写真、ご要望を入力して送るだけ。専門知識やパスワードの共有は不要です。面倒な設定はすべて私たちが代行します。"
    items={[{ title: '丸投げOK', description: 'ITや翻訳の知識は一切不要です。', icon: 'tabler:file-description' }]}
    image={{ src: 'https://images.unsplash.com/photo-1525230071276-4a87f42f469e?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Content
    isReversed={false}
    isAfterContent={true}
    tagline="Step 03"
    title="制作・最終確認"
    subtitle="最短24時間〜72時間以内にプロがサイトを構築。確認用のプレビューURLをお送りします。内容やデザインに100%ご満足いただけるまで、修正回数に制限はありません。"
    items={[{ title: '無制限の修正', description: '納得のいくまで、何度でも無料で調整いたします。', icon: 'tabler:tool' }]}
    image={{ src: 'https://images.unsplash.com/photo-1578637387939-43c525550085?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Content
    isReversed={true}
    isAfterContent={true}
    tagline="Step 04"
    title="公開・運用開始"
    subtitle="完成後、すぐに世界最高水準のエッジネットワークで公開されます。店頭用のQRコードキットやデジタル素材も同時にお届けし、即座に集客を開始できます。"
    items={[{ title: '最短当日公開', description: '情報提供から最短1営業日で全世界へ配信。', icon: 'tabler:rocket' }]}
    image={{ src: 'https://images.unsplash.com/photo-1491884662610-dfcd28f30cfb?w=1200&auto=format&fit=crop&q=60' }}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <Features3
    title="忙しいオーナー様のために"
    subtitle="面倒な作業はすべて私たちが代行します。"
    columns={3}
    items={[
      { title: '月額費用は永久無料', description: '一括払いのみ。追加のサーバー代や管理費はかかりません。', icon: 'tabler:circle-check' },
      { title: '専門用語は使いません', description: 'わかりやすい言葉で丁寧に進めます。ITの話は不要です。', icon: 'tabler:message-circle' },
      { title: '圧倒的なスピード', description: '情報を受け取ってから最短24〜72時間以内に納品。', icon: 'tabler:bolt' },
    ]}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <hr class="max-w-7xl mx-auto border-t dark:border-slate-800" />

  <Features2
    title="今すぐエリート・デジタル資産を確保する"
    subtitle="ビジネスの成長に最適なソリューションをお選びください。"
    columns={3}
    items={[
      {
        title: '1ページ・ビジネスサイト',
        description: 'デジタルの案内板。お昼の注文で夕方には公開。',
        icon: 'tabler:square-number-1',
        callToAction: { text: 'プランを見る', href: '/one-page-welcome-jp' },
      },
      {
        title: 'レビューエンジン',
        description: '信頼の自動化。お客様の声を星5つのGoogle評価へ。',
        icon: 'tabler:stars',
        callToAction: { text: 'プランを見る', href: '/review-engine-jp' },
      },
      {
        title: '英語専用デジタル別館',
        description: '世界進出への離れ。既存サイトをいじらずに英語化。',
        icon: 'tabler:language',
        callToAction: { text: 'プランを見る', href: '/english-hanare-jp' },
      },
      {
        title: 'グランド・リフォーム',
        description: 'デザインの劇的刷新。今のサイトをラグジュアリーに。',
        icon: 'tabler:palette',
        callToAction: { text: 'リフォームを見る', href: '/grand-opening-jp/#reform' },
      },
      {
        title: 'グランド・ニュー（新規制作）',
        description: 'デジタル設計図の完成。ゼロから最強の旗艦店を構築。',
        icon: 'tabler:rocket',
        callToAction: { text: '新規制作を見る', href: '/grand-opening-jp/#new' },
      },
    ]}
    classes={{ container: 'py-12 md:py-20' }}
  />
</Layout>
