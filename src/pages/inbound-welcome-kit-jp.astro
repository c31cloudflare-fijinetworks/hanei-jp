---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'インバウンド・ウェルカムキット | Hanei JP', 
  description: '「言葉の壁」を「歓迎」に変え、日常業務を変えずに高単価の外国人観光客を自動で集客します。',
};

const pricingData = {
  title: 'ウェルカムキット・スタンダード',
  subtitle: '24時間対応のグローバル受付を構築',
  price: '128,500',
  period: '初期費用 ＋ 月額保守 ¥9,800',
  items: [
    { description: '英語最適化されたWeb集客＆ビジュアルメニュー' },
    { description: 'Googleマップ（MEO）英語キーワード最適化' },
    { description: '「口コミシールド」と評価向上エンジン' },
    { description: 'デジタル「指さし会話」接客ツール' },
    { description: 'サーバー保守と継続的なシステムアップデート' },
  ],
  callToAction: { target: '_self', text: '無料インバウンド診断を申し込む', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="インバウンド・ウェルカムキット"
    title='訪日客の受け入れに、<br/><span class="text-accent">もう悩む必要はありません。</span>'
    subtitle="「言葉の壁」を「歓迎」に変え、日常業務を変えずに高単価の外国人観光客を自動で集客します。"
    actions={[{ variant: 'primary', text: '無料インバウンド診断を申し込む', href: '/contact-jp' }]}
    image={{ src: 'https://images.unsplash.com/photo-1522623349500-de37a56ea2a5?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTV8fGphcGFufGVufDB8fDB8fHwy', alt: 'Beautiful Japan Scenery' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
    items={[
        { 
          title: 'コミュニケーションの壁', 
          description: '「英語が話せないから、十分なおもてなし（サービス）ができないかもしれない」', 
          icon: 'tabler:messages-off' 
        },
        { 
          title: 'デジタル集客への戸惑い', 
          description: '「外国人に向けたGoogleやTripAdvisorの活用方法がわからない」', 
          icon: 'tabler:cloud-fog' 
        },
        { 
          title: '口コミへの恐怖', 
          description: '「言葉の壁による些細な誤解で、対応もできないまま星1つの低評価をつけられたらどうしよう」', 
          icon: 'tabler:star-off' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">本格的なインバウンド需要の回復。<br/>機会を逃していませんか？</h3>
      <p class="text-lg text-muted mb-4">
        スマホを片手に、お店の前を通り過ぎる外国人観光客。彼らは「本物のローカル体験」を求めているのに、何かが原因で入店をためらっています。その光景を、あなたも日常的に目にしているのではないでしょうか。
      </p>
      <p class="text-lg text-muted mb-6">
        英語のメニューがないからでしょうか。Googleマップの情報が日本語のみだからでしょうか。それとも、「英語で複雑な要望をされたらどうしよう」という、あなた自身の不安がストップをかけているのかもしれません。<strong>Haneiの「インバウンド・ウェルカムキット」は、こうした不安を根本から解消し、あなたが誇るサービスと世界中の旅行者を安全に橋渡しします。</strong>
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1564284369929-026ba231f89b?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTZ8fGphcGFufGVufDB8fDB8fHwy" alt="Tourists in Japan" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: THE 3 NO's -->
  <Content
    isReversed={true}
    items={[
        { 
          title: '1. 英語力は不要（NO English Required）', 
          description: '新しく英語を学ぶ必要はありません。私たちのツールと自動化システムが、翻訳とコミュニケーションを代行します。', 
          icon: 'tabler:language' 
        },
        { 
          title: '2. 専門的なITスキルは不要（NO Technical Skill）', 
          description: 'デジタル周りの構築・管理はすべてお任せください。スマートフォンが使えれば、システムを簡単に使いこなせます。', 
          icon: 'tabler:device-mobile' 
        },
        { 
          title: '3. スタッフの業務負担増はなし（NO Extra Work）', 
          description: '現在の業務フローにそのまま組み込めます。複雑な新しい機器の導入や、時間のかかるスタッフ研修は必要ありません。', 
          icon: 'tabler:clock-check' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Haneiのお約束：<br/>インバウンド成功のための「3つのゼロ」</h3>
      <p class="text-lg text-muted">
        売上を伸ばすために、経営者の負担が増えては意味がありません。私たちのシステムは、面倒な手間をかけずに結果を出したい、多忙なオーナー様のために設計されています。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1533050487297-09b450131914?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTh8fGphcGFufGVufDB8fDB8fHwy" alt="Japan City Lights" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 3: TOTAL SOLUTION -->
  <Content
    isReversed={false}
    items={[
        { 
          title: '1. 英語最適化されたWeb集客', 
          description: '「見ているだけの人」を「来店客」に変えることに特化したページ。何を注文しているか一目でわかるビジュアルメニューと、来店前に予約・決済を完了できるスムーズな動線を提供します。', 
          icon: 'tabler:world-www' 
        },
        { 
          title: '2. Googleマップ（MEO）の最適化', 
          description: '外国人が「近くの美味しいお店」と英語で検索した時、あなたのお店は表示されるでしょうか？Googleプロフィールを英語キーワードで最適化し、最も重要な検索結果で上位表示を狙います。', 
          icon: 'tabler:map-pin' 
        },
        { 
          title: '3. 「口コミシールド」と評価向上エンジン', 
          description: '満足したお客様に英語レビュー投稿を自動で促します。不満を持ったお客様の声は公開前に「非公開メッセージ」としてキャッチ。AI返信ツールでスマートな対応も可能です。', 
          icon: 'tabler:shield-star' 
        },
        { 
          title: '4. デジタル「指さし会話」ツール', 
          description: 'アレルギー、Wi-Fi、支払い方法について聞かれても、タブレットや印刷したガイドを「指さす」だけで対応可能。接客スピードを落とさず、お客様もスタッフも笑顔でいられます。', 
          icon: 'tabler:hand-click' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">インバウンド・ウェルカムキット：<br/>トータルソリューション</h3>
      <p class="text-lg text-muted mb-6">
        単なるWebサイト制作ではありません。あなたのお店に「24時間対応のグローバル受付」を構築します。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1554797589-7241bb691973?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Njh8fGphcGFufGVufDB8fDB8fHwy" alt="Japanese Dining" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 4: HOW TO GET STARTED -->
  <Steps2
    title="導入までの3ステップ"
    subtitle="すべてを一人で抱え込む必要はありません。現在、どれだけ多くの潜在的な外国人客があなたのお店を検索しているか、実際にデータでお見せします。"
    items={[
      {
        title: 'ステップ1：無料インバウンド診断',
        description: '英語キーワードにおける、あなたのお店の現在のGoogleマップ順位やWebでの露出度を分析します。',
        icon: 'tabler:search',
      },
      {
        title: 'ステップ2：カスタマイズ戦略のご提案',
        description: '現状の「課題・抜け漏れ」を明確にし、ウェルカムキットがそれをどう解決するかを具体的にご提案します。',
        icon: 'tabler:bulb',
      },
      {
        title: 'ステップ3：安心のスタート（本業への集中）',
        description: 'キットを導入した後は、あなたが最も得意とする「ご自身のお店づくり」に集中してください。その間に、世界中のお客様があなたのお店を見つけ、来店するようになります。',
        icon: 'tabler:rocket',
      },
    ]}
    callToAction={{ text: '無料インバウンド診断を申し込む', href: '/contact-jp', variant: 'primary' }}
    image={{ 
      src: 'https://images.unsplash.com/photo-1611518040385-1cc65ab82c91?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTB8fGl6YWtheWF8ZW58MHx8MHx8fDI%3D', 
      alt: 'Izakaya Interior',
    }}
  />

  <!-- SECTION 5: PRICING -->
  <Pricing 
    id="pricing"
    title="シンプルで透明性の高い料金体系" 
    subtitle="隠れた追加費用や複雑な料金プランはありません。プロによる初期設定（一律料金）と、月に数名の外国人客の来店で十分に回収できる低額の月額保守費用のみでご利用いただけます。"
    prices={[pricingData]} 
  />

  <!-- SECTION 6: ABOUT HANEI -->
  <CallToAction
    title="Haneiについて"
    subtitle="Haneiは、日本の地域ビジネスを支援し、活力を与えることに尽力しています。私たちは「日本のローカル文化こそが最大の資産」であると信じています。言葉の壁によるストレスを感じることなく、世界中の人々にその素晴らしい体験を届けるために、最新のテクノロジーを活用してあなたのお店をサポートします。"
    actions={[]}
  />

</Layout>
