---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { title: '英語サイト制作「離れ」プラン' };

const pricingData = {
  title: '英語サイト制作「離れ」プラン',
  subtitle: 'インバウンド集客のための、独立型英語サイト。',
  price: '59,800',
  period: '制作費用（10ページまで）',
  items: [
    { description: '最大10ページの本格英語サイト制作' },
    { description: 'ネイティブによるプロ品質の翻訳・執筆' },
    { description: 'パスワードやログイン情報の共有不要' },
    { description: '最短3日でのスピード納品' },
    { description: '満足いただけるまで修正無制限' },
  ],
  callToAction: { target: '_self', text: '英語サイト制作を申し込む', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="「離れ」のウェブ戦略"
    title='今のサイトは、いじりません。<br/><span class="text-accent">リスクゼロの英語サイト制作。</span>'
    subtitle='「日本語サイトを壊したくない」「ログイン情報を忘れた」…そんな悩みを解決。既存サイトはそのままに、独立した高品質な英語サイトを最短3日で構築します。'
    actions={[{ variant: 'primary', text: 'まずは相談する', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=611&h=405&auto=format&fit=crop', alt: '高級日本料理' }}
  />
  
  <Content
    isReversed={false}
    title='「英語化したいけど、今のサイトを触るのが怖い」'
    subtitle="既存の日本語サイトには一切触れず、独立した「デジタルの離れ」を構築することで技術的リスクをゼロにします。"
    items={[
        { title: 'サイトへの影響ゼロ', description: '既存のシステムに手を入れないため、不具合が起きるリスクは一切ありません。', icon: 'tabler:shield-lock' },
        { title: 'パスワード不要', description: '昔作ったサイトのログイン情報がわからなくても、独立して制作可能です。', icon: 'tabler:key-off' },
        { title: 'ネイティブ品質', description: '不自然な自動翻訳は信頼を損ないます。ネイティブが納得する「売れる英語」を提供。', icon: 'tabler:message-language' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: '日本料理' }}
  />

  <Steps2
    title="導入までの3ステップ"
    subtitle="手間は取らせません。最短3日で完了します。"
    items={[
      { title: 'STEP 1: URLを送るだけ', description: '現在のホームページのURLをお送りください。ログイン情報は不要です。', icon: 'tabler:link' },
      { title: 'STEP 2: 私たちが制作', description: 'プロの英語とモダンなデザインで、最短3日で構築します。', icon: 'tabler:bolt' },
      { title: 'STEP 3: 運用開始', description: '満足いただけるまで何度でも修正。完成後、世界中のお客様を迎えましょう。', icon: 'tabler:world' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=611&h=405&auto=format&fit=crop', alt: '食卓' }}
  />

  <Pricing id="pricing" title="インバウンド収客の最強資産" subtitle="リスクなし、手間なしで、世界へお店を開放しましょう。" prices={[pricingData]} />

  <CallToAction title="Haneiについて" subtitle="日本の地域ビジネスを支援し、最新のテクノロジーと言葉の壁を超えた「繁栄」をお手伝いします。" />
</Layout>
