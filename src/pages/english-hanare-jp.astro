---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: '英語の離れ（Hanare） | Hanei JP', 
  description: '技術的なリスクゼロで実現するグローバル展開。既存サイトに触れず、最高水準の別館を構築します。',
};

const pricingData = {
  title: 'English Hanare 構築プラン',
  subtitle: '既存システムを維持したまま、最高級の別館を',
  price: '98,500',
  period: '一括投資（ランニングコスト不要）',
  items: [
    { description: '最大10ページのディープ・コンテンツ構築' },
    { description: 'ネイティブ水準のビジネス・コピーライティング' },
    { description: '既存サイトとの完全分離（デカップリング）' },
    { description: 'Stripe/Calendly等の外部API連携' },
    { description: '24時間以内の自動化デプロイ' },
  ],
  callToAction: { target: '_self', text: '「英語の離れ」の構築について相談する', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="「英語の離れ（Hanare）」戦略"
    title='技術的なリスクゼロで実現する<br/><span class="text-accent">グローバル展開。</span>'
    subtitle="世界初の「離れ（独立型）」Webアーキテクチャのご提案。現在稼働中の日本語Webサイトには一切手を触れず（安全性100%）、高いコンバージョンを誇る最新のグローバル基盤を構築します。"
    actions={[{ variant: 'primary', text: '「英語の離れ」について相談する', href: '/contact-jp' }]}
    image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8amFwYW5lc2UlMjBmb29kfGVufDB8fDB8fHwy', alt: 'Premium Japanese Dining' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
    items={[
        { 
          title: 'システム崩壊のリスク', 
          description: '英語を追加するために制作会社が古いシステムをいじった結果、たった一つのミスで大切な日本語サイト全体がダウンしてしまうかもしれないという恐怖。', 
          icon: 'tabler:alert-triangle' 
        },
        { 
          title: 'パスワードや権限の所在不明', 
          description: '何年も前にサイトを作った会社のFTPログイン情報やCMSのアクセス権限が、すでに社内で分からなくなっているという現実的な問題。', 
          icon: 'tabler:lock-off' 
        },
        { 
          title: 'デザインと心理のズレ', 
          description: '日本語サイトをただ直訳しても、欧米人には響きません。フォント、レイアウト、そして「購買に至る心理」が根本的に異なるからです。', 
          icon: 'tabler:palette' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">ジレンマ：<br/>「英語サイトは欲しいが、今のサイトをいじるのは怖い」</h3>
      <p class="text-lg text-muted mb-4">
        多くの歴史ある日本の企業様や店舗様にとって、Webサイトはビジネスの生命線です。しかし、何年も更新されていない古いコードや複雑なシステム（レガシーシステム）で構築されていることも少なくありません。
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Haneiの「英語の離れ（Hanare）」戦略は、古いサイトを「修理」する連鎖を断ち切り、世界中のお客様を安全に「歓迎」するための全く新しい解決策です。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NXx8amFwYW5lc2UlMjBmb29kfGVufDB8fDB8fHwy" alt="Authentic Japanese Cuisine" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: DIGITAL RED CARPET & SHIELD -->
  <Content
    isReversed={true}
    items={[
        { 
          title: '1. 既存サイトに触れない「ゼロ・タッチ」統合', 
          description: 'パスワードも、FTP情報も不要です。高度なDNS設定を利用し専用の独自ドメイン（離れ）を構築。日本語サイトはこれまで通り稼働し、技術的リスクは完全にゼロです。', 
          icon: 'tabler:shield-check' 
        },
        { 
          title: '2. 欧米の富裕層の心理に合わせた最適化', 
          description: '言葉だけでなく「ブランド価値」を翻訳します。高単価な旅行者の心に響くデザインと、国際ローミング環境下でも超高速で読み込まれるモバイルファースト設計を採用。', 
          icon: 'tabler:diamond' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">コンセプト：<br/>大切なお客様をお迎えする「離れ」</h3>
      <p class="text-lg text-muted">
        伝統的な日本建築において「離れ」とは、特別なお客様のために静かでモダンに整えられた、最高のおもてなしの場です。既存の日本語サイト（母屋）に無理やり英語を「詰め込む」のではなく、外国人ゲストに特化した最新・高速のデジタル空間を独立して新設するのです。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1569912815867-5580004c13a2?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NHx8amFwYW5lc2UlMjBmb29kfGVufDB8fDB8fHwy" alt="Japanese Sushi Preparation" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 3: WALL OF FAME & QR -->
  <Content
    isReversed={false}
    items={[
        { 
          title: '3. 完全な独立性による「未来への備え」', 
          description: "将来、日本語サイトをフルリニューアルすることになっても、英語サイトは一切影響を受けず安定して稼働し続けます。最新の安全なアーキテクチャで構築されます。", 
          icon: 'tabler:layers-intersect' 
        },
        { 
          title: '4. 「コンシェルジュ」のような予約導線', 
          description: "単なるパンフレットではなく、高いコンバージョンを生む営業ツールです。複雑なメニューを省き、「今すぐ予約」へスムーズに導くビジュアル・ストーリーテリングを活用します。", 
          icon: 'tabler:concierge-bell' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">圧倒的な機能：<br/>絶対的な安全性と、完全な最適化</h3>
      <p class="text-lg text-muted mb-6">
        古いシステムは脆弱です。万が一、母屋のサーバーがダウンしても、海外からのクレジットカード決済や問い合わせに対して、最もセキュアな環境を提供し続けます。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1576863514292-542ef379c13b?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTh8fGphcGFuZXNlJTIwZm9vZHxlbnwwfHwwfHx8Mg%3D%3D" alt="Japanese Dish Detail" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 4: WHY INVEST -->
  <Steps2
    title="「英語の離れ」が選ばれる理由"
    subtitle="過去のシステムを「壊してしまうかもしれない」という不安を手放し、未来の集客基盤を「築く」ことに集中しましょう。"
    items={[
      {
        title: '圧倒的なスピード',
        description: '古いコードを解読・改修する必要がないため、通常の多言語化プロジェクトの何分の一かの期間でグローバル展開をスタートできます。',
        icon: 'tabler:bolt',
      },
      {
        title: '絶対的な安全性',
        description: '現在の社内IT担当者や契約中のWeb制作会社の業務を邪魔することはありません。私たちは並行した別の安全な領域で構築を行います。',
        icon: 'tabler:lock',
      },
      {
        title: 'オーダーメイドの品質',
        description: '国内向けサイトの「おまけの直訳版」ではなく、洗練されたグローバルブランドとしての独立した美しいサイトが手に入ります。',
        icon: 'tabler:star',
      },
    ]}
    image={{ 
      src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NDZ8fGphcGFuZXNlJTIwZm9vZHxlbnwwfHwwfHx8Mg%3D%3D', 
      alt: 'Luxury Japanese Table Setting',
    }}
  />

  <!-- SECTION 5: CTA 1 -->
  <CallToAction
    title="世界中のお客様をお迎えする「離れ」を"
    subtitle="「既存サイトに一切触れない」安全なグローバル展開で、圧倒的な安心感と収益拡大を体験してください。世界中の市場が、あなたのお店を探しています。"
    actions={[
        { variant: 'primary', text: '「英語の離れ」の構築について相談する', href: '/contact-jp' }
    ]}
  >
    <Fragment slot="tagline">パスワード等の技術的な情報は不要です。現在のWebサイトのURLさえあれば、すぐに分析を開始できます。</Fragment>
  </CallToAction>

  <!-- SECTION 6: PRICING -->
  <Pricing 
    id="pricing"
    title="世界市場に向けた最高級の拠点を" 
    subtitle="弊社最上位の人気プラン（一括投資モデル）"
    prices={[pricingData]} 
  />

  <!-- SECTION 7: ABOUT HANEI -->
  <CallToAction
    title="Haneiについて"
    subtitle="Haneiは、日本の地域ビジネスを支援し、活力を与えることに尽力しています。私たちは「日本のローカル文化こそが最大の資産」であると信じています。言葉の壁によるストレスを感じることなく、世界中の人々にその素晴らしい体験を届けるために、最新のテクノロジーを活用してあなたのお店をサポートします。"
    actions={[]}
  />

</Layout>
