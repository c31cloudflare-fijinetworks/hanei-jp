---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { title: 'The Grand Opening | Professional Web Design' };

const pricingData = [
  {
    title: 'Grand Reform',
    subtitle: 'A total makeover for your current site.',
    price: '78,800',
    period: 'Up to 10 pages',
    items: [
      { description: 'Update to a Modern, Clean Design' },
      { description: 'Make it 100% Mobile Friendly' },
      { description: 'Fix Speed & Performance Issues' },
      { description: '4-Day Turnaround (Order by noon)' },
      { description: 'Unlimited revisions until satisfied' },
    ],
    callToAction: { target: '_self', text: 'Start My Reform', href: '/contact', variant: 'primary' },
  },
  {
    title: 'Grand New Opening',
    subtitle: 'A fresh start with a brand new site.',
    price: '78,800',
    period: 'Up to 10 pages',
    items: [
      { description: 'Brand New Bilingual Architecture' },
      { description: 'Latest High-Speed Tech Stack' },
      { description: 'Modern "Luxury Guest" UX Design' },
      { description: '4-Day Turnaround (Order by noon)' },
      { description: 'Unlimited revisions until satisfied' },
    ],
    callToAction: { target: '_self', text: 'Launch My New Site', href: '/contact', variant: 'primary' },
    hasRibbon: true,
    ribbonTitle: 'Popular',
  }
];
---

<Layout metadata={metadata}>
  <Hero2
    tagline="The Grand Opening"
    title='Is Your Website Helping You <br/><span class="text-accent">or Holding You Back?</span>'
    subtitle="An outdated website scares away customers. Whether you need a reform or a new build, we deliver a professional digital front door in just 4 days."
    actions={[{ variant: 'primary', text: 'View Pricing & Plans', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?w=611&h=405&auto=format&fit=crop', alt: 'Culinary Excellence' }}
  />
  
  <Content
    isReversed={false}
    title="Your Website Should Be an Engine, Not an Anchor."
    subtitle="Most websites in Japan are slow and outdated. We give you a world-class digital presence without the tech headaches."
    items={[
        { title: 'The Speed Problem', description: 'If your site is slow, customers leave. We make your site load instantly on any device.', icon: 'tabler:bolt' },
        { title: 'The Trust Problem', description: 'A sleek, modern design that builds instant trust with high-end travelers.', icon: 'tabler:shield-check' },
        { title: 'The Language Barrier', description: 'Sites that work perfectly in both Japanese and English, so you can welcome the world.', icon: 'tabler:language' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1628652337240-80d1ed549f47?w=611&h=405&auto=format&fit=crop', alt: 'Sushi' }}
  />

  <Pricing id="pricing" title="Simple, Flat Pricing" subtitle="Get a world-class website for one fixed fee." prices={pricingData} />

  <CallToAction title="About Hanei" subtitle="We use modern technology to ensure that the world can experience Japan's local culture—without the stress of the language barrier." />
</Layout>
