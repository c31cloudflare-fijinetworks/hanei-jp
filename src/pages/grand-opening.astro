---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import FeatureTable from '~/components/widgets/FeatureTable.astro';
const metadata = { title: 'Grand Opening | Web Design' };
const fullFeatureList = [{ title: 'High-Speed Edge Delivery' }, { title: 'Bilingual Navigation' }, { title: 'Google Maps' }, { title: 'Mobile-First Design' }, { title: 'SSL Security Encryption' }, { title: 'Contact form / Reservations form' }, { title: 'Native Copywriting' }, { title: 'Social Feed Integrations' }, { title: 'Image Optimization' }, { title: 'Modern Browser Compatibility' }, { title: 'Zero Downtime Migration' }, { title: 'Unlimited Revisions' }, { title: '1 Business Day Launch' }, { title: 'Professional CDN Hosting' }, { title: 'Auto-Backup Systems' }, { title: 'GDPR/Privacy Ready' }, { title: 'Strategic UX Design' }, { title: '60 days Tech Support' }];
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="Total Digital Transformation" 
    title='Is Your Website Helping You <br/><span class="text-accent">or Holding You Back?</span>' 
    subtitle="An outdated site scares away customers. We deliver a professional digital front door in just 4 days." 
    actions={[
      { variant: 'primary', text: 'Explore Grand Reform', href: '#reform' }, 
      { text: 'Explore Grand New', href: '#new', class: '!bg-green-600 !text-white !border-none hover:!bg-green-700 shadow-lg' }
    ]} 
    image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80', alt: 'Culinary' }} 
  />
  
  <!-- OPTION 1: REFORM -->
  <div id="reform" class="scroll-mt-20">
    <Content tagline="Option 1: Grand Reform" title="01. The Modern Aesthetic Facelift" subtitle="We refresh the soul of your design to match international luxury standards while preserving your existing content." items={[{ title: 'Fresh Look', description: 'Built for high-end perception.', icon: 'tabler:palette' }]} image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?auto=format&fit=crop&w=1200&q=80', alt: 'Design' }} classes={{ container: 'pb-0 md:pb-0' }} />
    <Content isReversed={true} isAfterContent={true} title="Preserving Heritage, Elevating Impact" subtitle="We respect the work you've already done. Our reform process takes your existing text and history and wraps it in a world-class interface. This ensures you maintain your brand identity while finally looking as professional as your physical business." image={{ src: 'https://images.unsplash.com/photo-1667560615919-837fe9001e58?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={false} isAfterContent={true} title="Technical Performance Boost" subtitle="A design facelift is only half the battle. We migrate your reformed site to our high-speed edge network, ensuring that your new look loads instantly on any roaming data connection. Speed is the silent signal of luxury and reliability." image={{ src: 'https://images.unsplash.com/photo-1749104953222-9d6ed76e4bf0?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <hr class="border-t dark:border-slate-800 my-4" />

  <!-- OPTION 2: NEW -->
  <div id="new" class="scroll-mt-20">
    <Content isReversed={true} tagline="Option 2: Grand NEW" title="02. Total Digital Blueprint" subtitle="A complete from-scratch development of your digital ecosystem. We build your new flagship website with elite infrastructure designed for maximum conversion from day one." items={[{ title: 'Brand New Build', description: 'Custom engineered for your specific niche.', icon: 'tabler:rocket' }]} image={{ src: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80', alt: 'New Structure' }} classes={{ container: 'pb-0 md:pb-0' }} />
    <Content isReversed={false} isAfterContent={true} title="Architected for High Conversion" subtitle="When we build from zero, we start with a blueprint for growth. We design your navigation, contact flows, and booking integrations using proprietary conversion logic. Every pixel is placed with the goal of turning a visitor into a high-value customer." image={{ src: 'https://images.unsplash.com/photo-1644072267093-cbbfdb74303c?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} isAfterContent={true} title="Elite Data Infrastructure" subtitle="Your new flagship is built on the same serverless stack used by world-class tech firms. This provides your business with an unshakeable foundation: sub-second load times, military-grade SSL security, and an automated SEO architecture that ensures you dominate local search results." image={{ src: 'https://images.unsplash.com/photo-1648977555232-99b5a8c8c897?w=1200&auto=format&fit=crop&q=60' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <!-- DEMO PORTFOLIO SECTION -->
  <div class="py-8 bg-slate-50 dark:bg-transparent border-y dark:border-slate-800 my-10">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold font-heading mb-2">Portfolio Demonstrations</h2>
        <p class="text-lg text-muted">Explore the level of quality we deliver for every industry.</p>
    </div>
  </div>

  <div class="space-y-4">
    <Content isReversed={false} title="Portfolio Demo: ZenPod Tokyo" subtitle="Explore our luxury capsule hotel concept to see how we blend premium Japanese aesthetics with high-converting digital flows." callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/capsule-hotel' }} image={{ src: 'https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200', alt: 'Hotel' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} title="Portfolio Demo: Azabu Medical" subtitle="A sophisticated medical facility demonstration. Highlights specialized care, physician profiles, and a patient-centric appointment workflow." callToAction={{ variant: 'primary', text: 'Launch Medical Demo', href: '/demos/azabu-medical' }} image={{ src: 'https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200', alt: 'Medical' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={false} title="Portfolio Demo: GINZA KAIZEN" subtitle="A premium hair artistry sanctuary in Ginza. Highlights meticulous Japanese styling, English-speaking staff, and high-conversion booking flows." callToAction={{ variant: 'primary', text: 'Launch Beauty Demo', href: '/demos/ginza-kaizen' }} image={{ src: 'https://images.unsplash.com/photo-1560869713-7d0a29430803?w=1200', alt: 'Beauty' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={true} title="Portfolio Demo: Tokyo Locker & Storage" subtitle="A premium luggage solutions website. See how we present tiered security services, house rules, and contactless payment flows in a high-converting format." callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/tokyo-locker-storage-premium-luggage-solutions' }} image={{ src: 'https://images.unsplash.com/photo-1618438502398-195e47778d6c?w=1200', alt: 'Locker Solution' }} classes={{ container: 'py-8 md:py-12' }} />
    <Content isReversed={false} title="Portfolio Demo: Kagari Izakaya & Grill" subtitle="A luxury Shinjuku gastronomy destination. Featuring integrated reservation workflows, seasonal omakase menus, and high-contrast night-mode aesthetics." callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/kagari-izakaya-grill-shinjuku-tokyo-gastronomy' }} image={{ src: 'https://images.unsplash.com/photo-1617870314635-fc819547ec11?w=1200', alt: 'Izakaya Grill' }} classes={{ container: 'py-8 md:py-12' }} />
  </div>

  <FeatureTable title="Grand Reform & Grand NEW Packages" subtitle="Elite standard features included in every professional development project." items={fullFeatureList} />
</Layout>
