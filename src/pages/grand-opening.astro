---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { title: 'Grand Opening | Hanei JP' };
const pricingData = [
  { title: 'Grand Reform', price: '78,800', period: 'Up to 10 pages', items: [{ description: 'Modern Clean Design' }, { description: '100% Mobile Friendly' }, { description: 'Fix Speed Issues' }, { description: '4-Day Turnaround' }], callToAction: { target: '_self', text: 'Start Reform', href: '/contact', variant: 'primary' } },
  { title: 'Grand New', price: '78,800', period: 'Up to 10 pages', items: [{ description: 'Bilingual Architecture' }, { description: 'Latest Tech Stack' }, { description: 'Luxury UX Design' }, { description: '4-Day Turnaround' }], callToAction: { target: '_self', text: 'Launch New', href: '/contact', variant: 'primary' }, hasRibbon: true, ribbonTitle: 'Popular' }
];
---
<Layout metadata={metadata}>
  <Hero2 tagline="Total Transformation" title='Is Your Website Helping You <br/><span class="text-accent">or Holding You Back?</span>' subtitle="Don't let a slow, old design hurt your business. We deliver a professional digital front door in just 4 days." actions={[{ variant: 'primary', text: 'View Pricing', href: '#pricing' }]} image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?w=611&h=405&auto=format&fit=crop', alt: 'Header' }} />
  
  <Content isReversed={false} title="01. The Speed Performance Fix" subtitle="Slow sites lose customers instantly. We make your site load in under 1 second on any global network." items={[{ title: 'Edge Delivery', description: 'Optimized for international visitors.', icon: 'tabler:bolt' }]} image={{ src: 'https://images.unsplash.com/photo-1628652337240-80d1ed549f47?w=611&h=405&auto=format&fit=crop', alt: 'Speed' }} />
  
  <Content isReversed={true} title="02. 48-Hour Weekend Delivery" subtitle="No more waiting months for agencies. We reboot your entire digital presence over a single weekend." items={[{ title: 'Record Velocity', description: 'Order Friday, launch Monday.', icon: 'tabler:clock' }]} image={{ src: 'https://images.unsplash.com/photo-1626379907753-406934326e2c?w=611&h=405&auto=format&fit=crop', alt: 'Delivery' }} />
  
  <Content isReversed={false} title="03. Mobile-First Optimization" subtitle="Your guests are on the move. We ensure your site looks and works perfectly on every smartphone screen size." items={[{ title: 'Responsive Design', description: 'Luxury UX tailored for the hand.', icon: 'tabler:device-mobile' }]} image={{ src: 'https://images.unsplash.com/photo-1691484466261-cb7557646ffc?w=611&h=405&auto=format&fit=crop', alt: 'Mobile' }} />
  
  <Content isReversed={true} title="04. Conversion Focused Copy" subtitle="We rewrite your value proposition using native psychological triggers that turn visitors into confirmed bookings." items={[{ title: 'Strategic Writing', description: 'Not just translation—authority.', icon: 'tabler:target' }]} image={{ src: 'https://images.unsplash.com/photo-1512100356956-c1b47f4b1465?w=611&h=405&auto=format&fit=crop', alt: 'Target' }} />

  <Pricing id="pricing" title="Simple, Flat Pricing" prices={pricingData} />
</Layout>
