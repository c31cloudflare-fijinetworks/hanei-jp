---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import FeatureTable from '~/components/widgets/FeatureTable.astro';
const metadata = { title: 'Grand Opening | Web Design' };
const fullFeatureList = [{ title: 'High-Speed Edge Delivery' }, { title: 'Bilingual Navigation' }, { title: 'Google Maps SEO' }, { title: 'Mobile-First Design' }, { title: 'SSL Security Encryption' }, { title: 'One-Click Contact Flow' }, { title: 'Custom QR Code Kit' }, { title: 'Native Copywriting' }, { title: 'Social Integration' }, { title: 'Image Optimization' }, { title: 'Browser Compatibility' }, { title: 'Zero Downtime Migration' }, { title: 'Unlimited Revisions' }, { title: '48-Hour Weekend Launch' }, { title: 'Cloudflare CDN Hosting' }, { title: 'Auto-Backup Systems' }, { title: 'GDPR/Privacy Ready' }, { title: 'Strategic UX Design' }, { title: 'Local Authority Ranking' }, { title: 'Lifetime Tech Support' }];
---
<Layout metadata={metadata}>
  <Hero2 tagline="Total Digital Transformation" title='Is Your Website Helping You <br/><span class="text-accent">or Holding You Back?</span>' subtitle="An outdated site scares away customers. We deliver a professional digital front door in just 4 days." actions={[{ variant: 'primary', text: 'Explore Grand Reform', href: '#reform' }, { variant: 'secondary', text: 'Explore Grand New', href: '#new' }]} image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80', alt: 'Culinary' }} />
  
  <Content isReversed={false} tagline="Experience Excellence" title="Live Flagship: ZenPod Tokyo" subtitle="Explore our luxury capsule hotel concept to see how we blend premium Japanese aesthetics with high-converting digital flows." callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/capsule-hotel' }} image={{ src: 'https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200', alt: 'Hotel' }} />
  
  <Content isReversed={true} title="Live Flagship: Azabu Medical" subtitle="A sophisticated medical facility demonstration. Highlights specialized care, physician profiles, and a patient-centric appointment workflow." callToAction={{ variant: 'primary', text: 'Launch Medical Demo', href: '/demos/azabu-medical' }} image={{ src: 'https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200', alt: 'Medical' }} />
  
  <Content isReversed={false} title="Live Flagship: Omotesando Dental" subtitle="A premium clinic design optimized for international patients. Features bilingual trust signals and advanced medical booking flows." callToAction={{ variant: 'secondary', text: 'Launch Dental Demo', href: '/demos/omotesando-dental' }} image={{ src: 'https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1200', alt: 'Dental' }} />

  <Content isReversed={true} title="Live Flagship: GINZA KAIZEN" subtitle="A premium hair artistry sanctuary in Ginza. Highlights meticulous Japanese styling, English-speaking staff, and high-conversion booking flows." callToAction={{ variant: 'primary', text: 'Launch Beauty Demo', href: '/demos/ginza-kaizen' }} image={{ src: 'https://images.unsplash.com/photo-1560869713-7d0a29430803?w=1200', alt: 'Beauty' }} />

  <Content isReversed={false} title="Live Flagship: Zen Relocations Japan" subtitle="A premium expat-focused moving service demonstration. Showcases high-precision Japanese logistics, meticulous packing standards, and English-speaking support." callToAction={{ variant: 'primary', text: 'Launch Logistics Demo', href: '/demos/zen-relocations-japan-relocations' }} image={{ src: 'https://images.unsplash.com/photo-1722487631997-cf1e0f92c2c4?w=1200', alt: 'Logistics' }} />

  <Content isReversed={true} title="Live Flagship: Kissa & Co. Osaka" subtitle="An elegant demonstration of the modern Kissaten experience. Features seasonal coffee menus, high-resolution visual storytelling, and seamless table booking workflows." callToAction={{ variant: 'primary', text: 'Launch Roastery Demo', href: '/demos/kissa-co-osaka' }} image={{ src: 'https://images.unsplash.com/photo-1453614512568-c4024d13c247?w=1200', alt: 'Roastery' }} />

  <Content isReversed={false} title="Live Flagship: Mizu no Kokoro" subtitle="A premium wellness sanctuary demonstration. Showcases traditional Japanese bathing rituals, modern aesthetic design, and an integrated reservation system for international guests." callToAction={{ variant: 'primary', text: 'Launch Wellness Demo', href: '/demos/mizu-no-kokoro-luxury-sento-wellness-osaka' }} image={{ src: 'https://images.unsplash.com/photo-1764057146162-64aaea28494a?w=1200', alt: 'Wellness' }} />

  <Content isReversed={true} title="Live Flagship: TAKUMI PRECISION TOKYO" subtitle="A high-fidelity industrial engineering demonstration. Showcases precision manufacturing, rapid prototyping, and automated assembly solutions with integrated RFQ workflows for global partners." callToAction={{ variant: 'primary', text: 'Launch Industrial Demo', href: '/demos/takumi-precision-tokyo-engineering-the-future' }} image={{ src: 'https://images.unsplash.com/photo-1757912666361-8c226b7279b9?w=1200', alt: 'Industrial' }} />

  <Content isReversed={false} title="Live Flagship: SHIKA-AN NARA" subtitle="A luxury heritage guesthouse demonstration set in Nara Park. Features traditional architecture, curated guest experiences, and seamless bilingual booking flows for high-end international travelers." callToAction={{ variant: 'primary', text: 'Launch Heritage Demo', href: '/demos/shika-an-nara-luxury-heritage-guesthouse' }} image={{ src: 'https://images.unsplash.com/photo-1530708780517-cc640cf05561?w=1200', alt: 'Heritage' }} />
  
  <div id="reform" class="scroll-mt-20"><Content tagline="Option 1: Grand Reform" title="01. The Modern Aesthetic Facelift" subtitle="We refresh the soul of your design to match international luxury standards." items={[{ title: 'Fresh Look', description: 'Built for high-end perception.', icon: 'tabler:palette' }]} image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?auto=format&fit=crop&w=1200&q=80', alt: 'Design' }} /><FeatureTable title="Standard Package" subtitle="Fixed price. No extras." items={fullFeatureList} /></div>
</Layout>
