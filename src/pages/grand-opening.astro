---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import FeatureTable from '~/components/widgets/FeatureTable.astro';
const metadata = { title: 'Grand Opening | Web Design' };
const fullFeatureList = [{ title: 'High-Speed Edge Delivery' }, { title: 'Bilingual Navigation' }, { title: 'Google Maps SEO' }, { title: 'Mobile-First Design' }, { title: 'SSL Security Encryption' }, { title: 'One-Click Contact Flow' }, { title: 'Custom QR Code Kit' }, { title: 'Native Copywriting' }, { title: 'Social Integration' }, { title: 'Image Optimization' }, { title: 'Browser Compatibility' }, { title: 'Zero Downtime Migration' }, { title: 'Unlimited Revisions' }, { title: '48-Hour Weekend Launch' }, { title: 'Cloudflare CDN Hosting' }, { title: 'Auto-Backup Systems' }, { title: 'GDPR/Privacy Ready' }, { title: 'Strategic UX Design' }, { title: 'Local Authority Ranking' }, { title: 'Lifetime Tech Support' }];
---
<Layout metadata={metadata}>
  <Hero2 tagline="Total Digital Transformation" title='Is Your Website Helping You <br/><span class="text-accent">or Holding You Back?</span>' subtitle="An outdated site scares away customers. We deliver a professional digital front door in just 4 days." actions={[{ variant: 'primary', text: 'Explore Grand Reform', href: '#reform' }, { variant: 'secondary', text: 'Explore Grand New', href: '#new' }]} image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80', alt: 'Culinary' }} />
  <Content isReversed={false} tagline="Experience Excellence" title="Live Flagship: ZenPod Tokyo" subtitle="Explore our luxury capsule hotel concept to see how we blend premium Japanese aesthetics with high-converting digital flows." callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/capsule-hotel' }} image={{ src: 'https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200', alt: 'Hotel' }} />
  <Content isReversed={true} title="Live Flagship: Zenith Relocations Japan" subtitle="A high-performance moving and logistics demonstration. Features detailed quote calculators and specialized Japanese-standard care." callToAction={{ variant: 'primary', text: 'Launch Moving Demo', href: '/demos/zenith-relocations-japan' }} image={{ src: 'https://images.unsplash.com/photo-1722487631997-cf1e0f92c2c4?w=1200', alt: 'Moving' }} />
  <Content isReversed={false} title="Live Flagship: Azabu Medical" subtitle="A sophisticated medical facility demonstration. Highlights specialized care, physician profiles, and a patient-centric appointment workflow." callToAction={{ variant: 'secondary', text: 'Launch Medical Demo', href: '/demos/azabu-medical' }} image={{ src: 'https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200', alt: 'Medical' }} />
  <Content isReversed={true} title="Live Flagship: Omotesando Dental" subtitle="A premium clinic design optimized for international patients. Features bilingual trust signals and advanced medical booking flows." callToAction={{ variant: 'secondary', text: 'Launch Dental Demo', href: '/demos/omotesando-dental' }} image={{ src: 'https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1200', alt: 'Dental' }} />
  <div id="reform" class="scroll-mt-20"><Content tagline="Option 1: Grand Reform" title="01. The Modern Aesthetic Facelift" subtitle="We refresh the soul of your design to match international luxury standards." items={[{ title: 'Fresh Look', description: 'Built for high-end perception.', icon: 'tabler:palette' }]} image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?auto=format&fit=crop&w=1200&q=80', alt: 'Design' }} /><FeatureTable title="Standard Package" subtitle="Fixed price. No extras." items={fullFeatureList} /></div>
</Layout>
