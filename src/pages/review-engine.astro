---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'The Review Engine | Hanei JP', 
  description: 'Turn happy customers into your best marketing tool. Automated 5-star review collection for Japanese businesses.',
};

const pricingData = {
  title: 'Review Engine Setup',
  subtitle: 'Build a reputation that attracts more customers.',
  price: '22,500',
  period: 'One-time payment',
  items: [
    { description: 'Branded Review Collection Page' },
    { description: 'Direct "Post to Google" Shortcut' },
    { description: 'Live Review Widget for your website' },
    { description: 'Same-day delivery (Order by 12:00)' },
    { description: 'Unlimited design revisions' },
  ],
  callToAction: { target: '_self', text: 'Get Started Now', href: '/contact', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="Your Reputation, Automated"
    title='Turn a "Thank You" <br/><span class="text-accent">into a 5-Star Review.</span>'
    subtitle="Stop letting happy customers leave without saying a word online. We make it effortless for them to praise your business on Google and your own website."
    actions={[{ variant: 'primary', text: 'Get Your Review Engine', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1565427167526-c9d39f300959?w=500&auto=format&fit=crop&q=60', alt: '5 Star Rating' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The "Silent Customer" Problem</h3>
      <p class="text-lg text-muted mb-4">
        You provide excellent service. Your customers smile and say "Arigato." But when potential clients search for you on Google, your profile is quiet—or worse, one unhappy person has brought down your whole score.
      </p>
      <p class="text-lg text-muted mb-6">
        Most happy customers <strong>want</strong> to help you, but they find it too difficult to search for your business while they are busy. We remove the friction.
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Hanei’s Review Engine makes leaving a 5-star review as easy as scanning a QR code.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1556740734-7f9a2b7a0f4d?w=500&auto=format&fit=crop&q=60" alt="Happy Customer" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: THE SOLUTION -->
  <Content
    isReversed={true}
    items={[
        { 
          title: 'Custom Branded Page', 
          description: 'A professional page that matches your business style. No messy forms—just a clean, inviting space for customers to share their feedback.', 
          icon: 'tabler:palette' 
        },
        { 
          title: 'One-Tap Google Posting', 
          description: 'We send your happy guests directly to your Google profile so they can post that 5-star rating instantly.', 
          icon: 'tabler:brand-google' 
        },
        { 
          title: 'Live Website Widget', 
          description: "Display your best reviews on your website automatically. Show every visitor that you are a business they can trust.", 
          icon: 'tabler:refresh' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Professional Reputation <br/>Management</h3>
      <p class="text-lg text-muted">
        We handle all the technical setup. You just display the QR code. Your reputation grows while you focus on serving your customers.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1534670007418-fbb7f6cf32c3?w=500&auto=format&fit=crop&q=60" alt="Smartphone Review" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- STEPS -->
  <Steps2
    title="Ready in Less Than 24 Hours"
    subtitle="Fast, simple, and permanent. Here is how it works."
    items={[
      { title: 'Step 1: Simple Order', description: 'Tell us your business name and send your logo. We handle the rest.', icon: 'tabler:shopping-cart' },
      { title: 'Step 2: Same-Day Build', description: 'Order by noon, and your engine is ready by tonight. Otherwise, it is ready tomorrow.', icon: 'tabler:bolt' },
      { title: 'Step 3: Collect Reviews', description: 'Display your QR code on your counter and watch your 5-star ratings grow.', icon: 'tabler:star' },
    ]}
  />

  <!-- FEATURES -->
  <Features2
    title="The Hanei Promise"
    subtitle="We don't stop until your review engine is perfect."
    columns={3}
    items={[
      { title: 'Same-Day Turnaround', description: 'Order by 12:00 PM for today delivery. Otherwise, guaranteed next-day delivery.', icon: 'tabler:clock' },
      { title: 'Unlimited Revisions', description: 'We will revise the design until you are 100% fully satisfied with the result.', icon: 'tabler:thumb-up' },
      { title: 'Fixed Price ¥22,500', description: 'One simple payment. No hidden fees or surprise monthly charges.', icon: 'tabler:coin-yen' },
      { title: 'Branded for You', description: 'A custom-built page that matches your brand, not a generic template.', icon: 'tabler:brush' },
      { title: 'Google SEO Boost', description: 'Drives real, local reviews to Google to improve your search ranking.', icon: 'tabler:external-link' },
      { title: 'Live Trust Widget', description: 'Display your best reviews on your website automatically to build instant trust.', icon: 'tabler:device-laptop' },
    ]}
  />

  <!-- PRICING -->
  <Pricing 
    id="pricing"
    title="Simple, Transparent Pricing" 
    prices={[pricingData]} 
  />

  <!-- ABOUT HANEI -->
  <CallToAction
    title="About Hanei"
    subtitle="Hanei is dedicated to empowering Japanese local businesses. We believe that Japan’s local culture is its greatest asset, and we use modern technology to ensure that the world can experience it—without the stress of the language barrier."
    actions={[]}
  />
</Layout>
