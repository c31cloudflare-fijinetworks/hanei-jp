---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import { lifetimeDealJp } from '~/data/pricingData';

const metadata = { title: '料金プラン | English Support Japan' };
---
<Layout metadata={metadata}>
  <HeroText tagline="Pricing" title="プロフェッショナルな拠点を最短即日で。" />
  <Pricing prices={[lifetimeDealJp]} />
</Layout>
