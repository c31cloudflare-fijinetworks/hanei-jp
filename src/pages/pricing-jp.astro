---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features3 from '~/components/widgets/Features3.astro';
import { lifetimeDealJp } from '~/data/pricingData';

const metadata = { 
  title: '料金プラン | エリート・デジタル資産の確保', 
  description: '月額費用ゼロ。貴社のGoogleビジネスプロフィールやSNSを、ラグジュアリーなポートフォリオへと変貌させます。' 
};
---
<Layout metadata={metadata}>
  <HeroText 
    tagline="プロフェッショナル・スタンダード"
    title="貴社の「美学」を体現する場所を、最短即日で。" 
    subtitle="単なるリンクではありません。貴社のデジタルの旗艦店です。洗練された専用URL（hanei.jp/yourname）を所有し、SNSのプロフィールやGoogleマップの「ウェブサイト」ボタンを、高付加価値な体験へと進化させます。サービスの詳細提示からInstagramの自動同期まで、プロフェッショナルに管理されたプレゼンスで顧客を魅了します。"
  />

  <Features2
    title='すべてのプランに含まれる「インバウンド対応スイート」：'
    subtitle="インバウンド客を確実に獲得するための必須インフラが標準で付属しています。"
    columns={3}
    items={[
      { title: 'GoogleマップSEO (MEO)', description: '「近くの〇〇」と英語で検索された際に上位表示させるための、1ページの完全英語SEO設定。', icon: 'tabler:circle-check' },
      { title: 'カスタムQRレビュー素材', description: 'Googleでの星5つ評価を促進するための、卓上設置用PDFデータ。', icon: 'tabler:circle-check' },
      { title: '入店ガイド・ランディングページ', description: '禁煙ルール、お通し、靴を脱ぐ習慣などを説明し、外国人客の「入店前の不安」を解消するカスタムコンテンツ。', icon: 'tabler:circle-check' },
      { title: 'プロの英語コピーライティング', description: "単なる直訳ではなく、成約につながる魅力的な英文ライティング。", icon: 'tabler:circle-check' },
      { title: '超高速ページ配信', description: 'ローミング通信を利用するモバイルユーザー向けに最適化された、瞬時のページ読み込み。', icon: 'tabler:circle-check' },
      { title: '最短即日のスピード公開', description: '正午までのご注文で、本日中に貴社のウェブサイトを稼働させます！', icon: 'tabler:bolt' },
    ]}
  />

  <Pricing prices={[lifetimeDealJp]} />

  <Features3
    title="すべての接点を格上げする"
    subtitle="現場での努力と、オンライン上のプレゼンスをシームレスに繋ぎます。"
    columns={3}
    items={[
      { 
        title: 'SNSプロフィールの変革', 
        description: '汎用的なリンクツールは卒業しましょう。Hanei JPのURLは、顧客を貴社の作品や予約リンクに集中させる、ブランディングされた体験を提供します。', 
        icon: 'tabler:link' 
      },
      { 
        title: 'Googleビジネスの権威性', 
        description: 'Googleプロフィールの「ウェブサイト」ボタンは最も価値のある場所です。そこを専用ページに置き換えることで、圧倒的な信頼感を顧客に与えます。', 
        icon: 'tabler:brand-google' 
      },
      { 
        title: '詳細なサービス提示', 
        description: '汎用アプリでは貴社のこだわりを隠してしまいます。特化型のカラーワークや特別なコース、スタイリングパッケージを美しく詳細に伝えます。', 
        icon: 'tabler:clipboard-list' 
      },
      { 
        title: 'ライブ・ポートフォリオ同期', 
        description: 'Instagramの最新投稿を自動的にサイトへ反映。手間をかけずに、常に最新の作品集を維持できます。', 
        icon: 'tabler:brand-instagram' 
      },
      { 
        title: '一括ライセンス（買い切り）', 
        description: '月額のサブスクリプション費用はかかりません。一度の投資で、デジタルの拠点を永久に所有できます。ホスティングやセキュリティ、アップデートは私たちが対応します。', 
        icon: 'tabler:coin' 
      },
      { 
        title: 'ホワイトグローブ・デリバリー', 
        description: '私たちは貴社のデジタルパートナーです。URLの設定からデザインの調整まで、すべての技術的な重労働を代行し、即日お届けします。', 
        icon: 'tabler:headset' 
      },
    ]}
  />

  <FAQs
    title="料金と導入に関する質問"
    items={[
        { 
          title: '「即日セットアップ」の流れは？', 
          description: 'ご注文後、簡単なフォームをお送りします。そちらを返信いただければ、当日中に貴社のエリート・デジタル拠点を公開します。', 
          icon: 'tabler:bolt' 
        },
        { 
          title: '独自のドメイン（.com等）は使えますか？', 
          description: 'はい。無料のHanei JP専用URLのほか、お客様がお持ちのドメインや新規ドメインでの運用も完全にサポートします。', 
          icon: 'tabler:world' 
        },
        { 
          title: '本当に月額費用はゼロですか？', 
          description: 'はい。Hanei JPは一括投資型です。制作、デザイン、永続的なホスティングを含んだ料金のため、月々の請求はありません。', 
          icon: 'tabler:coin' 
        },
        { 
          title: 'メニュー内容が変わった場合は？', 
          description: '私たちのサポートチームへご連絡ください。情報の更新はライフタイム・サポートの一環として迅速に対応いたします。', 
          icon: 'tabler:settings' 
        },
    ]}
  />
</Layout>
