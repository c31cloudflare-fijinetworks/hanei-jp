---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'レビューエンジン | 口コミ収集・Googleマップ対策 | Hanei JP', 
  description: 'お客様の「ありがとう」を「星5つの評価」に変える。Googleマップの口コミを自動で増やし、信頼を形にするシステム。',
};

const pricingData = {
  title: 'レビューエンジン導入プラン',
  subtitle: '信頼を築き、新しいお客様を呼び込む最強のツール。',
  price: '22,500',
  period: '一括払い（追加費用なし）',
  items: [
    { description: 'お店専用のレビュー収集ページ制作' },
    { description: 'Googleマップ直接投稿機能' },
    { description: '自社サイトへの口コミ自動表示機能' },
    { description: '当日納品（正午までの注文）' },
    { description: 'ご満足いただけるまで修正無制限' },
  ],
  callToAction: { target: '_self', text: '今すぐ導入する', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="口コミ収集を、もっとスマートに。"
    title='お客様の「ありがとう」を、<br/><span class="text-accent">「星5つの評価」に変えませんか？</span>'
    subtitle="満足したお客様が何も書かずに帰ってしまうのは、大きな損失です。スマホをかざすだけで、簡単にGoogleや自社サイトへ口コミを投稿できる仕組みを提供します。"
    actions={[{ variant: 'primary', text: 'レビューエンジンを導入する', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1565427167526-c9d39f300959?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTl8fHJldmlld3xlbnwwfHwwfHx8Mg%3D%3D', alt: '5つ星評価' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">「満足しているお客様」ほど、<br/>実は何も言わずに帰っています。</h3>
      <p class="text-lg text-muted mb-4">
        最高のサービスを提供し、お客様も笑顔で「ありがとう」と言ってくれる。しかし、ネットで検索すると口コミが少ない…あるいは、一部の不満な声だけが目立ってしまっていませんか？
      </p>
      <p class="text-lg text-muted mb-6">
        多くのお客様は「応援したい」と思っていますが、自分で検索して投稿するのは手間がかかります。その「手間」を私たちがゼロにします。
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Haneiのレビューエンジンは、QRコードを読み取るだけで、即座に評価を投稿できる仕組みです。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1735970336839-810a54623b42?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTN8fGphcGFuZXNlJTIwY2FmZXxlbnwwfHwwfHx8Mg%3D%3D" alt="カフェの風景" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: THE SOLUTION -->
  <Content
    isReversed={true}
    items={[
        { 
          title: 'お店専用のデザイン', 
          description: 'お店の雰囲気に合わせた、プロ仕様のレビューページ。お客様が迷わず直感的に感想を伝えられる設計です。', 
          icon: 'tabler:palette' 
        },
        { 
          title: 'Googleマップへ直結', 
          description: 'ワンタップでGoogleの投稿画面へ。検索順位アップに欠かせない「新鮮な口コミ」を効率よく集めます。', 
          icon: 'tabler:brand-google' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">プロフェッショナルな<br/>評判管理を自動化</h3>
      <p class="text-lg text-muted">
        難しい設定はすべてお任せください。あなたは店頭にQRコードを置くだけ。接客に集中している間に、お店の資産となる高評価が積み上がっていきます。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1480796927426-f609979314bd?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8amFwYW5lc2UlMjBjYWZlfGVufDB8fDB8fHwy" alt="日本のカフェでの接客" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 3: WIDGET -->
  <Content
    isReversed={false}
    items={[
        { 
          title: 'ホームページに自動表示', 
          description: "届いた高評価を自社サイトにリアルタイムで表示。初めての訪問者に、今すぐ安心感を与えます。", 
          icon: 'tabler:refresh' 
        },
        { 
          title: 'ストレスフリーな体験', 
          description: "検索不要。ログイン不要。スキャンして、タップする。それだけで完了です。", 
          icon: 'tabler:qrcode' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">リアルタイムの証明で、<br/>信頼を最大化する</h3>
      <p class="text-lg text-muted mb-6">
        あなたのホームページを、常に「新しいお客様の声」で溢れる活気ある場所に変えましょう。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1715617634656-0ca1a251bde3?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mzh8fGphcGFuZXNlJTIwY2FmZXxlbnwwfHwwfHx8Mg%3D%3D" alt="カフェの内装" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- STEPS -->
  <Steps2
    title="最短24時間で運用開始"
    subtitle="導入に時間はかかりません。私たちが即座に構築します。"
    items={[
      { title: 'STEP 1: かんたん注文', description: '店名とロゴを送るだけ。お店専用のシステムを構築します。', icon: 'tabler:shopping-cart' },
      { title: 'STEP 2: 最短当日納品', description: '正午までの注文で即日、それ以降でも翌日には完成。', icon: 'tabler:bolt' },
      { title: 'STEP 3: 口コミを集める', description: 'QRコードを置くだけ。評価が増える喜びを実感してください。', icon: 'tabler:star' },
    ]}
    image={{ 
      src: 'https://images.unsplash.com/photo-1605256107836-47206b30d200?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTA3fHxqYXBhbmVzZSUyMGNhZmV8ZW58MHx8MHx8fDI%3D', 
      alt: 'バリスタ',
    }}
  />

  <!-- FEATURES -->
  <Features2
    title="Haneiの安心約束"
    subtitle="オーナー様にご満足いただけるまで、妥協しません。"
    columns={3}
    items={[
      { title: '当日スピード納品', description: '正午までの注文で即日、それ以降でも翌日には確実に納品。', icon: 'tabler:clock' },
      { title: '修正は何度でも無料', description: 'デザインや内容が100%気に入るまで、無制限に調整。', icon: 'tabler:thumb-up' },
      { title: '明朗会計 ¥22,500', description: '一括払いのみ。隠れた費用や月額コストはゼロ。', icon: 'tabler:coin-yen' },
      { title: 'お店専用デザイン', description: 'テンプレートではない、お店のブランドに合うデザイン。', icon: 'tabler:brush' },
      { title: 'Google MEO対策', description: 'Googleマップの順位向上に直結する口コミ収集を支援。', icon: 'tabler:external-link' },
      { title: 'Web自動表示', description: '自社サイトに高評価を自動表示。信頼をその場で証明。', icon: 'tabler:device-laptop' },
    ]}
  />

  <!-- TOURIST READY SUITE -->
  <Features2
    title='すべてのプランに含まれる「インバウンド対応スイート」'
    subtitle="インバウンド集客を即座に開始するための必須インフラが標準で付属しています。"
    columns={3}
    items={[
      { title: 'GoogleマップSEO（MEO）', description: '外国人観光客が「近くの〇〇」と検索した際に上位表示させる、1ページの完全英語SEO設定。', icon: 'tabler:circle-check' },
      { title: 'カスタムQRレビューPOP', description: '卓上に置いてGoogleの星5つレビューを促進する、印刷用PDFデータ。', icon: 'tabler:circle-check' },
      { title: '「How-To」ランディングページ', description: '禁煙、お通し、靴を脱ぐルールなどを説明し、入店前の不安を解消するカスタムコンテンツ。', icon: 'tabler:circle-check' },
      { title: 'プロの英語コピーライティング', description: '単なる翻訳ではなく、予約・来店につながる魅力的なビジネス説明文を執筆。', icon: 'tabler:circle-check' },
      { title: '超高速ページ配信ネットワーク', description: 'ローミング通信を利用するモバイルユーザー向けに最適化された高速表示。', icon: 'tabler:circle-check' },
      { title: '最短即日の超高速デプロイ', description: '午前中のご注文で、本日中にWebサイトを公開・稼働させます！', icon: 'tabler:bolt' },
    ]}
  />

  <!-- PRICING -->
  <Pricing 
    id="pricing"
    title="価格のご案内" 
    prices={[pricingData]} 
  />

  <!-- ABOUT HANEI -->
  
  
  <CallToAction title="About Hanei" subtitle="Haneiは、日本の地域ビジネスを支援することに全力を注いでいます。私たちは、日本の地域文化こそが最大の資産であると信じています。テクノロジーを活用することで、言葉の壁によるストレスを感じることなく、世界中の人々がその素晴らしさを体験できる未来を目指しています。" />
</Layout>
