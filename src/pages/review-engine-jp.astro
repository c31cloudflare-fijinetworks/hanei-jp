---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'レビューエンジン | 口コミ収集・Googleマップ対策 | Hanei JP', 
  description: '「ありがとう」を「星5つ」の評価に変える。Googleの口コミを自動で増やし、信頼を形にするシステムを構築します。',
};

const pricingData = {
  title: 'レビューエンジン導入プラン',
  subtitle: '信頼を築き、新しいお客様を呼び込む最強のツール。',
  price: '22,500',
  period: '一括払い（追加費用なし）',
  items: [
    { description: 'お店専用のレビュー収集ページ制作' },
    { description: 'Googleマップ直接投稿機能' },
    { description: '自社サイトへの口コミ自動表示機能' },
    { description: '当日納品（正午までの注文）' },
    { description: 'ご満足いただけるまで修正無制限' },
  ],
  callToAction: { target: '_self', text: '今すぐ導入する', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="口コミ収集を、もっとスマートに。"
    title='お客様の「ありがとう」を、<br/><span class="text-accent">「星5つの評価」に変えませんか？</span>'
    subtitle="「満足した」と言ってくださるお客様が、何も書かずに帰ってしまうのはもったいない。スマホをかざすだけで、簡単にGoogleや自社サイトへ口コミを投稿できる仕組みを提供します。"
    actions={[{ variant: 'primary', text: 'レビューエンジンを導入する', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1565427167526-c9d39f300959?w=500&auto=format&fit=crop&q=60', alt: '5つ星評価' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">「満足しているお客様」は、<br/>実は何も言わずに帰っています。</h3>
      <p class="text-lg text-muted mb-4">
        最高のサービスを提供し、お客様も笑顔で「ありがとう」と言ってくれる。しかし、ネットで検索すると口コミが少ない…あるいは、一部の不満な声だけが目立ってしまっていませんか？
      </p>
      <p class="text-lg text-muted mb-6">
        多くのお客様は「応援したい」と思っていますが、自分で検索して投稿するのは手間がかかります。その「手間」を私たちがゼロにします。
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Haneiのレビューエンジンは、QRコードを読み取るだけで、即座に評価を投稿できる仕組みです。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1556740734-7f9a2b7a0f4d?w=500&auto=format&fit=crop&q=60" alt="笑顔のお客様" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: THE SOLUTION -->
  <Content
    isReversed={true}
    items={[
        { 
          title: 'お店専用のレビューページ', 
          description: 'お店のロゴやカラーに合わせた、信頼感のある専用ページを制作。難しい入力フォームはなく、直感的に感想を伝えられます。', 
          icon: 'tabler:palette' 
        },
        { 
          title: 'Googleマップへ一押しで投稿', 
          description: 'お客様をGoogleの投稿画面へ直接案内。検索順位（MEO）アップに不可欠な「星5つの口コミ」を効率よく集めます。', 
          icon: 'tabler:brand-google' 
        },
        { 
          title: '自社サイトへの自動表示', 
          description: "集まった高評価を、あなたのホームページにも自動で表示。初めて訪れるお客様に、今すぐ安心感を伝えます。", 
          icon: 'tabler:refresh' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">プロフェッショナルな<br/>評判管理を自動化</h3>
      <p class="text-lg text-muted">
        難しい設定はすべてお任せください。あなたは店頭にQRコードを置くだくだけ。接客に集中している間に、お店の評判がどんどん積み上がっていきます。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1534670007418-fbb7f6cf32c3?w=500&auto=format&fit=crop&q=60" alt="スマホでレビュー" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- STEPS -->
  <Steps2
    title="導入は驚くほどスムーズです"
    subtitle="時間をかけずに、最高の結果をお届けします。"
    items={[
      { title: 'STEP 1: かんたん注文', description: '店名とロゴを送るだけ。私たちが最適なページを構築します。', icon: 'tabler:shopping-cart' },
      { title: 'STEP 2: 最短当日納品', description: '正午までの注文で、その日の夜までに完成。明日から運用を開始できます。', icon: 'tabler:bolt' },
      { title: 'STEP 3: 口コミを集める', description: 'QRコードをレジ横やテーブルに置くだけ。評価が増える喜びを実感してください。', icon: 'tabler:star' },
    ]}
  />

  <!-- FEATURES -->
  <Features2
    title="Haneiの安心約束"
    subtitle="オーナー様にご満足いただけるまで、妥協しません。"
    columns={3}
    items={[
      { title: '当日スピード納品', description: '正午までの注文で即日、それ以降でも翌日には確実に納品いたします。', icon: 'tabler:clock' },
      { title: '修正は何度でも無料', description: 'デザインや文言が100%気に入るまで、無制限に修正対応いたします。', icon: 'tabler:thumb-up' },
      { title: '明朗会計 ¥22,500', description: '一括払いのみ。隠れた手数料や月々のシステム利用料は一切ありません。', icon: 'tabler:coin-yen' },
      { title: 'お店に合わせたデザイン', description: 'テンプレートではなく、お店の雰囲気に合わせた専用デザインで制作。', icon: 'tabler:brush' },
      { title: 'Google MEO対策', description: 'Googleマップの順位向上に直結する、効果的な口コミ収集を支援します。', icon: 'tabler:external-link' },
      { title: 'Web表示ウィジェット', description: '自社サイトに最新の口コミを自動表示。信頼をその場で証明します。', icon: 'tabler:device-laptop' },
    ]}
  />

  <!-- PRICING -->
  <Pricing 
    id="pricing"
    title="価格のご案内" 
    prices={[pricingData]} 
  />

  <!-- ABOUT HANEI -->
  <CallToAction
    title="About Hanei"
    subtitle="Haneiは、日本の地域ビジネスを支援し、活力を与えることに尽力しています。私たちは「日本のローカル文化こそが最大の資産」であると信じています。言葉の壁によるストレスを感じることなく、世界中の人々にその素晴らしい体験を届けるために、最新のテクノロジーを活用してあなたのお店をサポートします。"
    actions={[]}
  />
</Layout>
