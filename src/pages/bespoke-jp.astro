---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { title: 'ビスポーク・ソリューション & 特殊案件のご相談 | Hanei JP' };

const jpLabels = {
    client_name: "お名前",
    company_name: "貴社名",
    email: "メールアドレス",
    phone: "電話番号",
    request_type: "ご依頼の種別",
    project_summary: "ご依頼内容の詳細",
    budget_range: "ご予算感",
    deadline: "希望納期",
    tech_pref: "ご希望の技術スタック",
    attachment: "資料添付",
    referral: "当社を知ったきっかけ",
    submit: "相談内容を送信する"
};

const jpOptions = {
    requests: ["独自システム開発", "API・外部連携", "レガシー移行", "特殊インタラクティブ", "その他"],
    budgets: ["100万円 - 300万円", "300万円 - 500万円", "500万円以上"],
    referrals: ["Google検索", "SNS", "知人の紹介", "その他"]
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="カスタムエンジニアリング"
    title='ビスポーク・ソリューション & <br/><span class="text-accent">特殊案件のご相談</span>'
    subtitle="私たちは、技術的な難題に挑戦することに情熱を注ぐエンジニア集団です。ブティックならではの柔軟な対応で、どこに頼めばいいか分からない案件も形にします。"
    image={{ src: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=611&h=405&auto=format&fit=crop', alt: 'Engineering' }}
  />
  <BespokeForm labels={jpLabels} options={jpOptions} />
</Layout>
