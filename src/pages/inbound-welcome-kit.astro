---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'The Inbound Welcome Kit | Hanei JP', 
  description: 'Turn the "Language Barrier" into a "Welcome" — Attract high-spending international guests automatically.',
};

const pricingData = {
  title: 'The Welcome Kit Foundation',
  subtitle: 'Complete Global Reception Desk setup & support.',
  price: '128,500',
  period: 'Setup + ¥9,800/mo support',
  items: [
    { description: 'English-Optimized Web Presence & Menus' },
    { description: 'Google Maps (MEO) Keyword Optimization' },
    { description: 'The Review Shield & Reputation Engine' },
    { description: 'Digital Point-and-Speak Staff Tools' },
    { description: 'Ongoing monthly hosting and English updates' },
  ],
  callToAction: { target: '_self', text: 'Request My Free Inbound Audit', href: '/contact', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="Inbound Welcome Kit"
    title='Welcoming the World <br/><span class="text-accent">Shouldn’t Be Stressful.</span>'
    subtitle='Turn the "Language Barrier" into a "Welcome" — Attract high-spending international guests automatically, without changing your daily routine.'
    actions={[{ variant: 'primary', text: 'Request My Free Inbound Audit', href: '/contact' }]}
    image={{ src: 'https://images.unsplash.com/photo-1522623349500-de37a56ea2a5?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTV8fGphcGFufGVufDB8fDB8fHwy', alt: 'Beautiful Japan Scenery' }}
  />
  
  <!-- SECTION 1: THE PROBLEM -->
  <Content
    isReversed={false}
    items={[
        { 
          title: 'The Communication Wall', 
          description: '"I can’t speak English, so I might provide poor service."', 
          icon: 'tabler:messages-off' 
        },
        { 
          title: 'The Digital Fog', 
          description: '"I don\'t know how to optimize Google or TripAdvisor to reach foreigners."', 
          icon: 'tabler:cloud-fog' 
        },
        { 
          title: 'The Review Fear', 
          description: '"What if a misunderstanding leads to a 1-star review that I can\'t even respond to?"', 
          icon: 'tabler:star-off' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The "Inbound Boom" is here.<br/>Are you being left behind?</h3>
      <p class="text-lg text-muted mb-4">
        You see them every day—travelers walking past your door with their smartphones in hand. You know they are looking for authentic local experiences, but something is stopping them from coming inside.
      </p>
      <p class="text-lg text-muted mb-6">
        Maybe it’s the lack of an English menu. Maybe your Google Maps profile is only in Japanese. Or perhaps, you’re worried about how to handle a complex request in English. Most Japanese business owners feel these anxieties. <strong>Hanei’s Inbound Welcome Kit was built to solve these fears. We bridge the gap between your craft and the global market.</strong>
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1564284369929-026ba231f89b?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTZ8fGphcGFufGVufDB8fDB8fHwy" alt="Tourists in Japan" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 2: THE 3 NO's -->
  <Content
    isReversed={true}
    items={[
        { 
          title: 'NO English Required', 
          description: 'You don’t need to learn a new language. Our tools and automated systems handle the translation and communication for you.', 
          icon: 'tabler:language' 
        },
        { 
          title: 'NO Technical Skill Needed', 
          description: 'We build and manage your digital presence. If you can use a smartphone, you can use Hanei.', 
          icon: 'tabler:device-mobile' 
        },
        { 
          title: 'NO Extra Work for Staff', 
          description: 'Our kit integrates into your existing workflow. No complicated new hardware or time-consuming training for your team.', 
          icon: 'tabler:clock-check' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Our Promise: <br/>The "3 No’s" of Inbound Success</h3>
      <p class="text-lg text-muted">
        We believe that growing your business shouldn't make your life harder. Our system is designed for the busy owner who wants results without the headache.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1533050487297-09b450131914?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTh8fGphcGFufGVufDB8fDB8fHwy" alt="Japan City Lights" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 3: TOTAL SOLUTION -->
  <Content
    isReversed={false}
    items={[
        { 
          title: '1. English-Optimized Web Presence', 
          description: "We build a high-speed, mobile-optimized landing page designed to convert 'browsers' into 'customers.' Featuring beautiful visual menus and reservation-ready links so guests commit before they arrive.", 
          icon: 'tabler:world-www' 
        },
        { 
          title: '2. Google Maps (MEO) Dominance', 
          description: "When a tourist searches 'Best [Your Business] near me' in English, will you appear? We optimize your Profile with English keywords, ensuring you rank at the top of the map when it matters most.", 
          icon: 'tabler:map-pin' 
        },
        { 
          title: '3. The "Review Shield" & Reputation Engine', 
          description: "Automatically invite happy guests to leave 5-star reviews. Catch negative comments privately before they hit the internet. Use our AI tool to reply to English reviews effortlessly.", 
          icon: 'tabler:shield-star' 
        },
        { 
          title: '4. Digital "Point-and-Speak" Tools', 
          description: "We provide digital communication sheets. If a guest asks about allergies, Wi-Fi, or payments, staff just point to the tablet. Everyone stays happy, and service remains fast.", 
          icon: 'tabler:hand-click' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The Inbound Welcome Kit: <br/>A Total Solution</h3>
      <p class="text-lg text-muted mb-6">
        We don’t just build a website; we build a "Global Reception Desk" for your business.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1554797589-7241bb691973?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Njh8fGphcGFufGVufDB8fDB8fHwy" alt="Japanese Dining" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- SECTION 4: HOW TO GET STARTED -->
  <Steps2
    title="How to Get Started"
    subtitle="You don't have to figure this out alone. Let us show you exactly how many potential guests are searching for your business right now."
    items={[
      {
        title: 'Step 1: Free Inbound Audit',
        description: 'We will analyze your current Google Maps ranking and digital visibility for English-speaking keywords.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: The Custom Strategy',
        description: 'We show you the "gaps" in your current setup and how the Welcome Kit will fill them.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Step 3: Peace of Mind',
        description: 'We launch your kit, and you go back to doing what you do best—running your business—while the world starts finding its way to your door.',
        icon: 'tabler:rocket',
      },
    ]}
    callToAction={{ text: 'Request My Free Inbound Audit', href: '/contact', variant: 'primary' }}
    image={{ 
      src: 'https://images.unsplash.com/photo-1611518040385-1cc65ab82c91?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTB8fGl6YWtheWF8ZW58MHx8MHx8fDI%3D', 
      alt: 'Izakaya Interior',
    }}
  />

  <!-- SECTION 5: PRICING -->
  
  <!-- TOURIST READY SUITE -->
  <Features2
    title='Every Plan Includes the "Tourist-Ready" Suite:'
    subtitle="Built-in infrastructure to ensure you start capturing inbound traffic immediately."
    columns={3}
    items={[
      { title: 'Google Maps SEO (MEO)', description: '1-page full English SEO setup to ensure you appear when tourists search "near me."', icon: 'tabler:circle-check' },
      { title: 'Custom QR Review Assets', description: 'Print-ready PDFs for your tables to drive 5-star Google reviews.', icon: 'tabler:circle-check' },
      { title: 'The "How-To" Landing Page', description: 'Custom content explaining your rules (No smoking, cover charges, shoe policy) to remove the Anxiety of Entry.', icon: 'tabler:circle-check' },
      { title: 'Professional English Copywriting', description: "We don't just translate; we write high-converting business descriptions.", icon: 'tabler:circle-check' },
      { title: 'Super-High-Speed Network', description: 'Optimized for mobile users on roaming data so your site loads instantly.', icon: 'tabler:circle-check' },
      { title: 'Same-Day Lightning Fast Deployment', description: 'Order before lunch, and we launch your website today!', icon: 'tabler:bolt' },
    ]}
  />

  <Pricing 
    id="pricing"
    title="Simple, Transparent Pricing" 
    subtitle="No hidden fees. No complicated Tiers. We provide a flat-fee professional setup and a low monthly maintenance cost that pays for itself with just a few new international customers."
    prices={[pricingData]} 
  />

  <!-- SECTION 6: ABOUT HANEI -->
  <CallToAction
    title="About Hanei"
    subtitle="Hanei is dedicated to empowering Japanese local businesses. We believe that Japan’s local culture is its greatest asset, and we use modern technology to ensure that the world can experience it—without the stress of the language barrier."
    actions={[]}
  />

</Layout>
