---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = { 
  title: '地域貢献活動 | 公共の利益のための無料Web制作支援 | Hanei JP', 
  description: '日本のNPOやコミュニティ団体へ、プロフェッショナルなWeb制作を完全無料で提供します。',
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="地域貢献活動（コミュニティ・ミッション）"
    title='日本の地域社会を支える皆様へ。<br/><span class="text-accent">公共の利益のため、Web制作を無料で提供。</span>'
    subtitle="皆様の素晴らしい活動と想いを社会に届けるために、私たちは自らの技術を公共の利益に資する無料サービスとして提供します。"
    actions={[{ variant: 'primary', text: '支援について問い合わせる', href: 'mailto:webmaster@fijinetworks.com?subject=Community Mission Inquiry (JP)' }]}
    image={{ src: 'https://images.unsplash.com/photo-1665562011653-e8bfc3ca6602?w=500&auto=format&fit=crop&q=60', alt: 'Japanese Community' }}
  />

  <div id="application" class="scroll-mt-20 py-24 text-center">
    <div class="max-w-4xl mx-auto bg-slate-50 rounded-[3rem] p-12 md:p-24 border-2 border-slate-100 shadow-2xl">
      <h3 class="text-4xl md:text-5xl font-black text-slate-950 uppercase tracking-tighter mb-8">支援のお申し込み</h3>
      <p class="text-xl md:text-2xl text-slate-600 mb-12 font-bold leading-relaxed">
        日本国内のNPO法人、一般社団法人、または実績のある団体を対象としています。詳細はメールにて事務局へ直接お問い合わせください。
      </p>
      <a href="mailto:webmaster@fijinetworks.com?subject=Community Mission Support Request (JP)" class="inline-block bg-blue-600 text-white px-12 py-6 rounded-2xl text-2xl font-black uppercase tracking-widest hover:bg-slate-950 transition-all transform hover:-translate-y-1 shadow-2xl">
        事務局へメールを送る
      </a>
    </div>
  </div>
</Layout>
