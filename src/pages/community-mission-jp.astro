---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { 
  title: '地域貢献活動 | 公共の利益のための無料Web制作支援 | Hanei JP', 
  description: '日本のNPOやコミュニティ団体へ、プロフェッショナルなWeb制作を公共の利益のために完全無料で提供します。',
};

const jpLabels = {
    title: "支援申込フォーム ❤️",
    client_name: "代表者名",
    company_name: "団体名・NPO法人名",
    email: "メールアドレス",
    address: "団体の所在地・住所",
    request_type: "支援分野",
    project_summary: "活動内容と支援希望の背景",
    budget_range: "現在のウェブ状況",
    deadline: "希望納期・時期",
    referral: "当社を知ったきっかけ",
    submit: "支援を申し込む"
};

const jpOptions = {
    requests: ["障がい者支援", "動物愛護・保護", "高齢者支援・福祉", "子ども・若者支援", "その他の公共活動"],
    budgets: ["サイトなし", "古いサイトがある", "SNSのみ運用", "その他"],
    timelines: ["至急", "1ヶ月以内", "時期未定・相談", "その他"],
    referrals: ["Google検索", "SNS", "知人の紹介", "その他"]
};
---

<Layout metadata={metadata}>
  
  <Hero2
    tagline="地域貢献活動（コミュニティ・ミッション）"
    title='日本の地域社会を支える皆様へ。<br/><span class="text-accent">公共の利益のため、Web制作を無料で提供。</span>'
    subtitle="誰かのために人生を捧げる皆様へ。皆様の素晴らしい活動と想いを社会に届けるために、私たちは自らの技術を公共の利益に資する無料サービスとして捧げます。"
    actions={[{ variant: 'primary', text: '支援を申し込む', href: '#application' }]}
    image={{ src: 'https://images.unsplash.com/photo-1665562011653-e8bfc3ca6602?w=500&auto=format&fit=crop&q=60', alt: 'Japanese Community' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />
  
  <Content isReversed={true} classes={{ container: 'py-8 md:py-12' }}>
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">日本各地の「志」に、最高水準のWebを。</h3>
      <p class="text-lg text-muted mb-4">
        大阪、神戸、広島、京都といった都市部から、日本の隅々にある温かなコミュニティまで。地域社会を支えるために、現場で人知れず汗を流す「真のヒーロー」たちがいます。
      </p>
      <p class="text-lg text-muted">
        Haneiは、社会に最も貢献している方々がデジタル資源の不足によって活動を制限されるべきではないと信じています。公共の利益のため、プロの企業向けと同等の『デジタルの拠点』を無償で提供します。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1555126417-38de941cba37?w=500&auto=format&fit=crop&q=60" alt="Traditional Japan" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Content
    isReversed={false}
    isAfterContent={true}
    tagline="支援の対象"
    title="公共の利益に資する4つの柱"
    items={[
        { title: '障がい者支援', description: '最新のWebアクセシビリティ基準に準拠した、誰もが平等に使えるサイト。', icon: 'tabler:accessible' },
        { title: '動物愛護・保護活動', description: '動物たちの魅力を伝え、里親申し込みや寄付をスムーズにするサイト構築。', icon: 'tabler:paw' },
        { title: '高齢者支援・福祉', description: '文字が読みやすく、地域のリソースを簡単に見つけられるアクセシブルな設計。', icon: 'tabler:old' },
        { title: '子ども・若者支援', description: '子ども食堂や学習支援など、安全で温かみのあるオンライン空間の創造。', icon: 'tabler:school' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1513360371669-4adf3dd7dff8?w=500&auto=format&fit=crop&q=60', alt: 'Animal Care' }}
    classes={{ container: 'py-8 md:py-12' }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted mb-6">
        思いやりのある社会の基盤となる分野に焦点を当て、日本全国の団体を支援しています。
      </p>
    </Fragment>
  </Content>

  <Features2
    title='公共の利益のための <br/><span class="text-accent">「Haneiスタンダード」：</span>'
    subtitle="企業クライアントへ提供するものと全く同じエリート・インフラを提供します。"
    columns={3}
    items={[
      { title: 'プロによる完全オリジナルデザイン', description: '団体のビジョンを反映した独自のデザイン。', icon: 'tabler:circle-check' },
      { title: 'モバイル最適化', description: 'スマートフォンで最も快適に閲覧できる設計。', icon: 'tabler:circle-check' },
      { title: 'SEO（検索エンジン最適化）', description: '地域の皆様がネット検索から確実に団体を見つけられる仕組み。', icon: 'tabler:circle-check' },
      { title: '安全なサーバー設定', description: '個人情報を守るための、最も安全な環境構築。', icon: 'tabler:circle-check' },
      { title: '運用トレーニング', description: '活動報告やニュースをご自身で更新できるようレクチャー。', icon: 'tabler:circle-check' },
      { title: '多言語対応（バイリンガル）', description: '在日外国人コミュニティとの架け橋となるサイト構築。', icon: 'tabler:circle-check' },
    ]}
    classes={{ container: 'py-8 md:py-12' }}
  />

  <div id="application" class="scroll-mt-20">
    <Content
      isReversed={false}
      tagline="応募方法"
      title="活動のインパクトを拡大しませんか？"
      image={{ src: 'https://images.unsplash.com/photo-1765193501601-19e2f52bb546?w=500&auto=format&fit=crop&q=60', alt: 'Interaction' }}
      classes={{ container: 'py-8 md:py-12' }}
    >
      <Fragment slot="content">
        <p class="text-lg text-muted mb-4">全力で向き合うため、1年間に対応できるプロジェクトの数には限りがございます。</p>
        <ul class="list-disc pl-5 space-y-2 text-muted mb-6">
          <li>日本国内のNPO法人、一般社団法人、または実績のある団体であること。</li>
          <li>主な活動が「障がい者」「動物」「高齢者」「子ども」支援のいずれか、またはその他の公共の利益に資する重要な取り組みであること。</li>
          <li>地域社会の成長と、社会貢献に対する明確なビジョンがあること。</li>
        </ul>
        <h3 class="text-2xl font-bold mt-8">支援申込（以下のフォームから）</h3>
        <p class="text-muted text-lg">皆様のストーリーと、誰を助けているのかを教えてください。</p>
      </Fragment>
    </Content>
    <BespokeForm labels={jpLabels} options={jpOptions} />
  </div>

</Layout>
