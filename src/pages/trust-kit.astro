---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: '外国人客を呼び込む：インバウンド・トラストキット | Inbound Trust Kit', 
  description: 'Googleマップの英語最適化で、インバウンド集客を24時間以内に最大化。',
};

const pricingData = {
  title: 'インバウンド集客のインフラ構築',
  subtitle: 'Building your Inbound Infrastructure',
  price: 99000,
  period: '一括費用 (One-time)',
  items: [
    { description: 'Full English SEO Setup for Google Maps' },
    { description: 'Custom Branded QR Review Assets (Print-ready PDF)' },
    { description: 'AI-Optimized English Business Description' },
    { description: '24-Hour Deployment Guarantee' },
  ],
  callToAction: { target: '_blank', text: '24時間以内に集客を開始する', href: '#', variant: 'success' },
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero2
    tagline="The Inbound Trust Kit"
    title='外国人客が「あなたのお店」を<br/><span class="text-accent">見つけられない理由</span>をご存知ですか？'
    subtitle="Googleマップの英語最適化で、インバウンド集客を24時間以内に最大化。<br/><br/><small>Turn Google Maps into your #1 Foreign Customer Driver. Professional SEO Optimization & English Review System.</small>"
    actions={[{ variant: 'primary', text: '今すぐインバウンド集客を最適化する', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1024&q=80', alt: 'Tourist using smartphone in Japan' }}
  />
  
  <!-- Section 1 & 2: The Pain & The Solution -->
  <Content
    isReversed={false}
    items={[
        { 
          title: 'Google Business Profile English SEO', 
          description: '店名、カテゴリー、サービス内容を、外国人が検索する「キーワード」で英語化。検索順位を劇的に向上させます。', 
          icon: 'tabler:map-pin' 
        },
        { 
          title: 'The "Review Magnet" QR System', 
          description: 'スマホをかざすだけで、外国人が迷わず「英語で」高評価レビューを書ける専用QRスタンドを提供。', 
          icon: 'tabler:qrcode' 
        },
        { 
          title: 'English FAQ & Trust Signals', 
          description: '「カード決済OK？」「英語スタッフはいる？」外国人客が抱く不安を、プロの英語で先回りして回答。', 
          icon: 'tabler:message-circle-check' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">英語のウェブサイトを作る前に、<br/>解決すべき「壁」があります。</h3>
      <p class="text-lg text-muted mb-6">
        訪日外国人の92%がGoogleマップで目的地を探します。店名が日本語のままだと、彼らの画面には表示すらされません。
        「インバウンド・トラストキット」は、あなたの店舗を即日「外国人フレンドリー」に変換します。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="Data and results" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- Section 3: Why Us -->
  <Content
    isReversed={true}
    items={[
        { 
          title: 'Fast (スピード)', 
          description: '弊社独自のPythonスクリプトにより、設定から反映までを最短24時間で完了。', 
          icon: 'tabler:bolt' 
        },
        { 
          title: 'Simple (シンプル)', 
          description: 'あなたがやることは、簡単なアンケートに答えるだけ。開発の手間は一切ありません。', 
          icon: 'tabler:check' 
        },
        { 
          title: 'Western Standards (欧米基準)', 
          description: '単なる翻訳ではなく、欧米人の購買心理に基づいた「刺さる」英語表現を使用します。', 
          icon: 'tabler:world' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">開発の手間、一切なし。<br/>24時間でデプロイ完了。</h3>
      <p class="text-lg text-muted">外国人客は、今この瞬間もあなたを探しています。技術的な障壁をすべて取り除き、最速で成果を出すことに特化したパッケージです。</p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?auto=format&fit=crop&w=800&q=80" alt="Team working" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- Pricing Section -->
  <Pricing 
    id="pricing"
    title="一括費用: ¥99,000" 
    subtitle="月額費用なし (No Monthly Subscription)"
    prices={[pricingData]} 
  />

  <div class="text-center pb-12 text-muted text-sm">
    Ultra-fast Edge Delivery: Powered by Cloudflare
  </div>
</Layout>
