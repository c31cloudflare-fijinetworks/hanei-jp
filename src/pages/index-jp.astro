---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Button from '~/components/ui/Button.astro';

const metadata = { 
  title: 'Hanei JP | インバウンド集客・支援ソリューション', 
  description: '日本の技を、世界へ繋ぐ。Googleマップ英語SEO、レビューエンジンなど、インバウンド集客のインフラを圧倒的スピードで提供します。' 
};
---
<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="インバウンド集客・デジタル基盤構築の専門家"
    title='日本の「おもてなし」を、<br/><span class="text-accent dark:text-white">世界が選ぶ「正解」へ。</span>'
    subtitle="日本の素晴らしいおもてなしを、テクノロジーの力で世界基準へ。<br/><br/>インバウンド集客の「見えない壁」を壊し、日常業務を変えることなく高単価な外国人観光客を惹きつけるデジタルインフラを提供します。<br/><br/>私たちは単なる翻訳ではなく、欧米富裕層の消費心理に基づいた「選ばれる理由」へと価値を再定義し、言葉やシステムの壁を越えて世界中のお客様を歓迎できる環境を構築します。"
    actions={[{ variant: 'primary', text: '無料インバウンド診断を申し込む', href: '/contact-jp' }, { text: 'サービス一覧を見る', href: '#features' }]}
    image={{ src: 'https://images.unsplash.com/photo-1748242790323-477b5eec8486?q=80&w=387&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D', width: 1024, height: 576, alt: 'Japanese Street Scene' }}
  />

  <!-- STATS SECTION -->
  <Stats
    stats={[
      { title: '訪日外国人客数 (2024年)', amount: '3,300万+' },
      { title: '英語でのローカル検索率', amount: '92%' },
      { title: '最長セットアップ時間', amount: '48時間' },
      { title: '月額保守費用', amount: '¥0' },
    ]}
  />

  <!-- FEATURES SUMMARY -->
  <Features
    id="features"
    title="インバウンド・サービスキット"
    subtitle="現場の負担を減らし、収益を最大化するための4つの専門ソリューション。"
    items={[
        { 
          title: '1ページ・ウェルカム', 
          description: '集客と接客の基盤。Googleマップ英語SEOと、言語の壁を越える視覚的ガイダンスを統合した初期パッケージ。', 
          icon: 'tabler:map-pin',
          callToAction: { variant: 'primary', text: '1ページ・ウェルカムを見る', href: '/one-page-welcome-jp' }
        },
        { 
          title: 'レビューエンジン', 
          description: '信頼の自動生成。お客様からのレビューを自動収集。お店のブランドに完全に合わせた美しい専用ページで、口コミ投稿を劇的に促進します。', 
          icon: 'tabler:message-star',
          callToAction: { variant: 'primary', text: 'レビューエンジンを見る', href: '/review-engine-jp' }
        },
        { 
          title: '英語専用デジタル別館 (Hanare)', 
          description: 'リスクゼロの海外展開。既存の日本語サイトに一切触れず、独立したドメイン上に最高水準の英語資産を構築します。', 
          icon: 'tabler:layers-intersect',
          callToAction: { variant: 'primary', text: '英語の離れを見る', href: '/english-hanare-jp' }
        },
        { 
          title: 'グランド・ニュー / グランドリフォーム', 
          description: '完全なリブート。既存サイトの高速リフォームか、ゼロから構築するバイリンガル旗艦店をお選びいただけます。', 
          icon: 'tabler:rocket',
          callToAction: { variant: 'primary', text: 'プランの詳細を見る', href: '/grand-opening-jp' }
        },
    ]}
  />

  <!-- SERVICE 1: WELCOME KIT -->
  <Content
    isReversed={false}
    tagline="サービス1：1ページ・ウェルカム"
    title="集客は「情報の壁」を壊すことから始まります。"
    items={[
        { title: 'Googleマップ（MEO）SEO', description: '欧米の富裕層が検索するキーワードで最適化し、ローカル検索を制覇します。', icon: 'tabler:map-pin' },
        { title: '視覚的ガイダンス', description: '店舗ルールを視覚的に伝え、外国人客の「入店前の不安」を完全に払拭します。', icon: 'tabler:eye' },
        { title: 'カスタムQRツール', description: '卓上に設置してすぐにレビューやアクションを促すQRスタンドを提供。', icon: 'tabler:qrcode' },
    ]}
    image={{ src: 'https://plus.unsplash.com/premium_photo-1722897350877-31cbfde8af2a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1yZWxhdGVkfDI0fHx8ZW58MHx8fHx8', alt: 'Authentic Japan Experience' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">見えない壁（The Visibility Gap）</span>
      </h3>
      <p class="text-muted text-lg mb-6">あなたのお店は最高のおもてなしを提供していますが、外国人旅行者からは「見えていない」かもしれません。私たちはその摩擦を取り除き、来店前に「発見され、理解され、信頼される」環境を整えます。</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="詳細を見る" href="/one-page-welcome-jp" />
    </Fragment>
  </Content>

  <!-- SERVICE 2: REVIEW ENGINE -->
  <Content
    isReversed={true}
    tagline="サービス2：レビューエンジン"
    title="「静かな満足感」を、世界に響く最強の営業資産へ。"
    items={[
        { title: 'ブランド専用レビューページ', description: '汎用的なリンクではなく、お店のロゴや世界観に完全に合わせた美しい専用ページをご用意し、スムーズな投稿環境を構築します。', icon: 'tabler:palette' },
        { title: '称賛の壁（ライブ・ウォール）', description: '最新の高評価レビューを自社サイトに美しく自動表示し、瞬時に信頼を構築します。', icon: 'tabler:stars' },
        { title: 'スマート多言語ルーティング', description: 'お客様のスマホ言語を認識し、母国語で案内するストレスフリーな設計。', icon: 'tabler:language' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1565117661210-fd54898de423?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8OXx8amFwYW5lc2UlMjB0ZWF8ZW58MHx8MHx8fDI%3D', alt: 'Serving Japanese Tea' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">信頼の自動化（Automated Trust）</span>
      </h3>
      <p class="text-muted text-lg mb-6">お客様の「満足度」と「ネット上の評価」の間には溝があります。レビューを書く作業が少しでも面倒だと、お客様は書いてくれません。私たちはこのプロセスを自動化し、口コミに怯える日々を終わらせます。</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="レビューエンジンの詳細へ" href="/review-engine-jp" />
    </Fragment>
  </Content>

  <!-- SERVICE 3: ENGLISH HANARE -->
  <Content
    isReversed={false}
    tagline="サービス3：英語専用デジタル別館 (Hanare)"
    title="既存システムを壊さずに、最高級の「離れ」を建てる。"
    items={[
        { title: '「離れ（Hanare）」コンセプト', description: '外国人ゲストに特化した最新・高速のデジタル空間を、母屋（既存サイト）とは独立して新設します。', icon: 'tabler:home' },
        { title: 'ゼロ・タッチ統合（非干渉）', description: 'パスワードもFTP情報も不要。現在の日本語サイトには一切触れず、安全に稼働させます。', icon: 'tabler:lock' },
        { title: '富裕層向けの極上のUX', description: '欧米のラグジュアリー層の購買心理に合わせたデザインと、直接予約へ繋がる導線設計。', icon: 'tabler:diamond' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MjEzfHxqYXBhbmVzZSUyMGJ1c2luZXNzfGVufDB8fDB8fHwy', alt: 'Modern Japanese Business' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">ゼロ・リスクの海外展開</span>
      </h3>
      <p class="text-muted text-lg mb-6">「英語を追加したいが、古いシステムをいじって日本語サイトが壊れるのが怖い」。多くの経営者が抱えるこのジレンマを、完全に独立したアーキテクチャで根本から解決します。</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="英語の離れの詳細へ" href="/english-hanare-jp" />
    </Fragment>
  </Content>

  <!-- SERVICE 4: GRAND OPENING -->
  <Content
    isReversed={true}
    tagline="サービス4：グランド・ニュー / グランドリフォーム"
    title="過去の技術的負債を一掃し、48時間で旗艦店を再構築。"
    items={[
        { title: '48時間の圧倒的スピード', description: '独自の高速フレームワークにより、たった一度の週末（48時間）で全体をリブートします。', icon: 'tabler:clock' },
        { title: 'グランドリフォーム', description: '既存サイトを圧倒的なスピードで全面改修し、モダンなデザインと最高水準のパフォーマンスを注入します。', icon: 'tabler:tool' },
        { title: 'グランド・ニューオープン', description: 'ゼロから構築する完全なバイリンガル対応のデジタル旗艦店。両方の市場からの予約率を最大化します。', icon: 'tabler:rocket' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1577016029703-cc22a7c0c28c?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NXx8amFwYW5lc2UlMjB0ZWF8ZW58MHx8MHx8fDI%3D', alt: 'Premium Japanese Experience' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">全社的トランスフォーメーション</span>
      </h3>
      <p class="text-muted text-lg mb-6">読み込みに3秒以上かかったり、時代遅れのデザインのままだと、富裕層の旅行者は「サービス自体も古い」と判断します。私たちは、今後10年の成長を牽引するデジタル上の「旗艦店」をゼロから創り上げます。</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="グランドオープンの詳細へ" href="/grand-opening-jp" />
    </Fragment>
  </Content>

  <!-- STEPS: THE PROCESS -->
  <div id="process" class="scroll-mt-20">
    <Steps2
      isReversed={false}
      title="世界市場への進出ロードマップ"
      subtitle="面倒なIT作業はすべて私たちが引き受けます。あなたは「最高のおもてなし」に集中してください。"
      items={[
        { title: '01. 無料インバウンド診断', description: '英語キーワードにおける、あなたのお店の現在のGoogleマップ順位やWebでの露出度（機会損失のギャップ）を分析します。', icon: 'tabler:search' },
        { title: '02. 驚異的スピードでの構築', description: 'Haneiの独自システムにより、デジタル資産の構築とプロフィールの最適化を、最短24時間〜48時間で完了させます。', icon: 'tabler:bolt' },
        { title: '03. 世界中のお客様をお迎えする', description: '不安を解消し、魅力を十分に理解した質の高い外国人観光客の集客が始まります。口コミの管理もシステムが自動で行います。', icon: 'tabler:world' },
        { title: '04. 地域No.1のブランド確立', description: '星5つの高評価が自動的に蓄積されることでGoogleマップの順位が上昇し、地域で最も選ばれる圧倒的なブランドへと成長します。', icon: 'tabler:trending-up' }
      ]}
      image={{ src: 'https://images.unsplash.com/photo-1769321309340-6c723c65747a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTk3fHxqYXBhbmVzZSUyMGJ1c2luZXNzfGVufDB8fDB8fHwy', alt: 'Japanese Hospitality' }}
    />
  </div>

  <!-- TOURIST READY SUITE -->
  <Features2
    title='すべてのプランに含まれる「インバウンド対応スイート」'
    subtitle="インバウンド集客を即座に開始するための必須インフラが標準で付属しています。"
    columns={3}
    items={[
      { title: 'GoogleマップSEO（MEO）', description: '外国人観光客が「近くの〇〇」と検索した際に上位表示させる、1ページの完全英語SEO設定。', icon: 'tabler:circle-check' },
      { title: 'カスタムQRレビューPOP', description: '卓上に置いてGoogleの星5つレビューを促進する、印刷用プリセット。', icon: 'tabler:circle-check' },
      { title: '「How-To」ランディングページ', description: '禁煙、お通し、靴を脱ぐルールなどを説明し、入店前の不安を解消するカスタムコンテンツ。', icon: 'tabler:circle-check' },
      { title: 'プロの英語コピーライティング', description: '単なる翻訳ではなく、予約・来店につながる魅力的なビジネス説明文を執筆。', icon: 'tabler:circle-check' },
      { title: '超高速ページ配信ネットワーク', description: 'ローミング通信を利用するモバイルユーザー向けに最適化された高速表示。', icon: 'tabler:circle-check' },
      { title: '最短即日の超高速デプロイ', description: '午前中のご注文で、本日中にWebサイトを公開・稼働させます！', icon: 'tabler:bolt' },
    ]}
  />

  <!-- FAQS -->
  <FAQs
    title="よくあるご質問"
    items={[
        { title: '英語を話せなくても導入できますか？', description: 'はい。システムがお客様にネイティブ英語で視覚的なガイダンスを提供し、質問を未然に防ぎます。スタッフは翻訳ではなく「接客」に集中できます。', icon: 'tabler:messages-off' },
        { title: '月額費用はかかりますか？', description: '「英語の離れ」や「ウェルカムキット」などのインフラ構築は一括投資（買い切り）です。レビューエンジン等のクラウド機能を利用する場合のみ、少額の月額保守費用が発生します。', icon: 'tabler:coin' },
        { title: 'Hanei JPとは何ですか？', description: 'インバウンドに特化した技術スタジオです。日本のローカルビジネスが世界市場に参入する際の「言語」「心理」「技術」のリスクをテクノロジーで解決します。', icon: 'tabler:world' },
        { title: '導入までにどのくらいの期間がかかりますか？', description: '私たちは「圧倒的なスピード」を重視しています。ウェルカムキット等は24時間以内、完全なサイトリニューアルであっても48時間以内のデプロイを保証しています。', icon: 'tabler:bolt' },
    ]}
    callToAction={{ variant: 'primary', text: 'よくあるご質問をもっと見る', href: '/faq-jp' }}
  />
</Layout>
