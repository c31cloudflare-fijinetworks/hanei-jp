---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = { 
  title: '制作実績デモ | ポートフォリオ | Hanei JP',
  description: '日本の各業界向けに構築された、高コンバージョンなブティック制作デモのポートフォリオをご覧いただけます。'
};

const demos = [
  { title: "ZenPod Tokyo", sub: "日本の美意識と高い成約率を両立させた、ラグジュアリーなカプセルホテル・コンセプト。", link: "/demos/capsule-hotel", img: "https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200" },
  { title: "麻布プレミアムメディカル", sub: "外国人居住者向けの洗練された医療施設。スムーズな予約導線を実現。", link: "/demos/azabu-medical", img: "https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200" },
  { title: "GINZA KAIZEN", sub: "銀座の高級ヘアサロン。完全英語対応のコンシェルジュ機能を統合。", link: "/demos/ginza-kaizen", img: "https://images.unsplash.com/photo-1560869713-7d0a29430803?w=1200" },
  { title: "Tokyo Locker & Storage", sub: "高度なセキュリティと非接触決済を組み合わせた、プレミアムな手荷物預かりソリューション。", link: "/demos/tokyo-locker-storage-premium-luggage-solutions", img: "https://images.unsplash.com/photo-1618438502398-195e47778d6c?w=1200" },
  { title: "Kagari Izakaya & Grill", sub: "季節のおまかせ予約フローを備えた、新宿の高級ガストロノミー目的地。", link: "/demos/kagari-izakaya-grill-shinjuku-tokyo-gastronomy", img: "https://images.unsplash.com/photo-1617870314635-fc819547ec11?w=1200" },
  { title: "Shika-An Nara", sub: "静寂と伝統的な贅沢に焦点を当てた、奈良の歴史的なゲストハウス体験。", link: "/demos/shika-an-nara-luxury-heritage-guesthouse", img: "https://images.unsplash.com/photo-1530708780517-cc640cf05561?w=1200" },
  { title: "Osaka Unseen", sub: "大阪の隠れた名店を巡る、富裕層向けの食の探検ツアー・プラットフォーム。", link: "/demos/osaka-unseen-luxury-culinary-expeditions", img: "https://images.unsplash.com/photo-1605582763781-dff23d0f5d32?w=1200" },
  { title: "Takumi Precision", sub: "日本の製造業の卓越した技術を世界へ発信する、工業・製造業向けデモ。", link: "/demos/takumi-precision-tokyo-engineering-the-future", img: "https://images.unsplash.com/photo-1757912666361-8c226b7279b9?w=1200" },
  { title: "Omotesando Dental", sub: "外国人居住者や観光客をターゲットとした、自由診療メインの歯科クリニック。", link: "/demos/omotesando-dental", img: "https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1200" },
  { title: "KyoEthereal", sub: "京都の寺院でのプライベートな瞑想体験や、精神的な旅のプランニング。", link: "/demos/private-kyoto-temple-expeditions", img: "https://images.unsplash.com/photo-1574236170880-fbbca132d83d?w=1200" },
  { title: "Mizu no Kokoro", sub: "大阪のハイエンド市場をターゲットとした、モダンな銭湯・ウェルネス施設。", link: "/demos/mizu-no-kokoro-luxury-sento-wellness-osaka", img: "https://images.unsplash.com/photo-1764057146162-64aaea28494a?w=1200" },
  { title: "Kura Tokyo", sub: "貴重品や手荷物のための、生体認証を備えた高セキュリティな保管サービス。", link: "/demos/kura-tokyo-premium-luggage-concierge-secure-storage", img: "https://images.unsplash.com/photo-1756649627237-d367a3e3a311?w=1200" },
  { title: "Kissa & Co.", sub: "職人による自家焙煎とハンドドリップの儀式を伝える、ブティック・ロースタリー。", link: "/demos/kissa-co-osaka", img: "https://images.unsplash.com/photo-1453614512568-c4024d13c247?w=1200" },
  { title: "Zen Relocations", sub: "国際的なコミュニティ向けの、日本の細やかなおもてなしを体現した引越しサービス。", link: "/demos/zen-relocations-japan-relocations", img: "https://images.unsplash.com/photo-1722487631997-cf1e0f92c2c4?w=1200" }
];
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="ギャラリー" 
    title='制作実績<br/><span class="text-accent">デモ一覧。</span>' 
    subtitle="私たちの技術をデジタルで表現。各業界に特化した『Haneiスタンダード』の制作サンプルをご確認いただけます。"
    image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200', alt: 'Hanei Gallery' }}
  />

  <div class="space-y-4">
    {demos.map((demo, index) => (
      <Content 
        isReversed={index % 2 !== 0}
        title={`制作デモ: ${demo.title}`}
        subtitle={demo.sub}
        callToAction={{ variant: 'primary', text: 'デモを起動', href: demo.link }}
        image={{ src: demo.img, alt: demo.title }}
        classes={{ container: 'py-12 md:py-20' }}
      />
    ))}
  </div>
</Layout>
