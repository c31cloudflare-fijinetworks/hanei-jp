---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: 'インバウンド・トラストキット | 外国人客を集客する', 
  description: 'Googleマップの英語最適化で、インバウンド集客を24時間以内に最大化。',
};

const pricingData = {
  title: 'インバウンド集客インフラ構築',
  subtitle: '外国人客を呼び込むための必須設定',
  price: '99,000',
  period: '一括費用（月額なし）',
  items: [
    { description: 'Googleマップ英語SEO完全設定' },
    { description: '店舗専用・英語レビュー獲得QRスタンド' },
    { description: 'AI最適化された英語のビジネス説明文' },
    { description: '24時間以内のスピード導入保証' },
  ],
  callToAction: { target: '_blank', text: '今すぐ集客を開始する', href: '#', variant: 'success' },
};
---

<Layout metadata={metadata}>
  <!-- BLOCK 1: HERO -->
  <Hero2
    tagline="インバウンド・トラストキット"
    title='外国人客が「あなたのお店」を<br/><span class="text-accent">見つけられない理由</span>をご存知ですか？'
    subtitle="訪日客の92%が利用するGoogleマップを最適化。多言語対応の壁を取り除き、24時間以内にあなたの店舗を「外国人フレンドリー」に変貌させます。"
    actions={[{ variant: 'primary', text: '24時間以内に集客を開始する', href: '#pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1024&q=80', alt: 'スマホで店を探す外国人' }}
  />
  
  <!-- BLOCK 2: THE PROBLEM & SOLUTION (Reversed False) -->
  <Content
    isReversed={false}
    items={[
        { 
          title: 'Googleマップ英語SEO', 
          description: '店名やカテゴリーを、外国人が実際に検索するキーワードで英語化。検索順位を劇的に向上させます。', 
          icon: 'tabler:map-pin' 
        },
        { 
          title: '英語レビュー獲得システム', 
          description: 'QRコードをかざすだけで、外国人が迷わず英語で高評価を書ける専用スタンドとデジタル資産を提供。', 
          icon: 'tabler:qrcode' 
        },
        { 
          title: '信頼構築のQ&A', 
          description: '「カード決済OK？」「英語スタッフはいる？」外国人客の不安をプロの英語で先回りして解消。', 
          icon: 'tabler:message-circle-check' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">英語のサイトを作る前に、<br/>解決すべき「情報の壁」があります。</h3>
      <p class="text-lg text-muted mb-6">
        店名が漢字のままだと、外国人客の画面には表示すらされません。レビューが「ゼロ」のビジネスを、彼らは選びません。
        私たちは、その「見えない壁」を取り除き、あなたの店舗を即日コンバートします。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80" alt="集客データ" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- BLOCK 3: THE ONE-SHOT PROMISE (Reversed True) -->
  <Content
    isReversed={true}
    items={[
        { 
          title: 'Speed (スピード)', 
          description: '弊社独自のPythonスクリプトにより、設定から反映までを最短24時間で完了。', 
          icon: 'tabler:bolt' 
        },
        { 
          title: 'Simple (シンプル)', 
          description: 'あなたがやることは、簡単なアンケートに答えるだけ。開発の手間は一切ありません。', 
          icon: 'tabler:check' 
        },
        { 
          title: 'Western Standards (欧米基準)', 
          description: '単なる翻訳ではなく、欧米人の購買心理に基づいた「刺さる」英語表現を使用します。', 
          icon: 'tabler:world' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">開発の手間、一切なし。<br/>24時間でデプロイ完了。</h3>
      <p class="text-lg text-muted">外国人客は、今この瞬間もあなたを探しています。技術的な障壁をすべて取り除き、最速で成果を出すことに特化したパッケージです。欧米の顧客が求める高い基準の情報を即座に提供します。</p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?auto=format&fit=crop&w=800&q=80" alt="プロフェッショナルな対応" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- BLOCK 4: PRICING -->
  <Pricing 
    id="pricing"
    title="インバウンド集客のインフラ構築" 
    subtitle="一括費用: ¥99,000 (月額費用なし)"
    prices={[pricingData]} 
  />

  <div class="text-center pb-12 text-muted text-sm italic">
    Ultra-fast Edge Delivery: Powered by Cloudflare
  </div>
</Layout>
