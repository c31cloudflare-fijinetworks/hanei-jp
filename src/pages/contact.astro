---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { 
  title: 'Contact | Hanei JP',
  description: 'Reach out for general inquiries or bespoke digital solutions.'
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="Contact Us"
    title='Bespoke Solutions & <br/><span class="text-accent">General Inquiries</span>'
    subtitle="We thrive on complexity and local excellence. Whether you have a simple question or a technical request—we want to hear about it."
    image={{ src: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=611&h=405&auto=format&fit=crop', alt: 'Contact' }}
  />
  <BespokeForm />
</Layout>
