---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';



const metadata = { 
  title: 'Strategic Intent | Hanei JP', 
  description: 'Our mission to bridge the gap between local Japanese excellence and global consumer psychology.' 
};
---
<Layout metadata={metadata}>
  <Hero2
    tagline="Strategic Intent"
    title='Your Business, Translated for the <span class="text-accent">Global Elite</span>'
    subtitle="We don't just bridge languages; we bridge the gap between local Japanese hospitality (Omotenashi) and the rigid expectations of high-net-worth international travelers. We turn local excellence into global authority."
    actions={[{ variant: 'primary', text: 'View Inbound Solutions', href: '/pricing' }]}
    image={{ src: 'https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=1024&q=80', alt: 'Global Executive Strategy' }}
  />
  
  <Content
    isReversed={false}
    items={[
        { 
          title: 'Neutralizing Perceived Risk', 
          description: 'Western travelers are highly risk-averse in foreign environments. If your rules, pricing, or booking flows are unclear, they perceive "danger" and move on. We use proprietary psychological logic to present your business as a safe, world-class destination.', 
          icon: 'tabler:shield-check' 
        },
        { 
          title: 'The Architecture of Trust', 
          description: 'Trust is not built on translation; it is built on infrastructure. By deploying secure, rapid-loading English assets, we signal to the guest that your business is technologically sophisticated and operationally stable.', 
          icon: 'tabler:building-bridge' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The Psychology of the Global Guest</h3>
      <p class="text-lg text-muted">In the modern inbound market, "Generic" is the enemy of "Luxury." We move beyond basic translation to provide a clean, authoritative digital presence that establishes you as a local leader. Hanei JP was founded on the principle that your online infrastructure should be your most effective global salesperson.</p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1454165833767-027ffea9e61?auto=format&fit=crop&w=800&q=80" alt="Strategic Planning" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Content
    isReversed={true}
    items={[
        { 
          title: 'Data-Driven Visibility', 
          description: 'Your craft belongs on the global stage. We ensure your business is algorithmically favored in English search results, focusing on the specific semantic triggers used by affluent tourists from the US, EU, and Australia.', 
          icon: 'tabler:chart-arrows-vertical' 
        },
        { 
          title: 'Zero Operational Friction', 
          description: 'We protect your staff from linguistic chaos. Our systems deliver operational-level data precision, requiring zero English training for your domestic team while providing a native experience for the guest.', 
          icon: 'tabler:user-check' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">A Legacy of Excellence</h3>
      <p class="text-lg text-muted">Whether you are a boutique service provider or a flagship establishment, your digital infrastructure is your most valuable asset. It is where your global reputation is born. We take that responsibility seriously, ensuring your site is fast, secure, and strategically sound.</p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=800&q=80" alt="High Performance Systems" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  
</Layout>
