---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: 'グランドリフォーム | Hanei JP', 
  description: '既存のWebサイトに対する、抜本的な最新化と高パフォーマンス化。',
};

const pricingData = {
  title: 'グランドリフォーム',
  subtitle: 'デジタル上の存在感を劇的に蘇らせます',
  price: '158,500',
  period: '一括投資',
  items: [
    { description: '限界突破のパフォーマンス注入（超高速化）' },
    { description: 'モダンで洗練されたデザインへの刷新' },
    { description: 'モバイルファーストの徹底的な最適化' },
    { description: 'セキュリティ強化とSEOクリーンアップ' },
    { description: '48時間での納品保証' },
  ],
  callToAction: { target: '_self', text: '今すぐグランドリフォームを開始する', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="サービス1：グランドリフォーム（Grand Reform）"
    title='グランドリフォーム（全面改修）——あなたの<br/><span class="text-accent">デジタル上の存在感</span>を劇的に蘇らせます。'
    subtitle="活気ある素晴らしいお店の魅力を、「疲れ切った（古びた）」Webサイトで台無しにしないでください。既存のWebサイトを圧倒的なスピードで全面改修し、わずか48時間で洗練されたモダンなデザイン、最高水準のパフォーマンス、そして世界に通用する信頼性を注入します。"
    actions={[{ variant: 'primary', text: 'グランドリフォームを開始する', href: '/contact-jp' }]}
    image={{ src: 'https://images.unsplash.com/photo-1573416264252-834d212583ab?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NjV8fGphcGFuZXNlJTIwZm9vZHxlbnwwfHwwfHx8Mg%3D%3D', alt: 'Japanese Culinary Excellence' }}
  />
  
  <!-- THE PROBLEM -->
  <Content
    isReversed={false}
    items={[
        { title: '実店舗との「見栄えのギャップ」', description: '実際のお店は美しく手入れされているのに、Webサイトのデザインは10年以上前のまま時が止まっている。', icon: 'tabler:alert-triangle' },
        { title: '高い直帰率（すぐに離脱される）', description: '興味を持ったお客様がリンクをクリックしても、古めかしいデザインを見た瞬間に、より「今風の」競合店へと数秒で離脱してしまう。', icon: 'tabler:trending-down' },
        { title: 'スマホでの見づらさ', description: 'スマートフォンで文字が読みにくい、操作しづらい場合、現代の旅行者の90%から「存在しない」ものとして扱われてしまいます。', icon: 'tabler:device-mobile-off' },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">あなたのWebサイトは「デジタルのゴーストタウン」になっていませんか？</h3>
      <p class="text-lg text-muted mb-4">
        Webサイトはあるものの、実際に集客の役に立っているでしょうか？多くの日本の経営者が、何年も前に作られた「デジタル上の足かせ」を抱えています。表示が遅く、操作性が悪く、海外のお客様に胸を張って見せられないようなサイトです。
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Haneiの「グランドリフォーム」は、単なる「表面的なお直し」ではありません。現在のサイトを、高収益を生み出す高性能エンジンへと再起動させます。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1628652337240-80d1ed549f47?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTIxfHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Elegant Sushi Presentation" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- FEATURES -->
  <Content
    isReversed={true}
    items={[
        { title: '1. 限界突破のパフォーマンス注入（超高速化）', description: 'サイトを遅くしている無駄な要素を排除し、画像とプログラムを最適化。「一瞬で表示される」感動をお客様にお届けします。わずか2日間でリフォームを完了させます。', icon: 'tabler:bolt' },
        { title: '2. モダンで洗練されたデザインへの刷新', description: '時代遅れのレイアウトを、クリーンでインパクトのあるデザインに置き換えます。美しい写真と上品な文字フォントを最優先し、実際の店舗が持つ「質の高さ」と一致させます。', icon: 'tabler:palette' },
        { title: '3. モバイルファーストの徹底的な最適化', description: 'スマホやタブレットで見ても、まるで高級な「専用アプリ」を操作しているかのような滑らかな使い心地。「今すぐ予約」までの道のりをシンプルにします。', icon: 'tabler:device-mobile' },
        { title: '4. セキュリティ強化とSEOのクリーンアップ', description: 'サイトの基幹部分を最新のセキュリティ基準にアップデート。リンク切れや古いメタデータを修正し、Googleに対して「現在も活発に営業している」ことを明確に伝えます。', icon: 'tabler:shield-check' },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">圧倒的な機能：<br/>完全なる生まれ変わり</h3>
    </Fragment>
  </Content>

  <!-- TOURIST READY SUITE -->
  <Features2
    title='すべてのプランに含まれる「インバウンド対応スイート」'
    subtitle="インバウンド集客を即座に開始するための必須インフラが標準で付属しています。"
    columns={3}
    items={[
      { title: 'GoogleマップSEO（MEO）', description: '外国人観光客が「近くの〇〇」と検索した際に上位表示させる、1ページの完全英語SEO設定。', icon: 'tabler:circle-check' },
      { title: 'カスタムQRレビューPOP', description: '卓上に置いてGoogleの星5つレビューを促進する、印刷用PDFデータ。', icon: 'tabler:circle-check' },
      { title: '「How-To」ランディングページ', description: '禁煙、お通し、靴を脱ぐルールなどを説明し、入店前の不安を解消するカスタムコンテンツ。', icon: 'tabler:circle-check' },
      { title: 'プロの英語コピーライティング', description: '単なる翻訳ではなく、予約・来店につながる魅力的なビジネス説明文を執筆。', icon: 'tabler:circle-check' },
      { title: '超高速ページ配信ネットワーク', description: 'ローミング通信を利用するモバイルユーザー向けに最適化された高速表示。', icon: 'tabler:circle-check' },
      { title: '最短即日の超高速デプロイ', description: '午前中のご注文で、本日中にWebサイトを公開・稼働させます！', icon: 'tabler:bolt' },
    ]}
  />

  <!-- PRICING -->
  <Pricing 
    id="pricing"
    title="現在のサイトに、本来持つべき強力な集客力を" 
    subtitle="48時間以内の納品を保証します。"
    prices={[pricingData]} 
  />

</Layout>
