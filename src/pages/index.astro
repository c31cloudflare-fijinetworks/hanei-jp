---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Button from '~/components/ui/Button.astro';

const metadata = { 
  title: 'Hanei JP | Inbound Solutions for Local Business', 
  description: 'Helping Japanese local businesses welcome the world. Professional Google Maps SEO, Review Engines, and English infrastructure.' 
};
---
<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="The Elite Standard for Inbound Growth"
    title='Bridge the Gap Between Your <br/><span class="text-accent dark:text-white">Craft and the Global Market.</span>'
    subtitle="Japanese hospitality is world-class, but Kanji-only listings are invisible to 92% of international travelers.<br/><br/>Hanei JP engineers the high-performance digital infrastructure required to convert high-spending tourists into loyal guests. From deep Google Maps SEO and MEO optimization to our signature 'English Hanare' standalone pavilions, we solve the linguistic and technical barriers that hold Japanese businesses back.<br/><br/>We don't just translate; we rewrite your value proposition using the native psychological triggers that global travelers trust."
    actions={[{ variant: 'primary', text: 'Get Started Today', href: '/contact' }, { text: 'View Our Services', href: '#features' }]}
    image={{ src: 'https://images.unsplash.com/photo-1748242790323-477b5eec8486?q=80&w=387&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D', width: 1024, height: 576, alt: 'Japanese Street Scene' }}
  />

  <!-- STATS SECTION -->
  <Stats
    stats={[
      { title: 'Inbound Tourists (2024)', amount: '33M+' },
      { title: 'Search Exclusively in English', amount: '92%' },
      { title: 'Maximum Setup Time', amount: '48 Hrs' },
      { title: 'Monthly Maintenance Fees', amount: '$0' },
    ]}
  />

  <!-- FEATURES SUMMARY -->
  <Features
    id="features"
    title="The Inbound Service Kit Suite"
    subtitle="Four specialized products engineered to bridge the gap between your local expertise and the global market."
    items={[
        { 
          title: '1-Page Welcome', 
          description: 'The foundation of your global presence. Professional Maps SEO combined with a visual-first digital guidance annex to eliminate entry anxiety.', 
          icon: 'tabler:map-pin',
          callToAction: { variant: 'primary', text: 'Explore 1-Page Welcome', href: '/one-page-welcome' }
        },
        { 
          title: 'Review Engine', 
          description: 'Automate your social proof. Capture authentic English reviews effortlessly through a beautiful, custom-branded digital landing page.', 
          icon: 'tabler:message-star',
          callToAction: { variant: 'primary', text: 'Explore Review Engine', href: '/review-engine' }
        },
        { 
          title: 'English Hanare', 
          description: 'A detached digital pavilion. Build a world-class English web asset without ever touching your fragile legacy Japanese code.', 
          icon: 'tabler:layers-intersect',
          callToAction: { variant: 'primary', text: 'Explore English Hanare', href: '/english-hanare' }
        },
        { 
          title: 'Grand New or Grand Reform', 
          description: 'Total digital transformation. Choose a high-speed Reform of your existing site or a bilingual New Opening built from scratch.', 
          icon: 'tabler:rocket',
          callToAction: { variant: 'primary', text: 'Explore Grand Options', href: '/grand-opening' }
        },
    ]}
  />

  <!-- SERVICE 1: WELCOME KIT -->
  <Content
    isReversed={false}
    tagline="Service #1: 1-Page Welcome"
    title="Break the 'Information Barrier' and Attract Affluent Guests."
    items={[
        { title: 'Google Maps (MEO) SEO', description: 'We translate your value proposition using native psychological triggers to dominate local search and capture tourists nearby.', icon: 'tabler:map-pin' },
        { title: 'Visual-First Guidance', description: 'A frictionless digital manual explaining your rules and ordering systems to completely eliminate entry anxiety.', icon: 'tabler:eye' },
        { title: 'Custom QR Assets', description: 'Premium, print-ready QR stands to drive immediate engagement right from the table.', icon: 'tabler:qrcode' },
    ]}
    image={{ src: 'https://plus.unsplash.com/premium_photo-1722897350877-31cbfde8af2a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1yZWxhdGVkfDI0fHx8ZW58MHx8fHx8', alt: 'Authentic Japan Experience' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">The Visibility Gap</span>
      </h3>
      <p class="text-muted text-lg mb-6">You offer world-class hospitality, but to the international traveler, you might be invisible. Our infrastructure removes the friction of discovery, ensuring your business is found, understood, and trusted before they even arrive.</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="Explore 1-Page Welcome" href="/one-page-welcome" />
    </Fragment>
  </Content>

  <!-- SERVICE 2: REVIEW ENGINE -->
  <Content
    isReversed={true}
    tagline="Service #2: Review Engine"
    title="Visualize Absolute Trust with a Frictionless Review Experience."
    items={[
        { title: 'Custom Branded Review Page', description: 'A premium digital red carpet. Guests scan your code and land on a beautiful, custom-branded review page tailored to your business.', icon: 'tabler:palette' },
        { title: 'The Live Wall of Fame', description: 'Our custom website widgets pull your best reviews into a beautiful, scrolling display to instantly prove your excellence.', icon: 'tabler:stars' },
        { title: 'Frictionless 3-Click Flow', description: 'No apps to download and no complicated logins. We optimize the mobile journey so leaving a 5-star review takes less than 15 seconds.', icon: 'tabler:pointer' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1565117661210-fd54898de423?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8OXx8amFwYW5lc2UlMjB0ZWF8ZW58MHx8MHx8fDI%3D', alt: 'Serving Japanese Tea' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">Automated Trust</span>
      </h3>
      <p class="text-muted text-lg mb-6">The "Invisible Gap" is the space between a guest’s happiness and their public feedback. We automate this process, turning your silent satisfied majority into a loud, global megaphone.</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="Explore the Review Engine" href="/review-engine" />
    </Fragment>
  </Content>

  <!-- SERVICE 3: ENGLISH HANARE -->
  <Content
    isReversed={false}
    tagline="Service #3: English Hanare"
    title="Global Expansion Without Breaking Your Legacy Code."
    items={[
        { title: 'The "Hanare" Concept', description: 'Like a detached guest pavilion in Japanese architecture, we build a modern, high-speed digital space exclusively for your international guests.', icon: 'tabler:home' },
        { title: 'Zero-Touch Integration', description: 'We don\'t need your passwords or FTP access. Through advanced DNS routing, your current Japanese site remains 100% untouched.', icon: 'tabler:lock' },
        { title: 'Inbound-Optimized SEO', description: 'Engineered from the ground up to rank for the exact English search terms tourists use when exploring your city, capturing high-intent organic traffic.', icon: 'tabler:search' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MjEzfHxqYXBhbmVzZSUyMGJ1c2luZXNzfGVufDB8fDB8fHwy', alt: 'Modern Japanese Business' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">Zero-Risk Architecture</span>
      </h3>
      <p class="text-muted text-lg mb-6">Many businesses are terrified of adding English to their site because one wrong click by a developer could crash their entire legacy Japanese system. Our decoupled architecture bypasses this fear entirely.</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="Explore the English Hanare" href="/english-hanare" />
    </Fragment>
  </Content>

  <!-- SERVICE 4: GRAND OPENING -->
  <Content
    isReversed={true}
    tagline="Service #4: Grand New or Grand Reform"
    title="Demolish Technical Debt. Launch Your Digital Flagship."
    items={[
        { title: '48-Hour Velocity', description: 'We use a proprietary edge-framework to reboot your entire digital presence in a single weekend. No more waiting months for an agency.', icon: 'tabler:clock' },
        { title: 'Grand Reform', description: 'A total high-speed overhaul and modern aesthetic facelift for your existing site, injecting elite performance and SEO cleanup.', icon: 'tabler:tool' },
        { title: 'Grand New Opening', description: 'A fully synchronized, dual-language digital flagship built from scratch. Culturally resonant Japanese combined with conversion-optimized Western English.', icon: 'tabler:rocket' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1577016029703-cc22a7c0c28c?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NXx8amFwYW5lc2UlMjB0ZWF8ZW58MHx8MHx8fDI%3D', alt: 'Premium Japanese Experience' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">Total Transformation</span>
      </h3>
      <p class="text-muted text-lg mb-6">If your site takes more than 3 seconds to load, affluent travelers will assume your service is equally outdated. We build high-performance digital landmarks from the ground up.</p>
      <Button class="mb-8 sm:mb-12 bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 shadow-md font-bold transition-transform hover:-translate-y-0.5" text="Explore Grand Options" href="/grand-opening" />
    </Fragment>
  </Content>

  <!-- STEPS: THE PROCESS -->
  <div id="process" class="scroll-mt-20">
    <Steps2
      isReversed={false}
      title="The Path to Global Success"
      subtitle="We handle the heavy lifting. You focus on the hospitality. Here is how we launch your inbound infrastructure."
      items={[
        { title: '01. The Inbound Audit', description: 'We analyze your current visibility, finding the gaps where you are losing foreign customers.', icon: 'tabler:search' },
        { title: '02. Rapid Implementation', description: 'Our boutique studio builds your assets, optimizes your profiles, and deploys your custom tools—often in just 24 to 48 hours.', icon: 'tabler:bolt' },
        { title: '03. Welcome the World', description: 'Start receiving verified, confident, and well-informed international guests immediately while our systems manage your reputation on autopilot.', icon: 'tabler:world' },
      ]}
      image={{ src: 'https://images.unsplash.com/photo-1769321309340-6c723c65747a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTk3fHxqYXBhbmVzZSUyMGJ1c2luZXNzfGVufDB8fDB8fHwy', alt: 'Japanese Hospitality' }}
    />
  </div>

  <!-- TOURIST READY SUITE -->
  <Features2
    title='Every Plan Includes the "Tourist-Ready" Suite:'
    subtitle="Built-in infrastructure to ensure you start capturing inbound traffic immediately."
    columns={3}
    items={[
      { title: 'Google Maps SEO (MEO)', description: '1-page full English SEO setup to ensure you appear when tourists search "near me."', icon: 'tabler:circle-check' },
      { title: 'Custom QR Review Assets', description: 'Print-ready PDFs for your tables to drive 5-star Google reviews.', icon: 'tabler:circle-check' },
      { title: 'The "How-To" Landing Page', description: 'Custom content explaining your rules (No smoking, cover charges, shoe policy) to remove the Anxiety of Entry.', icon: 'tabler:circle-check' },
      { title: 'Professional English Copywriting', description: "We don't just translate; we write high-converting business descriptions.", icon: 'tabler:circle-check' },
      { title: 'Super-High-Speed Network', description: 'Optimized for mobile users on roaming data so your site loads instantly.', icon: 'tabler:circle-check' },
      { title: 'Same-Day Lightning Fast Deployment', description: 'Order before lunch, and we launch your website today!', icon: 'tabler:bolt' },
    ]}
  />

  <!-- FAQS -->
  <FAQs
    title="Frequently Asked Questions"
    items={[
        { title: 'Do I need to speak English to use these services?', description: 'No. Our systems are designed to communicate in native English to your guests, providing clear visual guidance and automated follow-ups so your staff can focus on service, not translation.', icon: 'tabler:messages-off' },
        { title: 'Is this a monthly subscription?', description: 'Most of our core products (like the Hanare and Welcome Kit) are one-time CapEx investments. You pay once for the infrastructure. Services like the Review Engine carry a small monthly support fee for ongoing cloud filtering and widgets.', icon: 'tabler:coin' },
        { title: 'What is Hanei JP?', description: 'We are a boutique inbound technology studio. We specialize in solving linguistic, psychological, and technical risks for Japanese businesses expanding into the global tourist market.', icon: 'tabler:building-bridge' },
        { title: 'How long does the setup process take?', description: 'We pride ourselves on extreme velocity. Products like the Welcome Kit or Review Engine are deployed in under 24 hours. Even a full "Grand Opening" site reboot is guaranteed within 48 hours.', icon: 'tabler:bolt' },
    ]}
    callToAction={{ variant: 'primary', text: 'View All FAQs', href: '/faq' }}
  />
</Layout>
