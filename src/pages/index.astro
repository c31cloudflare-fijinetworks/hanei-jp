---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = { title: 'Hanei Inbound Digital | High-Visibility Marketing for Japan' };
---
<Layout metadata={metadata}>
  
  <Hero2
    tagline="Hanei Inbound Marketing Hubs"
    title='Connect Your Business with <br/><span class="text-accent dark:text-white">Local and Global Customers.</span>'
    subtitle="We deploy Premium Marketing Hubs and Reputation Engines that drive customer growth and establish authority. Get your new digital identity ready to attract new guests in just 24~48 hours."
    actions={[
      { variant: 'primary', text: 'View Marketing Tiers', href: '#services' },
      { text: 'Custom Strategy', href: '/contact', class: '!bg-orange-600 !text-white !border-none hover:!bg-orange-700' },
    ]}
    image={{ src: '/images/hanei-media/033.webp', alt: 'Japanese Street' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />

  <Stats
    classes={{ container: 'pt-0 md:pt-0 pb-12' }}
    stats={[
      { title: 'Full Brand Setup', amount: '100%' }, 
      { title: 'Zero Programming Needed', amount: '0' }, 
      { title: 'Launch Speed', amount: '48 Hrs' }, 
      { title: 'Subscription Fees', amount: '$0' }
    ]} 
  />

  <Content 
    id="services"
    tagline="Service: Inbound Welcome Page" 
    title="Make it Easy for New Customers to Find and Choose You." 
    subtitle="We create a high-conversion digital guide that explains your shop rules, menus, and services clearly. This strategic asset helps both local residents and travelers feel comfortable walking through your door. Clear marketing removes the confusion that stops people from entering a new shop." 
    callToAction={{ text: 'View 1-Page Package', href: '/one-page-welcome' }} 
    image={{ src: '/images/demos/capsule-hotel.webp', alt: 'Welcome' }} 
  />

  <Content 
    isReversed={true} 
    tagline="Service: Reputation & Visibility Engine" 
    title="Build Instant Trust with an Automated Wall of Reviews." 
    subtitle="Showcase your best customer feedback directly on your site to prove your quality. We deploy an automated system that encourages happy guests to leave 5-star reviews on Google. Inbound reputation is the most powerful way to convince new people to visit your business." 
    callToAction={{ text: 'View Reputation Engine', href: '/review-engine' }} 
    image={{ src: '/images/review_engine/testimonial-6.webp', alt: 'Review' }} 
  />

  <Content 
    isReversed={false} 
    tagline="Service: Global Reach Expansion" 
    title="Add a Professional English Section to Your Current Presence." 
    subtitle="Build a dedicated marketing hub for international guests without changing your existing Japanese content. This is the fastest way to attract global customers while keeping your current assets safe. We handle all translation and strategic layout so you can focus on your craft." 
    callToAction={{ text: 'View English Package', href: '/english-hanare' }} 
    image={{ src: '/images/demos/azabu-medical.webp', alt: 'Hanare' }} 
  />

  <Content 
    isReversed={true} 
    tagline="Service: Brand Modernization & Launch" 
    title="Modernize Your Presence with a Total Brand Reboot." 
    subtitle="We reboot your existing presence or deploy a brand new professional marketing site in a single weekend. A modern, high-quality design ensures your business looks perfect on mobile phones and stands out from competition. We deliver a digital home designed to win more customers." 
    callToAction={{ text: 'View Launch Options', href: '/grand-opening' }} 
    image={{ src: '/images/hanei-media/021.webp', alt: 'Reboot' }} 
  />

  <Content 
    isReversed={false} 
    tagline="Community Mission" 
    title="Strategic Support for Local Japanese Charities." 
    subtitle="We provide high-quality creative marketing support for local NPOs and essential community services in Japan, free of charge. Our goal is to help those helping our neighborhoods look professional online. Your mission deserves a great digital presence, and we are proud to deploy it for you." 
    callToAction={{ text: 'Learn About Our Mission', href: '/community-mission' }} 
    image={{ src: '/images/hanei-media/031.webp', alt: 'NPO' }} 
  />

  <FAQs 
    title="Common Questions" 
    classes={{ container: 'pt-8 md:pt-12' }} 
    items={[
      { title: 'Do I need to be a technical expert?', description: 'No. Our marketing hubs are designed to communicate perfectly to guests while giving you and your staff clear results without needing any IT knowledge.' }, 
      { title: 'How long does deployment take?', description: 'We offer a 24-hour turnaround for small packages and 48 hours for full brand reboots.' }, 
      { title: 'Are there hidden monthly fees?', description: 'No. Our services are one-time marketing investments. We believe in helping you own your digital presence without ongoing subscription costs.' }, 
      { title: 'Will you change my existing website code?', description: 'No. We deploy your new pages as a detached marketing system. This keeps your current site safe while adding new high-visibility features.' }
    ]} 
    callToAction={{ variant: 'primary', text: 'View All FAQs', href: '/faq' }} 
  />
</Layout>
