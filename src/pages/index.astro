---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Button from '~/components/ui/Button.astro';

const metadata = { 
  title: 'Hanei JP | Inbound Solutions for Local Business', 
  description: 'Helping Japanese local businesses welcome the world. Professional Google Maps SEO, Review Engines, and English infrastructure.' 
};
---
<Layout metadata={metadata}>
  
  <!-- HERO SECTION: Trimmed for perfect Review-Engine balance -->
  <Hero2
    tagline="The Elite Standard for Inbound Growth"
    title='Bridge the Gap Between Your <br/><span class="text-accent dark:text-white">Craft and the Global Market.</span>'
    subtitle="Stop losing high-spending international guests. We build the high-performance digital infrastructure required to convert global travelers into loyal customers—all in 48 hours."
    actions={[{ variant: 'primary', text: 'Get Started Today', href: '/contact' }, { text: 'View Our Services', href: '#features' }]}
    image={{ src: 'https://images.unsplash.com/photo-1748242790323-477b5eec8486?q=80&w=387&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D', width: 611, height: 405, alt: 'Japanese Street Scene' }}
  />

  <Stats
    stats={[
      { title: 'Done-For-You Setup', amount: '100%' },
      { title: 'Tech Skills Required', amount: '0' },
      { title: 'Maximum Setup Time', amount: '48 Hrs' },
      { title: 'Monthly Fees', amount: '$0' },
    ]}
  />

  <!-- SERVICE KIT SUMMARY -->
  <Features
    id="features"
    title="The Inbound Service Kit Suite"
    subtitle="Four specialized products engineered to bridge the gap between local expertise and the global market."
    items={[
        { title: '1-Page Welcome', description: 'Professional Google Maps SEO and visual-first guidance to eliminate entry anxiety.', icon: 'tabler:map-pin', callToAction: { variant: 'primary', text: 'Explore 1-Page Welcome', href: '/one-page-welcome' } },
        { title: 'Review Engine', description: 'Capture authentic 5-star English reviews effortlessly through custom digital landing pages.', icon: 'tabler:message-star', callToAction: { variant: 'primary', text: 'Explore Review Engine', href: '/review-engine' } },
        { title: 'English Hanare', description: 'A world-class English web asset for your business without touching your legacy Japanese code.', icon: 'tabler:layers-intersect', callToAction: { variant: 'primary', text: 'Explore English Hanare', href: '/english-hanare' } },
        { title: 'Grand New or Reform', description: 'Total transformation. High-speed Reform of your current site or a dual-language site from scratch.', icon: 'tabler:rocket', callToAction: { variant: 'primary', text: 'Explore Grand Options', href: '/grand-opening' } },
    ]}
  />

  <!-- INDIVIDUAL SERVICE SECTIONS: Balanced vertically -->
  <Content
    isReversed={false}
    tagline="Service #1"
    title="Dominate Local Search and Eliminate Entry Anxiety."
    items={[
        { title: 'Google Maps (MEO) SEO', description: 'We translate your value proposition using the triggers global travelers trust.', icon: 'tabler:map-pin' },
        { title: 'Visual-First Guidance', description: 'Remove the friction of discovery with a frictionless digital manual for your guests.', icon: 'tabler:eye' },
    ]}
    image={{ src: 'https://plus.unsplash.com/premium_photo-1722897350877-31cbfde8af2a?w=611&h=405&auto=format&fit=crop', alt: 'Authentic Japan Experience' }}
  />

  <Content
    isReversed={true}
    tagline="Service #2"
    title="Automate Trust with a Live Wall of Fame."
    items={[
        { title: 'Branded Review Pages', description: 'A premium digital red carpet for your satisfied international guests.', icon: 'tabler:palette' },
        { title: 'Frictionless 3-Click Flow', description: 'Leaving a 5-star review takes less than 15 seconds—no apps required.', icon: 'tabler:pointer' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1565117661210-fd54898de423?w=611&h=405&auto=format&fit=crop', alt: 'Serving Japanese Tea' }}
  />

  <!-- ORDER FLOW -->
  <div id="process" class="scroll-mt-20">
    <Steps2
      title="4 Simple Steps to Global Success"
      subtitle="No technical skills or English required. We do all the heavy lifting."
      items={[
        { title: '01. Pick Your Plan', description: 'Choose your package and securely order online.', icon: 'tabler:number-1' },
        { title: '', description: '', icon: 'tabler:arrow-down' },
        { title: '02. Share Your Info', description: "Fill out a short form with your details. No passwords needed.", icon: 'tabler:number-2' },
        { title: '', description: '', icon: 'tabler:arrow-down' },
        { title: '03. We Build It', description: 'We design and set up everything in as little as 24 hours.', icon: 'tabler:number-3' },
        { title: '', description: '', icon: 'tabler:arrow-down' },
        { title: '04. Grow Your Business', description: 'Welcome international guests and watch your ratings skyrocket.', icon: 'tabler:number-4' }
      ]}
      image={{ src: 'https://images.unsplash.com/photo-1769321309340-6c723c65747a?w=611&h=405&auto=format&fit=crop', alt: 'Japanese Hospitality' }}
    />
  </div>

  <FAQs
    title="Frequently Asked Questions"
    items={[
        { title: 'Do I need to speak English?', description: 'No. Our systems are designed to communicate natively to your guests while giving you clear instructions in Japanese.' },
        { title: 'How long does setup take?', description: 'We guarantee a 24-hour turnaround for Kits and a 48-hour reboot for full websites.' },
    ]}
    callToAction={{ variant: 'primary', text: 'View All FAQs', href: '/faq' }}
  />
  <CallToAction title="About Hanei" subtitle="Hanei is dedicated to empowering Japanese local businesses. We believe that Japan’s local culture is its greatest asset, and we use modern technology to ensure that the world can experience it—without the stress of the language barrier." />
</Layout>
