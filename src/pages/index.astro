---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Button from '~/components/ui/Button.astro';

const metadata = { 
  title: 'Hanei JP | Inbound Solutions for Local Business', 
  description: 'Helping Japanese local businesses welcome the world. Professional Google Maps SEO, Review Engines, and English infrastructure.' 
};
---
<Layout metadata={metadata}>
  
  <Hero2
    tagline="The Elite Standard for Inbound Growth"
    title='Bridge the Gap Between Your <br/><span class="text-accent dark:text-white">Craft and the Global Market.</span>'
    subtitle="Stop losing high-spending international guests. We build the high-performance digital infrastructure required to convert global travelers into loyal customers—all in 48 hours."
    actions={[{ variant: 'primary', text: 'Get Started Today', href: '/contact' }, { text: 'View Our Services', href: '#features' }]}
    image={{ src: 'https://images.unsplash.com/photo-1748242790323-477b5eec8486?q=80&w=387&auto=format&fit=crop', alt: 'Japanese Street' }}
  />

  <Stats
    stats={[
      { title: 'Done-For-You Setup', amount: '100%' },
      { title: 'Tech Skills Required', amount: '0' },
      { title: 'Maximum Setup Time', amount: '48 Hrs' },
      { title: 'Monthly Fees', amount: '$0' },
    ]}
  />

  <Features
    id="features"
    title="The Inbound Service Kit Suite"
    subtitle="Four specialized products engineered to bridge the gap between local expertise and the global market."
    items={[
        { title: '1-Page Welcome', description: 'Professional Maps SEO combined with visual guidance to eliminate entry anxiety.', icon: 'tabler:map-pin', callToAction: { text: 'Explore 1-Page Welcome', href: '/one-page-welcome' } },
        { title: 'Review Engine', description: 'Automate social proof. Capture authentic English reviews effortlessly.', icon: 'tabler:message-star', callToAction: { text: 'Explore Review Engine', href: '/review-engine' } },
        { title: 'English Hanare', description: 'A detached digital pavilion for your business without touching legacy code.', icon: 'tabler:layers-intersect', callToAction: { text: 'Explore English Hanare', href: '/english-hanare' } },
        { title: 'Grand New or Reform', description: 'Total transformation. High-speed Reform or a dual-language site from scratch.', icon: 'tabler:rocket', callToAction: { text: 'Explore Grand Options', href: '/grand-opening' } },
    ]}
  />

  <Content
    isReversed={false}
    tagline="Service #1"
    title="Dominate Local Search and Eliminate Entry Anxiety."
    subtitle="Remove the friction of discovery with a frictionless digital manual for your guests."
    callToAction={{ text: 'Explore 1-Page Welcome', href: '/one-page-welcome' }}
    image={{ src: 'https://plus.unsplash.com/premium_photo-1722897350877-31cbfde8af2a?w=611&h=405&auto=format&fit=crop', alt: 'Welcome' }}
  />

  <Content
    isReversed={true}
    tagline="Service #2"
    title="Automate Trust with a Live Wall of Fame."
    subtitle="A premium digital red carpet for your satisfied international guests."
    callToAction={{ text: 'Explore Review Engine', href: '/review-engine' }}
    image={{ src: 'https://images.unsplash.com/photo-1565117661210-fd54898de423?w=611&h=405&auto=format&fit=crop', alt: 'Review' }}
  />

  <div id="process" class="scroll-mt-20">
    <Steps2
      title="How to Get Started"
      subtitle="The path to global success is only 4 simple steps away."
      items={[
        { title: '01. Pick Your Plan', description: 'Choose the package that fits your needs.', icon: 'tabler:number-1' },
        { title: '', description: '', icon: 'tabler:arrow-down' },
        { title: '02. Share Your Info', description: "Fill out a simple form. No passwords needed.", icon: 'tabler:number-2' },
        { title: '', description: '', icon: 'tabler:arrow-down' },
        { title: '03. We Build It', description: 'We design and set up everything in 24 to 48 hours.', icon: 'tabler:number-3' },
        { title: '', description: '', icon: 'tabler:arrow-down' },
        { title: '04. Grow Your Business', description: 'Welcome guests and watch your ratings skyrocket.', icon: 'tabler:number-4' }
      ]}
      image={{ src: 'https://images.unsplash.com/photo-1769321309340-6c723c65747a?w=611&h=405&auto=format&fit=crop', alt: 'Success' }}
    />
  </div>

  <FAQs
    title="Frequently Asked Questions"
    classes={{ container: 'pt-8 md:pt-12' }}
    items={[
        { title: 'Do I need to speak English?', description: 'No. Our systems are designed to communicate natively to your guests while giving you clear instructions in Japanese.' },
        { title: 'How long does setup take?', description: 'We guarantee a 24-hour turnaround for Kits and a 48-hour reboot for full websites.' },
        { title: 'Is it really a one-time payment?', description: 'Yes. Most core services are one-time investments. Only specific maintenance tools carry a small monthly fee.' },
        { title: 'Will you touch my existing site?', description: 'No. Using our Hanare architecture, we build your assets on independent subdomains to keep your site 100% safe.' },
    ]}
    callToAction={{ variant: 'primary', text: 'View All FAQs', href: '/faq' }}
  />
</Layout>
