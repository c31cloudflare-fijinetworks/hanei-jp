---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = { title: 'Order Confirmed | Welcome to Hanei JP' };
---

<Layout metadata={metadata}>
  <Hero2
    tagline="Order Successful"
    title='Welcome to the <br/><span class="text-accent">Elite Standard.</span>'
    subtitle="Your payment has been secured. We are now ready to architect your digital asset. Please follow the instructions below to complete your onboarding."
    image={{ src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&auto=format&fit=crop', alt: 'Project Start' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />

  <Content
    isReversed={false}
    title="Next Step: Upload Your Assets"
    subtitle="To deliver your site within the next 24-48 hours, our developers need your high-resolution photos, menu/service lists, and branding assets. Click the button below to access your secure project folder."
    callToAction={{ text: 'Upload Business Assets', href: '/contact', variant: 'primary' }}
    image={{ src: 'https://images.unsplash.com/photo-1576675466969-38eeae4b41f6?w=1200&auto=format&fit=crop', alt: 'Data Upload' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold mb-4">What happens now?</h3>
      <ul class="space-y-4 text-muted text-lg">
        <li class="flex items-center gap-2"><Icon name="tabler:circle-check" class="w-5 h-5 text-green-500" /> You will receive an automated receipt via email.</li>
        <li class="flex items-center gap-2"><Icon name="tabler:circle-check" class="w-5 h-5 text-green-500" /> A Hanei developer will contact you via text/email within 2 hours.</li>
        <li class="flex items-center gap-2"><Icon name="tabler:circle-check" class="w-5 h-5 text-green-500" /> Your preview link will be ready for review by tomorrow.</li>
      </ul>
    </Fragment>
  </Content>
</Layout>
