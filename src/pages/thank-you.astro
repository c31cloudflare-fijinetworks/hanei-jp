---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import OnboardingForm from '~/components/widgets/OnboardingForm.astro';

const metadata = { 
    title: 'Order Confirmed | Welcome to Hanei JP',
    robots: { index: false }
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="Payment Successful"
    title='Welcome to the <br/><span class="text-accent">Elite Standard.</span>'
    subtitle="Your business asset has been secured. To maintain our delivery standard of 24-72 hours, please complete the master onboarding form below. Our developers will begin production immediately upon receipt."
    image={{ src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&auto=format&fit=crop&q=80', alt: 'Project Activation' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />

  <OnboardingForm />
</Layout>
