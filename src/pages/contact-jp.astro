---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { title: 'お問い合わせ/特殊案件 | Hanei JP' };

const jpLabels = {
    title: "お問い合わせフォーム",
    client_name: "お名前",
    company_name: "貴社名",
    email: "メールアドレス",
    address: "所在地・住所",
    request_type: "ご依頼の種別",
    project_summary: "お問い合わせ・ご依頼内容の詳細",
    budget_range: "ご予算感",
    deadline: "希望納期",
    referral: "当社を知ったきっかけ",
    submit: "送信する"
};

const jpOptions = {
    requests: ["一般的なお問い合わせ", "独自システム開発", "API・外部連携", "レガシー移行", "その他"],
    budgets: ["未定・該当なし", "100万円 - 300万円", "300万円 - 500万円", "500万円以上"],
    timelines: ["至急 (最短当日)", "明日まで", "今週中", "1週間以内", "その他"],
    referrals: ["Google検索", "SNS", "知人の紹介", "その他"]
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="お問い合わせ"
    title='ビスポーク・ソリューション & <br/><span class="text-accent">一般お問い合わせ</span>'
    subtitle="技術的な難題から日常的なご質問まで、幅広く承ります。ブティックならではの柔軟な対応で、お客様の課題解決をサポートします。"
    image={{ src: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=611&h=405&auto=format&fit=crop', alt: 'Contact' }}
  />
  <BespokeForm labels={jpLabels} options={jpOptions} />
</Layout>
