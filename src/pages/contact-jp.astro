---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { 
  title: 'お問い合わせ | Hanei JP',
  description: 'オーダーメイドのデジタルソリューションに関するご相談。すべてのお問い合わせに対し、当日中の返信を保証しております。'
};

const jpLabels = {
    title: "制作・パートナーシップのご相談",
    description: "プロジェクトのご相談や技術的なアドバイスなど、お気軽にお問い合わせください。プロフェッショナルなお問い合わせに対し、当日中の返信を保証しております。",
    client_name: "お名前",
    company_name: "貴社名・店名",
    email: "メールアドレス",
    request_type: "ご依頼の種別",
    project_summary: "お問い合わせ・ご依頼内容の詳細",
    budget_range: "ご予算感",
    deadline: "希望納期",
    submit: "相談内容を送信する",
    sending: "送信中...",
    success_title: "送信が完了しました",
    success_message: "お問い合わせ内容を正常に受け付けました。<br/>24時間以内に担当者より返信をお約束いたします。"
};

const jpOptions = {
    requests: [
      "1ページ・ビジネスサイト", 
      "レビューエンジン", 
      "英語専用デジタル別館", 
      "グランド・リフォーム (既存サイト刷新)", 
      "グランド・ニュー (新規サイト制作)", 
      "一般的なお問い合わせ", 
      "独自システム開発 / API", 
      "その他"
    ],
    budgets: ["該当なし・未定", "10万円 - 30万円", "30万円 - 50万円", "50万円 - 100万円", "100万円以上"],
    timelines: ["至急 (最短当日)", "今週中", "1ヶ月以内", "時期未定・相談", "その他"],
    referrals: ["Google検索", "SNS", "知人の紹介", "その他"]
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="Hanei JPへのお問い合わせ"
    title='貴社のデジタルの未来を、<br/><span class="text-accent">共に構築しましょう。</span>'
    subtitle="迅速な1ページ制作から、複雑な独自インフラの構築まで。すべてのお問い合わせに対し、当日中の返信を保証しております。"
    image={{ src: '/images/demos/capsule-hotel.webp', alt: 'プロフェッショナルな打ち合わせ' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />
  
  <BespokeForm 
    labels={jpLabels} 
    options={jpOptions} 
    formAction="https://docs.google.com/forms/d/e/1FAIpQLSetNa1Mq_nYvkKp5h2fUIPZFRCvfFs5hvcYoawFk1eX0p6t3w/formResponse"
    ids={{
      name: "entry.1770250121",
      company: "entry.1744957567",
      category: "entry.491532461",
      budget: "entry.1285777990",
      timeline: "entry.1375463449",
      summary: "entry.1193708562"
    }}
  />
</Layout>
