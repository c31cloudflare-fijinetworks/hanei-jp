---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BespokeForm from '~/components/widgets/BespokeForm.astro';

const metadata = { title: 'お問い合わせ/特殊案件 | Hanei JP' };

const jpLabels = {
    title: "制作・パートナーシップのご相談",
    client_name: "お名前",
    company_name: "貴社名・店名",
    email: "メールアドレス",
    address: "所在地・住所",
    request_type: "ご依頼の種別",
    project_summary: "お問い合わせ・ご依頼内容の詳細",
    budget_range: "ご予算感",
    deadline: "希望納期",
    referral: "当社を知ったきっかけ",
    submit: "相談内容を送信する"
};

const jpOptions = {
    requests: ["一般的なお問い合わせ", "独自システム開発", "API・外部連携", "レガシーサイト刷新", "その他"],
    budgets: ["未定・該当なし", "100万円 - 300万円", "300万円 - 500万円", "500万円以上"],
    timelines: ["至急 (最短当日)", "明日まで", "今週中", "1週間以内", "その他"],
    referrals: ["Google検索", "SNS", "知人の紹介", "その他"]
};
---

<Layout metadata={metadata}>
  <Hero2
    tagline="専属スタジオへのアクセス"
    title='日本の価値を、<br/><span class="text-accent">デジタルの「正解」へ。</span>'
    subtitle="迅速な1ページ制作から、複雑な独自インフラの構築まで。Hanei JPは、日本の職人魂と世界基準の技術を繋ぐパートナーです。精密な設計で、貴店の飛躍をサポートします。"
    image={{ src: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=1200&auto=format&fit=crop', alt: 'プロフェッショナルな打ち合わせ' }}
    classes={{ inner: 'pb-4 md:pb-6' }}
  />
  <BespokeForm labels={jpLabels} options={jpOptions} />
</Layout>
