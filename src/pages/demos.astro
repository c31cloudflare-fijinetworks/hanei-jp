---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = { 
  title: 'Gallery of Demos | High-Performance Digital Infrastructure | Hanei JP',
  description: 'Explore our portfolio of high-converting boutique demonstrations for Japanese industries.'
};

const demos = [
  { title: "ZenPod Tokyo", sub: "Luxury capsule hotel concept blending Japanese aesthetics with high-converting flows.", link: "/demos/capsule-hotel", img: "https://images.unsplash.com/photo-1539606420556-14c457c45507?w=1200" },
  { title: "Azabu Medical", sub: "Sophisticated medical facility demonstration highlighting physician-centric booking.", link: "/demos/azabu-medical", img: "https://images.unsplash.com/photo-1631248055158-edec7a3c072b?w=1200" },
  { title: "GINZA KAIZEN", sub: "Premium hair artistry sanctuary featuring English-speaking concierge integration.", link: "/demos/ginza-kaizen", img: "https://images.unsplash.com/photo-1560869713-7d0a29430803?w=1200" },
  { title: "Tokyo Locker & Storage", sub: "High-security luggage solution with tiered security and contactless payment flows.", link: "/demos/tokyo-locker-storage-premium-luggage-solutions", img: "https://images.unsplash.com/photo-1618438502398-195e47778d6c?w=1200" },
  { title: "Kagari Izakaya & Grill", sub: "Luxury gastronomy destination featuring seasonal omakase reservation workflows.", link: "/demos/kagari-izakaya-grill-shinjuku-tokyo-gastronomy", img: "https://images.unsplash.com/photo-1617870314635-fc819547ec11?w=1200" },
  { title: "Shika-An Nara", sub: "Heritage guesthouse experience focused on tranquility and traditional luxury.", link: "/demos/shika-an-nara-luxury-heritage-guesthouse", img: "https://images.unsplash.com/photo-1530708780517-cc640cf05561?w=1200" },
  { title: "Osaka Unseen", sub: "Boutique culinary expeditions and luxury street food tour architecture.", link: "/demos/osaka-unseen-luxury-culinary-expeditions", img: "https://images.unsplash.com/photo-1605582763781-dff23d0f5d32?w=1200" },
  { title: "Takumi Precision", sub: "High-end industrial engineering and component manufacturing demonstration.", link: "/demos/takumi-precision-tokyo-engineering-the-future", img: "https://images.unsplash.com/photo-1757912666361-8c226b7279b9?w=1200" },
  { title: "Omotesando Dental", sub: "Elite dentistry clinic focusing on English-speaking expats and medical safety.", link: "/demos/omotesando-dental", img: "https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1200" },
  { title: "KyoEthereal", sub: "Scholar-led Kyoto temple expeditions and private spiritual journey planning.", link: "/demos/private-kyoto-temple-expeditions", img: "https://images.unsplash.com/photo-1574236170880-fbbca132d83d?w=1200" },
  { title: "Mizu no Kokoro", sub: "Luxury wellness and sento architecture for the high-end Osaka market.", link: "/demos/mizu-no-kokoro-luxury-sento-wellness-osaka", img: "https://images.unsplash.com/photo-1764057146162-64aaea28494a?w=1200" },
  { title: "Kura Tokyo", sub: "Premium luggage concierge and high-security biometric vault storage.", link: "/demos/kura-tokyo-premium-luggage-concierge-secure-storage", img: "https://images.unsplash.com/photo-1756649627237-d367a3e3a311?w=1200" },
  { title: "Kissa & Co.", sub: "Boutique roastery and slow-coffee ritual site for artisanal cafes.", link: "/demos/kissa-co-osaka", img: "https://images.unsplash.com/photo-1453614512568-c4024d13c247?w=1200" },
  { title: "Zen Relocations", sub: "Meticulous white-glove moving services for the international community.", link: "/demos/zen-relocations-japan-relocations", img: "https://images.unsplash.com/photo-1722487631997-cf1e0f92c2c4?w=1200" }
];
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="The Gallery" 
    title='Elite Infrastructure <br/><span class="text-accent">Demonstrations.</span>' 
    subtitle="Explore how we translate high-end craftsmanship into digital performance. Every demo represents our 'Production Perfect' standard for specific industries."
    image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200', alt: 'Hanei Gallery' }}
  />

  <div class="space-y-4">
    {demos.map((demo, index) => (
      <Content 
        isReversed={index % 2 !== 0}
        title={`Portfolio Demo: ${demo.title}`}
        subtitle={demo.sub}
        callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: demo.link }}
        image={{ src: demo.img, alt: demo.title }}
        classes={{ container: 'py-12 md:py-20' }}
      />
    ))}
  </div>
</Layout>
