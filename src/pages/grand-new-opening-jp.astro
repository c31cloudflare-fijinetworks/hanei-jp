---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'グランド・ニューオープン | Hanei JP', 
  description: 'ゼロから構築する、最高級のバイリンガル「デジタル旗艦店」。',
};

const pricingData = {
  title: 'グランド・ニューオープン',
  subtitle: '最高級のバイリンガル「デジタル旗艦店」',
  price: '298,500',
  period: '一括投資',
  items: [
    { description: '「バイリンガル・ファースト」のアーキテクチャ' },
    { description: '最先端のモダンな技術基盤（ヘッドレス）' },
    { description: '「権威性」を最優先したSEO戦略' },
    { description: '富裕層ゲストのための極上のUX（ユーザー体験）' },
    { description: '48時間でゼロからトップクラスへ' },
  ],
  callToAction: { target: '_self', text: 'グランド・ニューオープンの構築を開始する', href: '/contact-jp', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="サービス2：グランド・ニューオープン"
    title='世界を舞台にする、あなたの<br/><span class="text-accent">バイリンガル旗艦店。</span>'
    subtitle="単なる「翻訳されたサイト」で妥協する必要はありません。圧倒的な信頼感と、高単価な外国人観光客の確実なコンバージョンを実現するために設計された、完全な「2か国語対応のデジタル拠点」をゼロから構築します。"
    actions={[{ variant: 'primary', text: '構築を開始する', href: '/contact-jp' }]}
    image={{ src: 'https://images.unsplash.com/photo-1626379907753-406934326e2c?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTI5fHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D', alt: 'Japanese Chef Cooking' }}
  />
  
  <!-- THE MISSION -->
  <Content
    isReversed={false}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">ミッション：公開初日から、<br/>選ばれる「地域ナンバーワン」になる。</h3>
      <p class="text-lg text-muted mb-4">
        地域や業界のトップとしての地位を確立する覚悟を決めた時、ありきたりなWebサイトでは不十分です。あなたに必要なのはデジタルの「旗艦店」です。
      </p>
      <p class="text-lg text-muted mb-6">
        「グランド・ニューオープン」は、一切の妥協を許さない経営者様のためのサービスです。品質、信頼、そして高級感を体現し、世界中の富裕層トラベラーを惹きつける存在感を放ちます。
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        日本語のサイトに無理やり英語を「付け足す」のはもうやめましょう。世界中のすべてのお客様の心に直接響く、ワールドクラスの基盤からスタートする時です。
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1691484466261-cb7557646ffc?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTUyfHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Traditional Japanese Setting" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- FEATURES -->
  <Content
    isReversed={true}
    items={[
        { title: '1. 「バイリンガル・ファースト」の設計', description: '最初から日・英のデュアルエンジンを前提に構築。欧米の旅行者と日本人で心に響く言葉や導線を変え、両方の市場からの予約率を最大化します。', icon: 'tabler:language-hiragana' },
        { title: '2. 最先端のモダンな技術基盤', description: '最新のヘッドレスアーキテクチャを使用。高解像度の4K動画を使用しても、世界中どこからアクセスしても驚異的なスピードで表示されます。', icon: 'tabler:rocket' },
        { title: '3. 「権威性」を最優先したSEO戦略', description: 'アメリカ、ヨーロッパの旅行者が検索する英語キーワードに最適化しつつ、国内向けのローカルSEOも完璧に維持。わずか2日間で立ち上げます。', icon: 'tabler:chart-arrows-vertical' },
        { title: '4. 富裕層ゲストのための極上のUX', description: 'スクロールに合わせた美しい動き、映画のように魅力的なトップ動画、上品な余白を効果的に使い、高価格帯のサービスにふさわしい「高級感」を演出します。', icon: 'tabler:diamond' },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">圧倒的な機能：<br/>グローバルアイコン（憧れの的）の構築</h3>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1754228752210-e41501dd1773?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTg1fHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Luxury Japanese Cuisine" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- TOURIST READY SUITE -->
  <Features2
    title='すべてのプランに含まれる「インバウンド対応スイート」'
    subtitle="インバウンド集客を即座に開始するための必須インフラが標準で付属しています。"
    columns={3}
    items={[
      { title: 'GoogleマップSEO（MEO）', description: '外国人観光客が「近くの〇〇」と検索した際に上位表示させる、1ページの完全英語SEO設定。', icon: 'tabler:circle-check' },
      { title: 'カスタムQRレビューPOP', description: '卓上に置いてGoogleの星5つレビューを促進する、印刷用PDFデータ。', icon: 'tabler:circle-check' },
      { title: '「How-To」ランディングページ', description: '禁煙、お通し、靴を脱ぐルールなどを説明し、入店前の不安を解消するカスタムコンテンツ。', icon: 'tabler:circle-check' },
      { title: 'プロの英語コピーライティング', description: '単なる翻訳ではなく、予約・来店につながる魅力的なビジネス説明文を執筆。', icon: 'tabler:circle-check' },
      { title: '超高速ページ配信ネットワーク', description: 'ローミング通信を利用するモバイルユーザー向けに最適化された高速表示。', icon: 'tabler:circle-check' },
      { title: '最短即日の超高速デプロイ', description: '午前中のご注文で、本日中にWebサイトを公開・稼働させます！', icon: 'tabler:bolt' },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="あなたの新たな時代が、ここから始まります。"
    subtitle="「グランド・ニューオープン」は、単なるWebサイトの制作ではなく、ビジネスの「決意表明」です。市場に参加するだけでなく、市場をリードする存在になりましょう。"
    actions={[
        { variant: 'primary', text: 'グランド・ニューオープンの構築を開始する', href: '/contact-jp' }
    ]}
  >
    <Fragment slot="tagline">グローバルな成長の準備が整った企業様へ贈る、究極のデジタル基盤。</Fragment>
  </CallToAction>

</Layout>
