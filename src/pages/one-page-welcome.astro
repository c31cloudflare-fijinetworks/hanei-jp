---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: '1-Page Business Website | Professional & Fast | Hanei JP',
  description: 'A complete one-page website for your business. Showcase services, menus, and rules. Order by noon, live by the afternoon.'
};

const pricingData = { 
  title: '1-Page Welcome Package', 
  price: '¥19,800', 
  subTitle: 'Project Initiation',
  badge: 'One-time Payment <br/> Ready Today!',
  callToAction: { text: 'ORDER 1-PAGE WEBSITE' },
  items: [
    { description: 'Complete Boutique 1-Page Design' }, 
    { description: 'We setup your Services & Menus' }, 
    { description: 'Super-fast loading on all phones' }, 
    { description: 'Custom QR Code for your shop' },
    { description: 'Launch ready in 24 hours' }
  ]
};
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="Professional. Fast. Effective." 
    title='Your Entire Business <br/><span class="text-accent">on One Professional Page.</span>' 
    subtitle='The fastest way to look professional online. We build a high-quality 1-page website that showcases your services, menus, and house rules. Order by noon, and your site is live by the afternoon.' 
    actions={[{ variant: 'primary', text: 'Get Started', href: '#pricing' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1522623349500-de37a56ea2a5?w=611&h=405&auto=format&fit=crop', alt: 'Professional Business Entry' }} 
  />
  
  <Content 
    isReversed={false} 
    title="01. The Digital Business Manual" 
    subtitle="Replace confusion with clarity. We build a clean digital manual that allows customers to see your service offerings, price lists, and house rules directly on their phones. This removes the stress of explaining details repeatedly to every new guest." 
    items={[{ title: 'Everything in one place', description: 'Rules, menus, and payment methods.', icon: 'tabler:clipboard-list' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1564284369929-026ba231f89b?w=611&h=405&auto=format&fit=crop', alt: 'Digital Menu on Phone' }} 
  />

  <Content 
    id="flagship"
    isReversed={true} 
    tagline="Experience Excellence" 
    title="Portfolio Demo: Tokyo Locker & Storage" 
    subtitle="A premium luggage solutions website. See how we present tiered security services, house rules, and contactless payment flows in a high-converting 1-page format." 
    callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/tokyo-locker-storage-premium-luggage-solutions' }} 
    image={{ src: 'https://images.unsplash.com/photo-1618438502398-195e47778d6c?w=1200', alt: 'Locker Solution' }} 
  />

  <Content 
    isReversed={false} 
    tagline="Experience Excellence" 
    title="Portfolio Demo: Kagari Izakaya & Grill" 
    subtitle="A luxury Shinjuku gastronomy destination. Featuring integrated reservation workflows, seasonal omakase menus, and high-contrast night-mode aesthetics." 
    callToAction={{ variant: 'primary', text: 'Launch Live Demo', href: '/demos/kagari-izakaya-grill-shinjuku-tokyo-gastronomy' }} 
    image={{ src: 'https://images.unsplash.com/photo-1561535893-bb7a98c7ee45?w=1200&auto=format&fit=crop', alt: 'Izakaya Grill' }} 
  />
  
  <Content 
    isReversed={true} 
    title="02. Local and Global Discovery" 
    subtitle="Be found by the right people. We optimize your page so that both local neighbors and international travelers can discover your business through Google. A professional 1-page site builds immediate confidence and makes choosing your shop an easy decision." 
    items={[{ title: 'Professional Trust', description: 'Look established and modern from day one.', icon: 'tabler:search' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1533050487297-09b450131914?w=611&h=405&auto=format&fit=crop', alt: 'Customer Finding Shop' }} 
  />
  
  <Content 
    isReversed={false} 
    title="03. Visual-First Service Showcase" 
    subtitle="Let your work do the talking. We use high-resolution imagery to showcase your best products or services, helping customers understand exactly what makes your business special. A visual-first approach works across all languages and builds desire for your offerings." 
    items={[{ title: 'High-Impact Visuals', description: 'Showcase your craft with professional layouts.', icon: 'tabler:camera' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: 'Service Showcase' }} 
  />
  
  <Content 
    isReversed={true} 
    title="04. The Lightning-Fast Launch" 
    subtitle="We value your time. If you submit your information by 12:00 PM, we guarantee your professional 1-page website will be live and ready for customers by the time you open for dinner service. No long meetings or coding delays—just high-speed execution." 
    items={[{ title: 'Order by Noon', description: 'Live by the afternoon, or by next day latest.', icon: 'tabler:bolt' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1522623349500-de37a56ea2a5?w=611&h=405&auto=format&fit=crop', alt: 'Rapid Deployment' }} 
  />

  <Pricing 
    id="pricing" 
    title="One Simple Price. <br/> Live Today." 
    subtitle="Zero monthly fees. Lifetime ownership of your professional asset."
    prices={[pricingData]} 
  />
</Layout>
