---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: 'English Hanare | Independent English Infrastructure | Hanei JP',
  description: 'A professional English website for Japanese businesses. Stand-alone digital infrastructure for global reach without asking for your passwords.'
};

const pricingData = { 
  title: 'The English Hanare Plan', 
  price: '¥59,800', 
  period: 'One-time investment', 
  items: [
    { description: '10-Page Professional English Site' }, 
    { description: 'Native Technical & Hospitality Copy' }, 
    { description: 'No System Access Required' }, 
    { description: 'Zero-Password Deployment' }
  ], 
  callToAction: { target: '_self', text: 'Apply Now', href: '/contact', variant: 'primary' } 
};
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="The Detached Digital Hub Strategy" 
    title='Your Business, Presented <br/><span class="text-accent">to a Global Audience.</span>' 
    subtitle='Expand your reach to international travelers, partners, and global clients without the risk of modifying your current Japanese site. We build a high-performance English infrastructure that stands alone as your professional global flagship.' 
    actions={[{ variant: 'primary', text: 'Get Started', href: '#pricing' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=611&h=405&auto=format&fit=crop', alt: 'Japanese Quality and Precision' }} 
  />
  
  <Content 
    isReversed={false} 
    title="01. Zero Technical Risk" 
    subtitle="We build your English assets on a separate sub-domain, ensuring your original business site remains 100% untouched and operational. This decoupled architecture is the safest way for hospitality providers, manufacturers, and craftsmen to establish an international presence without interfering with essential domestic systems." 
    items={[{ title: 'Decoupled Assets', description: 'Total safety for your original business operations.', icon: 'tabler:shield-lock' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: 'Secure Global Infrastructure' }} 
  />
  
  <Content 
    isReversed={true} 
    title="02. Modern, Global Standards" 
    subtitle="International guests and partners expect a seamless digital experience. Your English Hanare is engineered with cutting-edge serverless technology to load instantly for travelers on roaming data or partners browsing from abroad. A high-performance site signals that your business is technologically sophisticated and ready for the world." 
    items={[{ title: 'Speed Performance', description: 'Engineered for visitors on the move.', icon: 'tabler:device-mobile' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1569912815867-5580004c13a2?w=611&h=405&auto=format&fit=crop', alt: 'High Performance Business Systems' }} 
  />
  
  <Content 
    isReversed={false} 
    title="03. Professional Native Copy" 
    subtitle="We replace basic translation with persuasive, industry-standard English that builds trust with high-end travelers and professional clients. Our writers understand how to convey the unique value of Japanese hospitality (Omotenashi) and manufacturing precision, turning your expertise into a compelling global sales tool." 
    items={[{ title: 'Native Nuance', description: 'Copy that builds trust and builds desire.', icon: 'tabler:message-language' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=611&h=405&auto=format&fit=crop', alt: 'Precision and Detail' }} 
  />
  
  <Content 
    isReversed={true} 
    title="04. Total Search Visibility" 
    subtitle="We engineer your site to rank for the specific search terms used by international tourists and global companies seeking your services. By targeting high-intent keywords in English, we ensure your business is discovered by decision-makers and high-net-worth travelers before they even arrive in your city." 
    items={[{ title: 'Market Reach', description: 'Be discovered by international industry leaders.', icon: 'tabler:search' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=611&h=405&auto=format&fit=crop', alt: 'Search Visibility' }} 
  />

  <Content 
    isReversed={false} 
    title="05. Zero-Access Deployment" 
    subtitle="We never ask for your passwords or system logins. We build and deploy your English infrastructure entirely on our secure servers. The only step required on your part is a simple one-minute entry in your domain settings (CNAME), and our team will guide you through this effortless process to go live." 
    items={[{ title: 'Total Data Privacy', description: 'Keep your passwords and internal systems private.', icon: 'tabler:key-off' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1595476513916-a435d93d1f6a?w=1200&auto=format&fit=crop', alt: 'Modern Japanese Web Setup' }} 
  />

  <Pricing id="pricing" title="Global Expansion. Zero Technical Risk." prices={[pricingData]} />
</Layout>
