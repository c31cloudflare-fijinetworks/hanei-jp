---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: 'English Hanare | Detached English Website | Hanei JP',
  description: 'Build a world-class English website for your business without touching your existing Japanese site. Zero risk, native copywriting, and elite performance.'
};

const pricingData = { 
  title: 'The English Hanare Plan', 
  price: '¥59,800', 
  period: 'One-time investment', 
  items: [
    { description: '10-Page Professional English Site' }, 
    { description: 'Native English Copywriting' }, 
    { description: 'No Access Passwords Required' }, 
    { description: '3-Day Delivery Guarantee' }
  ], 
  callToAction: { target: '_self', text: 'Apply Now', href: '/contact', variant: 'primary' } 
};
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="The Detached Pavilion Strategy" 
    title='A Complete English Website <br/><span class="text-accent">Without Touching Your Current Site.</span>' 
    subtitle='Need English but afraid to change your fragile Japanese site? We build a world-class English pavilion that stands alone, hosted and managed entirely by our expert team.' 
    actions={[{ variant: 'primary', text: 'Get Started', href: '#pricing' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=611&h=405&auto=format&fit=crop', alt: 'Premium Japanese Dining' }} 
  />
  
  <Content 
    isReversed={false} 
    title="01. Zero Technical Risk" 
    subtitle="We build your English assets on a separate sub-domain. Your original legacy Japanese site remains 100% untouched and safe. This decoupled architecture gives you the freedom to innovate your international presence without any fear of breaking your primary business operations." 
    items={[{ title: 'Decoupled Assets', description: 'Safety first for your original business site.', icon: 'tabler:shield-lock' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: 'Secure System Shield' }} 
  />
  
  <Content 
    isReversed={true} 
    title="02. Modern, Mobile-First UX" 
    subtitle="While your old site might be slow, your new English Hanare will be lightning-fast on any global smartphone. By using cutting-edge serverless technology, we ensure your brand feels sophisticated and reliable to high-end customers browsing while on the move." 
    items={[{ title: 'Speed Performance', description: 'Engineered for guests on roaming data.', icon: 'tabler:device-mobile' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1569912815867-5580004c13a2?w=611&h=405&auto=format&fit=crop', alt: 'Modern Mobile Experience' }} 
  />
  
  <Content 
    isReversed={false} 
    title="03. Native Copywriting" 
    subtitle="We replace bad machine translations with professional, persuasive English that builds trust with high-end guests. Our writers capture the true spirit of your Japanese craftsmanship, translating your 'Omotenashi' into compelling language that resonates with the global elite." 
    items={[{ title: 'Native Nuance', description: 'Copy that sells, not just translates.', icon: 'tabler:message-language' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=611&h=405&auto=format&fit=crop', alt: 'Professional Writing' }} 
  />
  
  <Content 
    isReversed={true} 
    title="04. SEO Domination" 
    subtitle="Specifically engineered to rank for English search terms that international travelers actually use in your city. We bridge the data gap by targeting the specific intent of visitors, ensuring you appear at the very top of their search results before they even arrive in town." 
    items={[{ title: 'Discovery Engine', description: 'Capture guests before they reach your street.', icon: 'tabler:search' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=611&h=405&auto=format&fit=crop', alt: 'Local SEO Search' }} 
  />

  <Pricing id="pricing" title="Professional Expansion. Zero Risk." prices={[pricingData]} />
</Layout>
