---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { title: 'English Hanare | Hanei JP' };
const pricingData = { title: 'The English Hanare Plan', price: '59,800', period: 'One-time', items: [{ description: '10-Page English Site' }, { description: 'Native English Copy' }, { description: 'No Passwords Required' }, { description: '3-Day Delivery' }], callToAction: { target: '_self', text: 'Apply Now', href: '/contact', variant: 'primary' } };
---
<Layout metadata={metadata}>
  <Hero2 tagline="The Detached Pavilion Strategy" title='A Complete English Website <br/><span class="text-accent">Without Touching Your Current Site.</span>' subtitle='Need English but afraid to change your fragile Japanese site? We build a world-class English pavilion that stands alone.' actions={[{ variant: 'primary', text: 'Get Started', href: '#pricing' }]} image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=611&h=405&auto=format&fit=crop', alt: 'Dining' }} />
  
  <Content isReversed={false} title="01. Zero Technical Risk" subtitle="We build on a separate sub-domain. Your original legacy Japanese site remains 100% untouched and safe." items={[{ title: 'Decoupled Assets', description: 'Safety first for your original business site.', icon: 'tabler:shield-lock' }]} image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: 'Shield' }} />
  
  <Content isReversed={true} title="02. Modern, Mobile-First UX" subtitle="While your old site might be slow, your new English Hanare will be lightning-fast on any global smartphone." items={[{ title: 'Speed Performance', description: 'Engineered for tourists on roaming data.', icon: 'tabler:device-mobile' }]} image={{ src: 'https://images.unsplash.com/photo-1569912815867-5580004c13a2?w=611&h=405&auto=format&fit=crop', alt: 'Mobile' }} />
  
  <Content isReversed={false} title="03. Native Copywriting" subtitle="We replace bad machine translations with professional, persuasive English that builds trust with high-end guests." items={[{ title: 'Native Nuance', description: 'Copy that sells, not just translates.', icon: 'tabler:message-language' }]} image={{ src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=611&h=405&auto=format&fit=crop', alt: 'Nuance' }} />
  
  <Content isReversed={true} title="04. SEO Domination" subtitle="Specifically engineered to rank for English search terms that international travelers actually use in your city." items={[{ title: 'Discovery Engine', description: 'Capture tourists before they reach your street.', icon: 'tabler:search' }]} image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=611&h=405&auto=format&fit=crop', alt: 'SEO' }} />

  <Pricing id="pricing" title="Professional Expansion. Zero Risk." prices={[pricingData]} />
</Layout>
