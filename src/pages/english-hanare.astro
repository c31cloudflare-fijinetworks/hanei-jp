---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: 'English Hanare | Global Business Presence | Hanei JP',
  description: 'A world-class English website for Japanese craftsmen, manufacturers, and businesses. Professional global presence without touching your existing systems.'
};

const pricingData = { 
  title: 'The English Hanare Plan', 
  price: '¥59,800', 
  period: 'One-time investment', 
  items: [
    { description: '10-Page Professional English Site' }, 
    { description: 'Business & Technical Copywriting' }, 
    { description: 'No System Access Required' }, 
    { description: '3-Day Delivery Guarantee' }
  ], 
  callToAction: { target: '_self', text: 'Apply Now', href: '/contact', variant: 'primary' } 
};
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="The Detached Pavilion Strategy" 
    title='Your Business, Presented <br/><span class="text-accent">to the Global Market.</span>' 
    subtitle='Expand your reach to international partners and global clients without the risk of modifying your current Japanese site. We build a high-performance English pavilion that stands alone as your professional global flagship.' 
    actions={[{ variant: 'primary', text: 'Get Started', href: '#pricing' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=611&h=405&auto=format&fit=crop', alt: 'Japanese Quality and Precision' }} 
  />
  
  <Content 
    isReversed={false} 
    title="01. Zero Technical Risk" 
    subtitle="We build your English assets on a separate sub-domain, ensuring your original business site remains 100% untouched and operational. This decoupled architecture is the safest way for manufacturers and craftsmen to establish an international presence without interfering with their essential domestic systems." 
    items={[{ title: 'Decoupled Assets', description: 'Total safety for your original business operations.', icon: 'tabler:shield-lock' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: 'Secure Global Infrastructure' }} 
  />
  
  <Content 
    isReversed={true} 
    title="02. Modern, Global Standards" 
    subtitle="International partners expect a seamless digital experience. Your English Hanare is engineered with cutting-edge serverless technology to load instantly in the US, Europe, and beyond. A high-performance site signals that your business is technologically sophisticated and ready for global collaboration." 
    items={[{ title: 'Speed Performance', description: 'Optimized for international loading speeds.', icon: 'tabler:device-mobile' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1569912815867-5580004c13a2?w=611&h=405&auto=format&fit=crop', alt: 'High Performance Business Systems' }} 
  />
  
  <Content 
    isReversed={false} 
    title="03. Professional Business Copy" 
    subtitle="We replace basic translation with persuasive, industry-standard English that resonates with professional buyers and global clients. Our writers understand how to convey the unique value of Japanese craftsmanship and manufacturing precision, turning your technical expertise into a compelling global sales tool." 
    items={[{ title: 'Industry Authority', description: 'Copy that builds trust with global partners.', icon: 'tabler:message-language' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=611&h=405&auto=format&fit=crop', alt: 'Precision and Detail' }} 
  />
  
  <Content 
    isReversed={true} 
    title="04. Global SEO Domination" 
    subtitle="We engineer your site to rank for the specific search terms used by international companies and global clients seeking your services. By targeting high-intent keywords in English, we ensure your business is discovered by decision-makers in foreign markets before they ever consider your competitors." 
    items={[{ title: 'Market Reach', description: 'Be discovered by international industry leaders.', icon: 'tabler:search' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=611&h=405&auto=format&fit=crop', alt: 'Search Visibility' }} 
  />

  <Pricing id="pricing" title="Global Expansion. Zero Technical Risk." prices={[pricingData]} />
</Layout>
