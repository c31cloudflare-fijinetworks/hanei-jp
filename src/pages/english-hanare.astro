---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';

const metadata = { 
  title: 'English Hanare | Independent English Infrastructure | Hanei JP',
  description: 'A professional English website for Japanese businesses. Stand-alone digital infrastructure for global reach.'
};

const prices = [
  { 
    title: 'Starter Hanare', 
    price: '¥22,500', 
    subTitle: 'Start Deposit 50%',
    badge: 'Total: ¥45,000 <br/> Final Balance: ¥22,500',
    items: [{ description: 'Up to 3-Page English Hub' }, { description: 'High-Speed Edge Serving' }, { description: 'Mobile-First Global UI' }, { description: 'Standard English Translation' }, { description: 'Secure Infrastructure Setup' }] 
  },
  { 
    title: 'Growth Hanare', 
    price: '¥47,500', 
    subTitle: 'Start Deposit 50%',
    badge: 'Total: ¥95,000 <br/> Final Balance: ¥47,500',
    items: [{ description: 'Up to 8-Page English Hub' }, { description: 'NATIVE English Copywriting' }, { description: 'Global SEO Strategy' }, { description: 'Google Maps Profile Sync' }, { description: 'Priority 48-Hour Deployment' }] 
  },
  { 
    title: 'Enterprise Hanare', 
    price: '¥97,500', 
    subTitle: 'Start Deposit 50%',
    badge: 'Total: ¥195,000 <br/> Final Balance: ¥97,500',
    items: [{ description: 'Full Website Infrastructure' }, { description: 'Advanced Native Storytelling' }, { description: 'Custom Lead Injection Forms' }, { description: 'Bespoke Branding Consultation' }, { description: 'Priority White-Glove Support' }] 
  }
];
---
<Layout metadata={metadata}>
  <Hero2 
    tagline="The Detached Digital Hub Strategy" 
    title='Your Business, Presented <br/><span class="text-accent">to a Global Audience.</span>' 
    subtitle='Expand your reach to international travelers and global partners without the risk of modifying your current Japanese site. We build a high-performance English infrastructure that stands alone.' 
    actions={[{ variant: 'primary', text: 'View Premium Tiers', href: '#pricing' }]} 
    image={{ src: 'https://images.unsplash.com/photo-1602273660127-a0000560a4c1?w=611&h=405&auto=format&fit=crop', alt: 'Japanese Quality' }} 
  />
  
  <Content isReversed={false} title="01. Zero Technical Risk" subtitle="We build your English assets on a separate sub-domain, ensuring your original business site remains 100% untouched and operational." image={{ src: 'https://images.unsplash.com/photo-1608060146923-7b8ab13e22bb?w=611&h=405&auto=format&fit=crop', alt: 'Secure' }} />
  <Content isReversed={true} title="02. Modern, Global Standards" subtitle="Your English Hanare is engineered with cutting-edge serverless technology to load instantly for visitors on the move." image={{ src: 'https://images.unsplash.com/photo-1569912815867-5580004c13a2?w=611&h=405&auto=format&fit=crop', alt: 'Performance' }} />
  <Content isReversed={false} title="03. Professional Native Copy" subtitle="We replace basic translation with persuasive English that builds trust with high-end travelers and professional clients." image={{ src: 'https://images.unsplash.com/photo-1592466741848-20145fe5d6d7?w=611&h=405&auto=format&fit=crop', alt: 'Nuance' }} />
  <Content isReversed={true} title="04. Total Search Visibility" subtitle="We engineer your site to rank for the specific search terms used by international companies and global clients seeking your services." image={{ src: 'https://images.unsplash.com/photo-1760895941769-d94899109478?w=611&h=405&auto=format&fit=crop', alt: 'Reach' }} />
  <Content isReversed={false} title="05. Zero-Access Deployment" subtitle="We build and deploy entirely on our secure servers. The only step required to go live is a minor update to your website address record—and we fully assist you." image={{ src: 'https://images.unsplash.com/photo-1595476513916-a435d93d1f6a?w=1200&auto=format&fit=crop', alt: 'Privacy' }} />

  <Pricing id="pricing" title="Premium Tiers. Definitive Value." subtitle="Secure your asset with a project initiation phase. Balance due only upon final delivery." prices={prices} hasUrlField={true} />

  <!-- BESPOKE SECTION FOR OVER 20 PAGES -->
  <Content
    isReversed={true}
    title="Need more than 20 pages?"
    subtitle="For complex enterprise-level migrations or high-volume content hubs, we offer bespoke development services. Our team will architect a tailored English infrastructure designed to handle your specific industry requirements."
    callToAction={{ text: 'Inquire for Custom Quote', href: '/contact', variant: 'primary' }}
    image={{ src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=1200&auto=format&fit=crop', alt: 'Enterprise Hub' }}
    classes={{ container: 'py-12 md:py-20 bg-slate-50 dark:bg-transparent border-t dark:border-slate-800' }}
  />
</Layout>
