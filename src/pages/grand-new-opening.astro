---
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = { 
  title: 'The Grand New Opening | Hanei JP', 
  description: 'Building a premium, bilingual "Digital Flagship" from the ground up.',
};

const pricingData = {
  title: 'The Grand New Opening',
  subtitle: 'Premium bilingual Digital Flagship.',
  price: '298,500',
  period: 'One-time CapEx',
  items: [
    { description: 'The "Bilingual-First" Dual-Engine Architecture' },
    { description: 'Cutting-Edge Headless Modern Tech Stack' },
    { description: 'Authority-First Global & Local SEO Strategy' },
    { description: 'The "High-End Guest" Luxury UX Design' },
    { description: 'Zero-to-Hero 48-Hour Launch' },
  ],
  callToAction: { target: '_self', text: 'Launch My Grand New Opening', href: '/contact', variant: 'primary' },
};
---

<Layout metadata={metadata}>
  
  <!-- HERO SECTION -->
  <Hero2
    tagline="Service #2: Grand New Opening"
    title='The Grand New Opening: Your Bilingual Flagship for the <br/><span class="text-accent">Global Stage.</span>'
    subtitle="Why settle for a 'translated' site when you can own a global landmark? We build your definitive, dual-language digital headquarters from scratch—engineered for maximum authority and high-spending international conversion."
    actions={[{ variant: 'primary', text: 'Launch My Grand New Opening', href: '/contact' }]}
    image={{ src: 'https://images.unsplash.com/photo-1626379907753-406934326e2c?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTI5fHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D', alt: 'Japanese Chef Cooking' }}
  />
  
  <!-- THE MISSION -->
  <Content
    isReversed={false}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The Mission: Become the "Number One" Choice from Day One.</h3>
      <p class="text-lg text-muted mb-4">
        When you are ready to claim your place as a leader in the market, a standard website isn't enough. You need a Digital Flagship.
      </p>
      <p class="text-lg text-muted mb-6">
        The "Grand New Opening" is for businesses that refuse to compromise—owners who want to attract the world’s most affluent travelers with a presence that screams quality, trust, and luxury.
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-white">
        Stop trying to "add" English to a Japanese site. Start with a world-class foundation that speaks to everyone.
      </p>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1691484466261-cb7557646ffc?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTUyfHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Traditional Japanese Setting" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- FEATURES -->
  <Content
    isReversed={true}
    items={[
        { title: '1. The "Bilingual-First" Architecture', description: 'We build your site with a dual-engine core. Both Japanese and English are treated with equal importance. We use different triggers and calls to action for Western travelers versus Japanese locals, maximizing conversion.', icon: 'tabler:language-hiragana' },
        { title: '2. Cutting-Edge Modern Tech Stack', description: 'Built using the latest "Headless" high-velocity frameworks. Future-proof and blisteringly fast across the globe, even with high-resolution 4K video and photography.', icon: 'tabler:rocket' },
        { title: '3. Authority-First SEO Strategy', description: 'We build "Search Engine Magnetism" into your DNA. Optimized for global English keywords while maintaining perfect local SEO. From a blank screen to a high-authority flagship in just two days.', icon: 'tabler:chart-arrows-vertical' },
        { title: '4. The "High-End Guest" UX', description: 'We meet Western luxury expectations with a "Concierge-Level" digital experience. Using immersive design, cinematic video, and elegant white space, we create a feeling of luxury that justifies premium pricing.', icon: 'tabler:diamond' },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Vibrant Features: <br/>Engineering a Global Icon</h3>
    </Fragment>
    <Fragment slot="image">
       <img src="https://images.unsplash.com/photo-1754228752210-e41501dd1773?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTg1fHxqYXBhbmVzZSUyMGZvb2R8ZW58MHx8MHx8fDI%3D" alt="Luxury Japanese Cuisine" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <!-- TOURIST READY SUITE -->
  <Features2
    title='Every Plan Includes the "Tourist-Ready" Suite:'
    subtitle="Built-in infrastructure to ensure you start capturing inbound traffic immediately."
    columns={3}
    items={[
      { title: 'Google Maps SEO (MEO)', description: '1-page full English SEO setup to ensure you appear when tourists search "near me."', icon: 'tabler:circle-check' },
      { title: 'Custom QR Review Assets', description: 'Print-ready PDFs for your tables to drive 5-star Google reviews.', icon: 'tabler:circle-check' },
      { title: 'The "How-To" Landing Page', description: 'Custom content explaining your rules (No smoking, cover charges, shoe policy) to remove the Anxiety of Entry.', icon: 'tabler:circle-check' },
      { title: 'Professional English Copywriting', description: "We don't just translate; we write high-converting business descriptions.", icon: 'tabler:circle-check' },
      { title: 'Super-High-Speed Network', description: 'Optimized for mobile users on roaming data so your site loads instantly.', icon: 'tabler:circle-check' },
      { title: 'Same-Day Lightning Fast Deployment', description: 'Order before lunch, and we launch your website today!', icon: 'tabler:bolt' },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Your New Era Starts Here."
    subtitle="The Grand New Opening is more than a website—it is a statement of intent. It tells the world that your business is open, international, and operating at the highest level of excellence. Don't just join the market. Lead it."
    actions={[
        { variant: 'primary', text: 'Launch My Grand New Opening', href: '/contact' }
    ]}
  />

</Layout>
