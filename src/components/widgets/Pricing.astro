---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Price } from '~/types';

const { title, subtitle, tagline, prices = [], hasUrlField = false, classes = {}, ...rest } = Astro.props;

const SITE_URL = "https://hanei.jp";
const currentPath = Astro.url.pathname;
const cancelUrl = `${SITE_URL}${currentPath}`;
const successUrl = `${SITE_URL}/thank-you`;

// ENFORCED GRID STABILITY
const gridConfig = prices.length === 1 ? "max-w-2xl mx-auto" : "grid grid-cols-1 xl:grid-cols-3 gap-12 max-w-7xl mx-auto";
---

<WidgetWrapper {...rest} id="pricing" classes={{ container: 'max-w-7xl scroll-mt-16', ...classes.container }} hasBackground>
  <Headline {title} {subtitle} {tagline} classes={{ title: 'text-5xl md:text-7xl font-black tracking-tighter text-slate-950 mb-20' }} />
  
  <div class={gridConfig}>
    {prices.map((price) => (
      <div class="relative flex flex-col rounded-[3rem] border-2 border-slate-200 p-10 md:p-14 text-center shadow-2xl bg-white transition-all w-full max-w-[480px] mx-auto">
        
        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-slate-950 text-white px-8 py-2 rounded-full text-xs font-black uppercase tracking-[0.3em] whitespace-nowrap shadow-xl">
            Hanei Standard
        </div>

        <div class="h-28 flex items-center justify-center mt-6">
          <h3 class="text-4xl font-black text-slate-950 font-heading tracking-tighter uppercase leading-none">
            {price.title}
          </h3>
        </div>
        
        <div class="mt-10 flex-1 flex flex-col border-y-2 border-slate-100 py-12 my-2">
          <div class="flex flex-col items-center">
            <span class="text-sm font-black text-slate-400 uppercase tracking-[0.2em] mb-4">Project Initiation</span>
            <div class="flex items-baseline">
                <span class="text-6xl md:text-7xl font-black tracking-tighter text-blue-600 leading-none">
                    {typeof price.price === 'number' ? '¥' + price.price.toLocaleString() : price.price}
                </span>
            </div>
            <div class="mt-8 border-2 border-slate-950 px-6 py-2 rounded-xl">
                <span class="text-sm font-black text-slate-950 uppercase tracking-widest">
                  Total Investment: {price.total}
                </span>
            </div>
          </div>
          
          <ul role="list" class="mt-16 space-y-6 text-left flex-grow min-h-[300px]">
            {price.items.map((item) => (
              <li class="flex items-start">
                <div class="bg-blue-600 rounded-full p-1.5 mr-5 mt-1 shrink-0 shadow-lg">
                    <Icon name="tabler:check" class="w-5 h-5 text-white stroke-[4px]" />
                </div>
                <p class="text-xl text-slate-950 font-black leading-tight tracking-tight">{item.description}</p>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="mt-12">
          <form class="checkout-form" action="https://www.paypal.com/cgi-bin/webscr" method="get" target="_blank">
            <input type="hidden" name="cmd" value="_xclick" />
            <input type="hidden" name="business" value="ZFG89TK2KESFG" />
            <input type="hidden" name="brand_name" value="Hanei JP" />
            <input type="hidden" name="cbt" value="Return to Hanei JP" />
            <input type="hidden" name="image_url" value="https://hanei.jp/images/logo.webp" />
            <input type="hidden" name="no_shipping" value="1" />
            <input type="hidden" name="no_note" value="1" />
            <input type="hidden" name="tax" value="0" />
            <input type="hidden" name="shipping" value="0" />
            <input type="hidden" class="paypal-item-name" name="item_name" value={`Hanei JP: ${price.title} (Phase 1)`} />
            <input type="hidden" name="amount" value={price.price?.toString().replace(/[^0-9.]/g, '')} />
            <input type="hidden" name="currency_code" value="JPY" />
            
            <div class="text-left space-y-8">
              <div>
                <label class="block text-xs font-black mb-3 text-slate-950 uppercase tracking-widest">1. Business Name</label>
                <input type="text" name="os0" required class="business-name-input w-full px-6 py-6 text-xl border-2 border-slate-200 rounded-2xl bg-slate-50 focus:bg-white focus:border-slate-950 outline-none transition-all text-slate-950 font-black placeholder:text-slate-300 shadow-inner" placeholder="Business Identity" data-base-title={price.title} />
                <input type="hidden" name="on0" value="Business Name" />
              </div>

              <div>
                <label class="block text-xs font-black mb-3 text-slate-950 uppercase tracking-widest">2. Website (Optional)</label>
                <input type="text" name="os1" class="w-full px-6 py-6 text-xl border-2 border-slate-200 rounded-2xl bg-slate-50 focus:bg-white focus:border-slate-950 outline-none transition-all text-slate-950 font-black placeholder:text-slate-300 shadow-inner" placeholder="https://..." />
                <input type="hidden" name="on1" value="Current URL" />
              </div>

              <div>
                <label class="block text-xs font-black mb-3 text-slate-950 uppercase tracking-widest">3. Delivery Email</label>
                <input type="email" required class="email-input w-full px-6 py-6 text-xl border-2 border-slate-200 rounded-2xl bg-slate-50 focus:bg-white focus:border-slate-950 outline-none transition-all text-slate-950 font-black placeholder:text-slate-300 shadow-inner" placeholder="Contact Email" />
                <input type="hidden" class="paypal-custom-metadata" name="custom" value="" />
              </div>
            </div>

            <button type="submit" class="w-full mt-16 py-8 bg-blue-600 hover:bg-slate-950 text-white font-black rounded-2xl shadow-[0_20px_50px_rgba(37,99,235,0.3)] transition-all text-xl uppercase tracking-[0.2em] transform hover:-translate-y-2">
              Start Project Now
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>

<script is:inline>
  function initTieredCheckout() {
    const forms = document.querySelectorAll('.checkout-form');
    forms.forEach(form => {
      const sync = () => {
        const bizVal = form.querySelector('.business-name-input').value.trim();
        const emailVal = form.querySelector('.email-input').value.trim();
        const baseTitle = form.querySelector('.business-name-input').getAttribute('data-base-title');
        form.querySelector('.paypal-item-name').value = bizVal ? `Hanei JP: ${baseTitle} (Deposit) (${bizVal})` : `Hanei JP: ${baseTitle} (Deposit)`;
        form.querySelector('.paypal-custom-metadata').value = JSON.stringify({ email: emailVal, business: bizVal });
      };
      form.querySelector('.business-name-input').addEventListener('input', sync);
      form.querySelector('.email-input').addEventListener('input', sync);
    });
  }
  document.addEventListener('astro:page-load', initTieredCheckout);
  initTieredCheckout();
</script>
