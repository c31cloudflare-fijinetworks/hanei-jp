---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Price } from '~/types';

const { title, subtitle, tagline, prices = [], hasUrlField = false, classes = {}, ...rest } = Astro.props;

const SITE_URL = "https://hanei.jp";
const currentPath = Astro.url.pathname;
const cancelUrl = `${SITE_URL}${currentPath}`;
const successUrl = `${SITE_URL}/thank-you`;

const isSingle = prices.length === 1;
const cardWidthClass = isSingle 
  ? "w-full max-w-xl" 
  : "w-full md:w-[calc(50%-1.5rem)] xl:w-[calc(33%-1.5rem)] min-w-[320px]";
---

<WidgetWrapper {...rest} id="pricing" classes={{ container: 'max-w-7xl scroll-mt-16', ...classes.container }} hasBackground>
  <Headline {title} {subtitle} {tagline} classes={{ title: 'text-4xl md:text-5xl font-bold tracking-tight text-slate-900' }} />
  
  <div class="flex flex-wrap justify-center gap-8">
    {prices.map((price) => (
      <div class:list={[
        "relative flex flex-col rounded-2xl border border-slate-100 p-8 text-center shadow-xl bg-white dark:bg-slate-900 transition-all hover:shadow-2xl",
        cardWidthClass
      ]}>
        
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-slate-900 text-white px-5 py-1 rounded-full text-[10px] font-bold uppercase tracking-[0.2em]">
            Boutique Infrastructure
        </div>

        <h3 class="text-2xl font-bold mt-4 text-slate-900 dark:text-white font-heading tracking-tight">
          {price.title}
        </h3>
        
        <div class="mt-8 flex-1 flex flex-col border-y border-slate-50 py-10 my-2">
          <div class="flex flex-col items-center">
            <div class="flex items-baseline gap-1">
                <span class="text-6xl font-bold tracking-tighter text-primary">
                    {typeof price.price === 'number' ? '¥' + price.price.toLocaleString() : price.price}
                </span>
            </div>
            <span class="mt-3 text-xs font-bold text-slate-900 uppercase tracking-widest">Project Launch Deposit</span>
            <span class="mt-4 text-[10px] font-medium text-slate-400 uppercase tracking-widest border border-slate-100 px-3 py-1 rounded-full">
              Total Investment: {price.total}
            </span>
          </div>
          
          <ul role="list" class="mt-12 space-y-4 text-left text-sm flex-grow">
            {price.items.map((item) => (
              <li class="flex items-start">
                <Icon name="tabler:circle-check" class="w-5 h-5 text-primary flex-shrink-0" />
                <p class="ml-3 text-slate-600 dark:text-slate-300 font-medium leading-relaxed">{item.description}</p>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="mt-8">
          <form class="checkout-form" action="https://www.paypal.com/cgi-bin/webscr" method="get" target="_blank">
            <input type="hidden" name="cmd" value="_xclick" />
            <input type="hidden" name="business" value="ZFG89TK2KESFG" />
            <input type="hidden" name="brand_name" value="Hanei JP" />
            <input type="hidden" name="cbt" value="Return to Hanei JP" />
            <input type="hidden" name="image_url" value="https://hanei.jp/images/logo.webp" />
            <input type="hidden" name="no_shipping" value="1" />
            <input type="hidden" name="no_note" value="1" />
            <input type="hidden" name="tax" value="0" />
            <input type="hidden" name="shipping" value="0" />
            <input type="hidden" class="paypal-item-name" name="item_name" value={`Hanei JP: ${price.title} (Launch Deposit)`} />
            <input type="hidden" name="amount" value={price.price?.toString().replace(/[^0-9.]/g, '')} />
            <input type="hidden" name="currency_code" value="JPY" />
            
            <div class="text-left space-y-5">
              <div class="group">
                <label class="block text-[10px] font-bold mb-1.5 text-slate-900 uppercase tracking-[0.15em]">1. Business Identity</label>
                <input type="text" name="os0" required class="business-name-input w-full px-4 py-3 text-sm border border-slate-200 rounded-md bg-white focus:border-slate-900 focus:ring-0 outline-none transition-colors text-slate-900 font-medium placeholder:text-slate-200" placeholder="e.g. Ginza Aesthetic Studio" data-base-title={price.title} />
                <input type="hidden" name="on0" value="Business Name" />
              </div>

              <div>
                <label class="block text-[10px] font-bold mb-1.5 text-slate-900 uppercase tracking-[0.15em]">2. Digital Footprint (Optional)</label>
                <input type="text" name="os1" class="w-full px-4 py-3 text-sm border border-slate-200 rounded-md bg-white focus:border-slate-900 focus:ring-0 outline-none transition-colors text-slate-900 font-medium placeholder:text-slate-200" placeholder="https://existing-site.jp" />
                <input type="hidden" name="on1" value="Current URL" />
              </div>

              <div>
                <label class="block text-[10px] font-bold mb-1.5 text-slate-900 uppercase tracking-[0.15em]">3. Delivery Channel</label>
                <input type="email" required class="email-input w-full px-4 py-3 text-sm border border-slate-200 rounded-md bg-white focus:border-slate-900 focus:ring-0 outline-none transition-colors text-slate-900 font-medium placeholder:text-slate-200" placeholder="primary-contact@business.com" />
                <input type="hidden" class="paypal-custom-metadata" name="custom" value="" />
              </div>
            </div>

            <button type="submit" class="w-full mt-10 py-4 bg-primary hover:bg-slate-900 text-white font-bold rounded-md shadow-lg transition-all text-xs uppercase tracking-[0.2em]">
              Initiate Project Phase
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>

<script is:inline>
  function initTieredCheckout() {
    const forms = document.querySelectorAll('.checkout-form');
    forms.forEach(form => {
      const bizInput = form.querySelector('.business-name-input');
      const emailInput = form.querySelector('.email-input');
      const itemHidden = form.querySelector('.paypal-item-name');
      const customHidden = form.querySelector('.paypal-custom-metadata');
      const baseTitle = bizInput?.getAttribute('data-base-title');

      const sync = () => {
        const bizVal = bizInput.value.trim();
        const emailVal = emailInput.value.trim();
        itemHidden.value = bizVal ? `Hanei JP: ${baseTitle} (Launch Deposit) (${bizVal})` : `Hanei JP: ${baseTitle} (Launch Deposit)`;
        customHidden.value = JSON.stringify({ email: emailVal, business: bizVal });
      };

      if(bizInput) bizInput.addEventListener('input', sync);
      if(emailInput) emailInput.addEventListener('input', sync);
    });
  }
  document.addEventListener('astro:page-load', initTieredCheckout);
  initTieredCheckout();
</script>
