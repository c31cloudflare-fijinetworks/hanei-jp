---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Price } from '~/types';

const { title, subtitle, tagline, prices = [], hasUrlField = false, classes = {}, ...rest } = Astro.props;

const SITE_URL = "https://hanei.jp";
const currentPath = Astro.url.pathname;
const cancelUrl = `${SITE_URL}${currentPath}`;
const successUrl = `${SITE_URL}/thank-you`;

const isSingle = prices.length === 1;
const cardWidthClass = isSingle 
  ? "w-full max-w-xl" 
  : "w-full md:w-[calc(50%-1.5rem)] xl:w-[calc(33%-1.5rem)] min-w-[300px]";
---

<WidgetWrapper {...rest} id="pricing" classes={{ container: 'max-w-7xl scroll-mt-16', ...classes.container }} hasBackground>
  <Headline {title} {subtitle} {tagline} classes={{ headline: 'max-w-3xl' }} />
  
  <div class="flex flex-wrap justify-center gap-6">
    {prices.map((price) => (
      <div class:list={[
        "relative overflow-visible flex flex-col rounded-lg border-2 border-primary p-6 text-center shadow-xl bg-white dark:bg-slate-900 transition-all hover:shadow-2xl",
        cardWidthClass
      ]}>
        
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-accent text-white px-3 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest text-white whitespace-nowrap shadow-md">
            Premium Infrastructure
        </div>

        <h3 class="text-2xl font-bold mt-4 text-slate-900 dark:text-white leading-tight h-16 flex items-center justify-center border-b border-slate-100 dark:border-slate-800">
          {price.title}
        </h3>
        
        <div class="mt-6 flex-1 flex flex-col">
          <div class="flex items-end justify-center">
            <span class="text-5xl font-bold tracking-tight text-primary">
                {typeof price.price === 'number' ? '¥' + price.price.toLocaleString() : price.price}
            </span>
          </div>
          <div class="mt-2 mb-8 text-[10px] font-bold text-muted uppercase tracking-widest italic">
            {price.period}
          </div>
          
          <ul role="list" class="space-y-3 text-left text-sm mb-8 flex-grow">
            {price.items.map((item) => (
              <li class="flex items-start">
                <Icon name="tabler:circle-check" class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" />
                <p class="ml-2 text-muted dark:text-slate-300 font-medium">{item.description}</p>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <form class="checkout-form" action="https://www.paypal.com/cgi-bin/webscr" method="get" target="_blank">
            <input type="hidden" name="cmd" value="_xclick" />
            <input type="hidden" name="business" value="ZFG89TK2KESFG" />
            
            <!-- IDENTITY OVERRIDES -->
            <input type="hidden" name="brand_name" value="Hanei JP" />
            <input type="hidden" name="cbt" value="Return to Hanei JP" />
            <input type="hidden" name="cpp_header_image" value="https://hanei.jp/images/logo.webp" />
            <input type="hidden" name="image_url" value="https://hanei.jp/images/logo.webp" />
            
            <input type="hidden" name="solution_type" value="Sole" />
            <input type="hidden" name="landing_page" value="billing" />
            <input type="hidden" name="return" value={successUrl} />
            <input type="hidden" name="cancel_return" value={cancelUrl} />
            
            <!-- FEE SUPPRESSION -->
            <input type="hidden" name="no_shipping" value="1" />
            <input type="hidden" name="no_note" value="1" />
            <input type="hidden" name="tax" value="0" />
            <input type="hidden" name="shipping" value="0" />
            
            <input type="hidden" class="paypal-item-name" name="item_name" value={`Hanei JP: ${price.title} (50% Deposit)`} />
            <input type="hidden" name="amount" value={price.price?.toString().replace(/[^0-9.]/g, '')} />
            <input type="hidden" name="currency_code" value={price.price?.toString().includes('¥') ? "JPY" : "USD"} />
            
            <div class="text-left space-y-4">
              <div>
                <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">1. Business Name</label>
                <input type="text" name="os0" required class="business-name-input w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="Name" data-base-title={price.title} />
                <input type="hidden" name="on0" value="Business Name" />
              </div>

              {hasUrlField ? (
                <div>
                  <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">2. Current Website URL</label>
                  <input type="text" name="os1" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="https://..." />
                  <input type="hidden" name="on1" value="Current URL" />
                </div>
              ) : (
                <div>
                  <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">2. Representative Name</label>
                  <input type="text" name="os1" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="Your Name" />
                  <input type="hidden" name="on1" value="Representative" />
                </div>
              )}

              <div>
                <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">3. Primary Email</label>
                <input type="email" required class="email-input w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="email@address.com" />
                <input type="hidden" class="paypal-custom-metadata" name="custom" value="" />
              </div>
            </div>

            <button type="submit" class="w-full mt-6 py-3.5 bg-primary hover:bg-blue-700 text-white font-extrabold rounded shadow-md hover:shadow-lg transition-all text-xs uppercase tracking-[0.1em]">
              {price.callToAction?.text || 'Order Now'}
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>

<script is:inline>
  function initTieredCheckout() {
    const forms = document.querySelectorAll('.checkout-form');
    forms.forEach(form => {
      const bizInput = form.querySelector('.business-name-input');
      const emailInput = form.querySelector('.email-input');
      const itemHidden = form.querySelector('.paypal-item-name');
      const customHidden = form.querySelector('.paypal-custom-metadata');
      const baseTitle = bizInput?.getAttribute('data-base-title');

      const sync = () => {
        const bizVal = bizInput.value.trim();
        const emailVal = emailInput.value.trim();
        itemHidden.value = bizVal ? `Hanei JP: ${baseTitle} (50% Deposit) (${bizVal})` : `Hanei JP: ${baseTitle} (50% Deposit)`;
        customHidden.value = JSON.stringify({ email: emailVal, business: bizVal });
      };

      if(bizInput) bizInput.addEventListener('input', sync);
      if(emailInput) emailInput.addEventListener('input', sync);
    });
  }
  document.addEventListener('astro:page-load', initTieredCheckout);
  initTieredCheckout();
</script>
