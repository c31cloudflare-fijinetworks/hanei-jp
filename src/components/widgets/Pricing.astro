---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Price } from '~/types';

const { title, subtitle, tagline, prices = [], classes = {}, ...rest } = Astro.props;

const SITE_URL = "https://hanei.jp";
const currentPath = Astro.url.pathname;
const cancelUrl = `${SITE_URL}${currentPath}`;
const successUrl = `${SITE_URL}/thank-you`;
---

<WidgetWrapper {...rest} id="pricing" classes={{ container: 'max-w-7xl scroll-mt-16', ...classes.container }} hasBackground>
  <Headline {title} {subtitle} {tagline} classes={{ headline: 'max-w-3xl' }} />
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {prices.map((price, index) => (
      <div class="relative overflow-visible flex flex-col rounded-lg border-2 border-primary p-6 text-center shadow-xl bg-white dark:bg-slate-900">
        
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-accent text-white px-3 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-widest text-white whitespace-nowrap">
            One-Time Investment
        </div>

        <h3 class="text-xl font-bold mt-2 text-slate-900 dark:text-white leading-tight h-12 flex items-center justify-center">{price.title}</h3>
        
        <div class="mt-4 flex-1">
          <div class="flex items-end justify-center">
            <span class="text-4xl font-bold tracking-tight text-primary">
                {typeof price.price === 'number' ? '¥' + price.price.toLocaleString() : price.price}
            </span>
          </div>
          <ul role="list" class="mt-6 space-y-2 text-left text-sm">
            {price.items.map((item) => (
              <li class="flex items-start">
                <Icon name="tabler:circle-check" class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" />
                <p class="ml-2 text-muted dark:text-slate-300">{item.description}</p>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="mt-6 p-4 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <form class="checkout-form" action="https://www.paypal.com/cgi-bin/webscr" method="get" target="_blank">
            <input type="hidden" name="cmd" value="_xclick" />
            <input type="hidden" name="business" value="ZFG89TK2KESFG" />
            <input type="hidden" name="solution_type" value="Sole" />
            <input type="hidden" name="landing_page" value="billing" />
            <input type="hidden" name="return" value={successUrl} />
            <input type="hidden" name="cancel_return" value={cancelUrl} />
            
            <input type="hidden" class="paypal-item-name" name="item_name" value={`Hanei JP: ${price.title}`} />
            <input type="hidden" name="amount" value={price.price?.toString().replace(/[^0-9.]/g, '')} />
            <input type="hidden" name="currency_code" value={price.price?.toString().includes('¥') ? "JPY" : "USD"} />
            
            <div class="text-left space-y-3">
              <div>
                <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">1. Shop Name</label>
                <input type="hidden" name="on0" value="Business Name" />
                <input type="text" name="os0" required class="business-name-input w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="Name" data-base-title={price.title} />
              </div>

              <div>
                <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">2. Current Website URL</label>
                <input type="hidden" name="on1" value="Current URL" />
                <input type="text" name="os1" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="https://..." />
              </div>

              <div>
                <label class="block text-[10px] font-bold mb-1 text-slate-500 uppercase tracking-widest">3. Your Email</label>
                <input type="email" required class="email-input w-full px-3 py-2 text-sm border border-slate-300 rounded bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none text-slate-900 dark:text-white" placeholder="Email" />
                <input type="hidden" class="paypal-custom-metadata" name="custom" value="" />
              </div>
            </div>

            <button type="submit" class="w-full mt-6 py-3 bg-primary hover:bg-blue-700 text-white font-bold rounded shadow-md hover:shadow-lg transition-all text-sm uppercase tracking-widest">
              {price.callToAction?.text || 'Order Now'}
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>

<script is:inline>
  function initTieredCheckout() {
    const forms = document.querySelectorAll('.checkout-form');
    
    forms.forEach(form => {
      const bizInput = form.querySelector('.business-name-input');
      const emailInput = form.querySelector('.email-input');
      const itemHidden = form.querySelector('.paypal-item-name');
      const customHidden = form.querySelector('.paypal-custom-metadata');
      const baseTitle = bizInput.getAttribute('data-base-title');

      const sync = () => {
        const bizVal = bizInput.value.trim();
        const emailVal = emailInput.value.trim();
        itemHidden.value = bizVal ? `Hanei JP: ${baseTitle} (${bizVal})` : `Hanei JP: ${baseTitle}`;
        customHidden.value = JSON.stringify({ email: emailVal, business: bizVal });
      };

      bizInput.addEventListener('input', sync);
      emailInput.addEventListener('input', sync);
    });
  }
  document.addEventListener('astro:page-load', initTieredCheckout);
  initTieredCheckout();
</script>
