---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Price } from '~/types';

const { title, subtitle, tagline, prices = [], hasUrlField = false, classes = {}, ...rest } = Astro.props;

const SITE_URL = "https://hanei.jp";
const currentPath = Astro.url.pathname;
const cancelUrl = `${SITE_URL}${currentPath}`;
const successUrl = `${SITE_URL}/thank-you`;

const isSingle = prices.length === 1;
const cardWidthClass = isSingle 
  ? "w-full max-w-xl" 
  : "w-full md:w-[calc(50%-1.5rem)] xl:w-[calc(33%-1.5rem)] min-w-[320px]";
---

<WidgetWrapper {...rest} id="pricing" classes={{ container: 'max-w-7xl scroll-mt-16', ...classes.container }} hasBackground>
  <Headline {title} {subtitle} {tagline} classes={{ title: 'text-4xl md:text-5xl font-black tracking-tighter' }} />
  
  <div class="flex flex-wrap justify-center gap-8">
    {prices.map((price) => (
      <div class:list={[
        "relative overflow-visible flex flex-col rounded-xl border border-slate-200 p-8 text-center shadow-2xl bg-white dark:bg-slate-900 transition-all hover:scale-[1.02]",
        cardWidthClass
      ]}>
        
        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-slate-900 text-white px-4 py-1 rounded-full text-[9px] font-black uppercase tracking-[0.2em] shadow-xl">
            English Infrastructure
        </div>

        <h3 class="text-2xl font-black mt-4 text-slate-900 dark:text-white leading-tight font-heading uppercase tracking-tight">
          {price.title}
        </h3>
        
        <div class="mt-8 flex-1 flex flex-col border-y border-slate-50 py-8 my-2">
          <!-- PRICING CLARITY BLOCK -->
          <div class="flex flex-col items-center">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">Package Total: {price.total}</span>
            <div class="flex items-baseline gap-1">
                <span class="text-5xl font-black tracking-tighter text-primary">
                    {typeof price.price === 'number' ? '¥' + price.price.toLocaleString() : price.price}
                </span>
            </div>
            <span class="mt-2 text-xs font-black text-accent uppercase tracking-tighter italic">50% Deposit Due Now</span>
          </div>
          
          <ul role="list" class="mt-10 space-y-4 text-left text-sm flex-grow">
            {price.items.map((item) => (
              <li class="flex items-start group">
                <div class="mt-1 bg-green-50 rounded-full p-0.5">
                    <Icon name="tabler:check" class="w-3.5 h-3.5 text-green-600" />
                </div>
                <p class="ml-3 text-slate-600 dark:text-slate-300 font-semibold leading-snug">{item.description}</p>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- REFINED INPUT SECTION -->
        <div class="mt-6">
          <form class="checkout-form" action="https://www.paypal.com/cgi-bin/webscr" method="get" target="_blank">
            <input type="hidden" name="cmd" value="_xclick" />
            <input type="hidden" name="business" value="ZFG89TK2KESFG" />
            
            <input type="hidden" name="brand_name" value="Hanei JP" />
            <input type="hidden" name="cbt" value="Return to Hanei JP" />
            <input type="hidden" name="image_url" value="https://hanei.jp/images/logo.webp" />
            <input type="hidden" name="no_shipping" value="1" />
            <input type="hidden" name="no_note" value="1" />
            <input type="hidden" name="tax" value="0" />
            <input type="hidden" name="shipping" value="0" />
            
            <input type="hidden" class="paypal-item-name" name="item_name" value={`Hanei JP: ${price.title} (50% Deposit)`} />
            <input type="hidden" name="amount" value={price.price?.toString().replace(/[^0-9.]/g, '')} />
            <input type="hidden" name="currency_code" value="JPY" />
            
            <div class="text-left space-y-4">
              <div>
                <label class="block text-[9px] font-black mb-1.5 text-slate-400 uppercase tracking-widest">1. Business / Shop Name</label>
                <input type="text" name="os0" required class="business-name-input w-full px-4 py-3 text-sm border-2 border-slate-100 rounded-lg bg-slate-50 focus:bg-white focus:border-primary focus:ring-0 outline-none transition-all text-slate-900 font-bold placeholder:text-slate-300" placeholder="e.g. Ginza Salon" data-base-title={price.title} />
                <input type="hidden" name="on0" value="Business Name" />
              </div>

              {hasUrlField ? (
                <div>
                  <label class="block text-[9px] font-black mb-1.5 text-slate-400 uppercase tracking-widest">2. Current Website (Optional)</label>
                  <input type="text" name="os1" class="w-full px-4 py-3 text-sm border-2 border-slate-100 rounded-lg bg-slate-50 focus:bg-white focus:border-primary focus:ring-0 outline-none transition-all text-slate-900 font-bold placeholder:text-slate-300" placeholder="https://..." />
                  <input type="hidden" name="on1" value="Current URL" />
                </div>
              ) : (
                <div>
                  <label class="block text-[9px] font-black mb-1.5 text-slate-400 uppercase tracking-widest">2. Representative Name</label>
                  <input type="text" name="os1" required class="w-full px-4 py-3 text-sm border-2 border-slate-100 rounded-lg bg-slate-50 focus:bg-white focus:border-primary focus:ring-0 outline-none transition-all text-slate-900 font-bold placeholder:text-slate-300" placeholder="Your Full Name" />
                  <input type="hidden" name="on1" value="Representative" />
                </div>
              )}

              <div>
                <label class="block text-[9px] font-black mb-1.5 text-slate-400 uppercase tracking-widest">3. Delivery Email</label>
                <input type="email" required class="email-input w-full px-4 py-3 text-sm border-2 border-slate-100 rounded-lg bg-slate-50 focus:bg-white focus:border-primary focus:ring-0 outline-none transition-all text-slate-900 font-bold placeholder:text-slate-300" placeholder="name@company.com" />
                <input type="hidden" class="paypal-custom-metadata" name="custom" value="" />
              </div>
            </div>

            <button type="submit" class="w-full mt-8 py-4 bg-primary hover:bg-blue-700 text-white font-black rounded-lg shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 transition-all text-[11px] uppercase tracking-[0.2em]">
              Pay Deposit & Start Production
            </button>
          </form>
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>

<script is:inline>
  function initTieredCheckout() {
    const forms = document.querySelectorAll('.checkout-form');
    forms.forEach(form => {
      const bizInput = form.querySelector('.business-name-input');
      const emailInput = form.querySelector('.email-input');
      const itemHidden = form.querySelector('.paypal-item-name');
      const customHidden = form.querySelector('.paypal-custom-metadata');
      const baseTitle = bizInput?.getAttribute('data-base-title');

      const sync = () => {
        const bizVal = bizInput.value.trim();
        const emailVal = emailInput.value.trim();
        itemHidden.value = bizVal ? `Hanei JP: ${baseTitle} (50% Deposit) (${bizVal})` : `Hanei JP: ${baseTitle} (50% Deposit)`;
        customHidden.value = JSON.stringify({ email: emailVal, business: bizVal });
      };

      if(bizInput) bizInput.addEventListener('input', sync);
      if(emailInput) emailInput.addEventListener('input', sync);
    });
  }
  document.addEventListener('astro:page-load', initTieredCheckout);
  initTieredCheckout();
</script>
