---
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  items = [],
  image = await Astro.slots.render('image'),
  isReversed = false,
  isAfterContent = false,
} = Astro.props;
---

<section class:list={[{ 'py-12 md:py-20': !isAfterContent, 'pb-12 md:pb-20': isAfterContent }]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class:list={['md:flex md:gap-16 items-center', { 'md:flex-row-reverse': isReversed }]}>
      <div class="md:basis-1/2 mb-10 md:mb-0">
        {image && (
          <div class="relative m-auto max-w-5xl aspect-[3/2] overflow-hidden rounded-lg shadow-2xl border-4 border-white dark:border-slate-800">
            {typeof image === 'string' ? (
              <img src={image} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            ) : image.src ? (
              <img src={image.src} alt={image.alt || ''} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            ) : (
              <div class="w-full h-full [&>img]:w-full [&>img]:h-full [&>img]:object-cover">
                <Fragment set:html={image} />
              </div>
            )}
          </div>
        )}
      </div>
      <div class="md:basis-1/2">
        {tagline && <p class="text-base text-secondary dark:text-gray-400 font-bold tracking-widest uppercase mb-3">{tagline}</p>}
        {title && <h2 class="text-3xl md:text-4xl font-bold leading-tight tracking-tighter mb-6 font-heading">{title}</h2>}
        {subtitle && <p class="text-xl text-muted mb-8 leading-relaxed" set:html={subtitle} />}
        {content && <div class="text-lg text-muted mb-8 leading-relaxed" set:html={content} />}
        {items && (
          <ul class="space-y-10">
            {items.map(({ title: itemTitle, description, icon }) => (
              <li class="flex max-w-md">
                <div class="flex-shrink-0">
                  <div class="flex items-center justify-center h-12 w-12 rounded-full bg-primary text-gray-50 shadow-lg">
                    {icon && <Icon name={icon} class="w-6 h-6" />}
                  </div>
                </div>
                <div class="ml-4">
                  {itemTitle && <h3 class="text-xl leading-6 font-bold mb-2">{itemTitle}</h3>}
                  {description && <p class="text-lg text-muted leading-relaxed" set:html={description} />}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>
