---
const { 
  labels = {}, 
  options = {}, 
  formAction = "https://docs.google.com/forms/d/e/1FAIpQLSetNa1Mq_nYvkKp5h2fUIPZFRCvfFs5hvcYoawFk1eX0p6t3w/formResponse",
  ids = {
    name: "entry.1770250121",
    company: "entry.1744957567",
    email: "emailAddress",
    category: "entry.491532461",
    budget: "entry.1285777990",
    timeline: "entry.1375463449",
    summary: "entry.1193708562"
  }
} = Astro.props;
---
<section class="py-12 md:py-20 bg-white dark:bg-slate-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div id="form-container" class="bg-slate-50 dark:bg-slate-800 rounded-2xl p-8 md:p-12 shadow-xl border border-slate-200 dark:border-slate-700">
      
      <!-- SUCCESS STATE (HIDDEN BY DEFAULT) -->
      <div id="success-msg" class="hidden text-center py-20">
        <div class="bg-blue-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8 shadow-2xl">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h2 class="text-4xl font-black text-slate-950 uppercase tracking-tighter mb-4">Message Dispatched</h2>
        <p class="text-xl text-slate-600 font-medium">The studio has received your inquiry. <br/> We guarantee a reply within 24 hours.</p>
      </div>

      <!-- FORM STATE -->
      <div id="form-content">
        <h2 class="text-2xl md:text-3xl font-bold mb-4 text-center uppercase tracking-widest text-slate-900 dark:text-white">{labels.title}</h2>
        {labels.description && <p class="text-center text-lg text-slate-600 dark:text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed">{labels.description}</p>}

        <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;"></iframe>
        
        <form action={formAction} method="POST" target="hidden_iframe" id="bespoke-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.client_name} *</label>
            <input type="text" name={ids.name} required class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all" />
          </div>
          <div class="flex flex-col">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.company_name}</label>
            <input type="text" name={ids.company} class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all" />
          </div>
          <div class="flex flex-col">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.email} *</label>
            <input type="email" name="emailAddress" required class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all" />
          </div>
          <div class="flex flex-col">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.request_type} *</label>
            <select name={ids.category} required class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all">
              {options.requests.map(opt => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div class="flex flex-col">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.budget_range || 'ESTIMATED BUDGET'}</label>
            <select name={ids.budget} class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all">
              {options.budgets.map(opt => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div class="flex flex-col">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.deadline || 'DESIRED TIMELINE'}</label>
            <select name={ids.timeline} class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all">
              {options.timelines.map(opt => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div class="flex flex-col md:col-span-2">
            <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.project_summary} *</label>
            <textarea name={ids.summary} required rows="5" class="w-full px-4 py-3 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-primary outline-none transition-all"></textarea>
          </div>
          <div class="md:col-span-2 pt-6">
            <button type="submit" id="submit-btn" class="w-full py-5 bg-primary hover:bg-slate-900 text-white font-bold rounded-xl shadow-lg transform hover:-translate-y-1 transition-all text-lg uppercase tracking-widest">
              {labels.submit}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('bespoke-form');
  const content = document.getElementById('form-content');
  const success = document.getElementById('success-msg');
  const btn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', () => {
      btn.innerHTML = "SENDING...";
      btn.style.opacity = "0.5";
      btn.style.pointerEvents = "none";
      
      // Wait for iframe to handle the post, then show success
      setTimeout(() => {
        content.classList.add('hidden');
        success.classList.remove('hidden');
        window.scrollTo({ top: document.getElementById('form-container').offsetTop - 100, behavior: 'smooth' });
      }, 1500);
    });
  }
</script>
