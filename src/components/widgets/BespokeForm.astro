---
const { 
  labels = {
    title: "Get in Touch",
    client_name: "Name",
    company_name: "Company Name",
    email: "Email Address",
    phone: "Phone Number",
    request_type: "Request Category",
    project_summary: "Tell us about your inquiry or project",
    budget_range: "Estimated Budget",
    deadline: "Desired Timeline",
    referral: "How did you find us?",
    submit: "Send Message"
  },
  options = {
    requests: ["General Inquiry", "Custom System", "API / Integration", "Legacy Migration", "Other"],
    budgets: ["Not Applicable", "¥1,000,000 - ¥3,000,000", "¥3,000,000 - ¥5,000,000", "¥5,000,000+"],
    timelines: ["Today / ASAP", "By Tomorrow", "This Week", "Within 1 week", "Other"],
    referrals: ["Google Search", "Social Media", "Friend / Colleague", "Other"]
  }
} = Astro.props;

const FORM_ACTION = "https://docs.google.com/forms/d/e/1FAIpQLSdOFvirP0L_M66yEYve08KUkZAj3c-Oz-wUX2xyNiDSH3lueA/formResponse";
---

<section class="py-12 md:py-20 bg-white dark:bg-slate-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="bg-slate-50 dark:bg-slate-800 rounded-2xl p-8 md:p-12 shadow-xl border border-slate-200 dark:border-slate-700">
      <h2 class="text-2xl font-bold mb-8 text-center uppercase tracking-widest">{labels.title}</h2>
      <form action={FORM_ACTION} method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <input type="hidden" name="bot-field" class="hidden" />

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.client_name} *</label>
          <input type="text" name="client_name" required class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none" />
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.company_name}</label>
          <input type="text" name="company_name" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none" />
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.email} *</label>
          <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none" />
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.phone}</label>
          <input type="tel" name="phone" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none" />
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.request_type} *</label>
          <select name="request_type" required class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none">
            {options.requests.map(opt => <option value={opt}>{opt}</option>)}
          </select>
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.budget_range}</label>
          <select name="budget_range" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none">
            {options.budgets.map(opt => <option value={opt}>{opt}</option>)}
          </select>
        </div>

        <div class="flex flex-col md:col-span-2">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.project_summary} *</label>
          <textarea name="project_summary" required rows="5" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none"></textarea>
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.deadline}</label>
          <select name="deadline" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none">
            {options.timelines.map(opt => <option value={opt}>{opt}</option>)}
          </select>
        </div>

        <div class="flex flex-col">
          <label class="block text-xs font-bold mb-2 uppercase tracking-wide text-slate-500">{labels.referral}</label>
          <select name="referral" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-primary outline-none">
            {options.referrals.map(opt => <option value={opt}>{opt}</option>)}
          </select>
        </div>

        <div class="md:col-span-2 pt-6">
          <button type="submit" class="w-full py-4 bg-primary hover:bg-secondary text-white font-bold rounded-xl shadow-lg transform hover:-translate-y-1 transition-all text-lg uppercase tracking-widest">
            {labels.submit}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
