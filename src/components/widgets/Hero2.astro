---
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

const {
  tagline,
  title,
  subtitle,
  actions = [],
  image = {},
  video = null,
  poster = null,
  testimonial = null,
} = Astro.props;
---

<section class="relative not-prose bg-white dark:bg-slate-900">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-8 md:pt-16 pb-12 md:pb-24">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="w-full text-center md:text-left flex flex-col justify-center">
          {tagline && <p class="font-bold dark:text-gray-400 text-base text-secondary tracking-widest uppercase mb-4">{tagline}</p>}
          {title && <h1 class="font-bold font-heading leading-tight tracking-tighter mb-6 md:text-6xl text-4xl" set:html={title}></h1>}
          <div class="max-w-3xl mx-auto md:mx-0">
            <div class="max-w-xl">
              {subtitle && <p class="text-muted text-xl mb-10 leading-relaxed" set:html={subtitle} />}
            </div>
            {actions && actions.length > 0 && (
              <div class="flex flex-col gap-4 max-w-xs md:justify-start md:mx-0 mx-auto sm:flex-row sm:justify-center sm:max-w-md">
                {actions.map((action) => (
                  <Button {...action} class="shadow-xl hover:scale-105 transition-transform" />
                ))}
              </div>
            )}
          </div>
        </div>
        <div class="relative w-full">
          {video ? (
            <div class="relative rounded-lg overflow-hidden shadow-2xl w-full aspect-[3/2] border-4 border-white dark:border-slate-800 group cursor-pointer" id="video-container">
              <video id="hero-video" src={video} class="w-full h-full object-cover block" controls playsinline preload="metadata" poster={poster || image?.src}></video>
              <div id="play-overlay" class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/30 transition-all duration-300">
                <div class="w-20 h-20 md:w-24 md:h-24 bg-primary rounded-full flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-transform">
                  <Icon name="tabler:player-play-filled" class="w-10 h-10 md:w-12 md:h-12 text-white ml-1" />
                </div>
              </div>
            </div>
          ) : (
            image && <img src={image.src} alt={image.alt} class="w-full aspect-[3/2] object-cover rounded-lg shadow-2xl border-4 border-white dark:border-slate-800" />
          )}
        </div>
      </div>
    </div>
  </div>
</section>
